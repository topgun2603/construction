# Production environment for the API, the worker and the web app.
#
# Copy to `.env.prod` (gitignored) and fill in. `infra/docker-compose.prod.yml` feeds this file to
# all three containers, so it holds every variable any of them needs.
#
# Nothing here belongs in the repository and nothing here belongs in an image. The Firebase key in
# particular is a private key for the whole Firebase project â€” see FIREBASE_SERVICE_ACCOUNT below.

NODE_ENV=production

# --- database ----------------------------------------------------------------
# Connect as `sitebook_app`: NOSUPERUSER, NOBYPASSRLS. This is not a preference. Tenant tables are
# created with FORCE ROW LEVEL SECURITY, and a superuser bypasses RLS unconditionally â€” an app
# connecting as one has every tenancy policy silently inert, which leaks one builder's sites to
# another with no error anywhere. Run infra/postgres/init/01-app-role.sql against a new database
# before the first migration.
#
# `?sslmode=require` on any managed provider; `connection_limit` sized to the instance.
DATABASE_URL=postgresql://sitebook_app:CHANGE_ME@db.example.com:5432/sitebook?sslmode=require&connection_limit=10

# The platform console only, as a BYPASSRLS role (infra/sql/superadmin-role.sql). Leave both this
# and PLATFORM_ADMIN_PHONES empty on any deployment that is not the one you operate yourself â€” the
# console can change plans and suspend accounts.
ADMIN_DATABASE_URL=
PLATFORM_ADMIN_PHONES=

# --- redis -------------------------------------------------------------------
REDIS_URL=rediss://default:CHANGE_ME@redis.example.com:6379
JOBS_ENABLED=true

# --- object storage ----------------------------------------------------------
# Any S3-compatible endpoint. Leave S3_ENDPOINT empty for AWS S3 itself; set it for R2, Tigris,
# Backblaze or MinIO. Path style is required by most non-AWS providers.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=sitebook-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- tokens ------------------------------------------------------------------
# At least 32 characters each, and different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing either signs out every session on the next request, which is the point of being able to.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_A_DIFFERENT_32_CHARACTER_STRING
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- firebase (phone OTP + push) ---------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project

# The Admin SDK credential. Two ways, and the file is the better one: a private key is multi-line,
# and a multi-line value survives a mounted file far better than a shell variable.
#
# Whichever you use, the credential reaches the container at run time â€” as a secret in your host's
# secret store, or as a mounted file. It must never be copied into an image: layers are kept even
# when a later step deletes the file, so an image that ever contained it carries it to every
# registry it is pushed to. That is why .dockerignore excludes *service-account*.json.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json

# Refused outright when NODE_ENV=production â€” the env schema will not start the process with it on.
# Listed here only so nobody adds it back by hand wondering why sign-in needs a real SMS.
DEV_AUTH_BYPASS=false

# --- web app -----------------------------------------------------------------
# Where the browser reaches the API. Public, so it must be the external URL, not a container name.
NEXT_PUBLIC_API_URL=https://api.example.com/v1
# Where the web container reaches the API from inside the network. Can be the service name.
API_URL=http://api:3000/v1
# Every origin the browser may call the API from, comma separated. No trailing slash.
CORS_ORIGINS=https://app.example.com

# --- integrations (all optional; a missing one turns its feature off) ---------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Razorpay is all-or-nothing: with a key but no webhook secret, checkout creates subscriptions no
# webhook can confirm, and tenants are charged while staying on the old plan. The env schema
# refuses that combination rather than letting it happen quietly.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PRO=
BILLING_GRACE_DAYS=7

# The geocoder is a free public service and its usage policy asks who is calling. Without this the
# traffic is anonymous and they are entitled to block it â€” which takes the map search down.
GEOCODER_CONTACT=ops@example.com

# --- maps ---------------------------------------------------------------------
# Tiles and geocoding. OpenStreetMap's own servers are volunteer-run and their usage policy is
# enforced by blocking - they blocked this app in development, and in production that would be
# every customer's site map at once.
#
# The web key is public by design and is inlined into the browser bundle at build time, so it is a
# build argument in fly.web.toml rather than a runtime secret. Restrict it by domain in the
# MapTiler console. The API key below is server-side and used for geocoding only.
MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
