NODE_ENV=development
PORT=3000

# Postgres.
#
# Connect as `sitebook_app`, NOT as the `sitebook` superuser. A superuser bypasses
# row-level security unconditionally, so using it would silently disable every
# tenant isolation policy. infra/postgres/init/01-app-role.sql creates this role.
#
# Cross-tenant work uses a third role; see infra/sql/superadmin-role.sql.
DATABASE_URL=postgresql://sitebook_app:sitebook@localhost:5432/sitebook?schema=public
# Used by `pnpm db:drift` as a throwaway shadow database.
SHADOW_DATABASE_URL=postgresql://sitebook_app:sitebook@localhost:5432/sitebook_shadow?schema=public

REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally).
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=sitebook-media
S3_ACCESS_KEY_ID=sitebook
S3_SECRET_ACCESS_KEY=sitebook123
S3_FORCE_PATH_STYLE=true

# App JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# Firebase phone auth (spec Â§6.2).
#
# FIREBASE_PROJECT_ID must match the web client's `projectId`.
# The Admin SDK credential is a real secret and is NOT the web apiKey. Get it from
# Firebase console â†’ Project settings â†’ Service accounts â†’ Generate new private key.
#
# Prefer the file form: the key is a multi-line PEM and survives a file far better
# than a shell variable. Keep the file OUTSIDE the repo (or rely on .gitignore) and
# chmod it 600 on a server.
FIREBASE_PROJECT_ID=construction-40308
FIREBASE_SERVICE_ACCOUNT_FILE=../../construction-service-account.json
# Alternative: the same JSON inline on one line.
FIREBASE_SERVICE_ACCOUNT=

# Leave the service account empty and set DEV_AUTH_BYPASS=true to sign in locally
# without sending an SMS: POST /v1/auth/exchange { "firebase_token": "dev:919876543210" }
DEV_AUTH_BYPASS=true

# Background jobs (spec Â§10). The API enqueues; `pnpm worker` consumes.
# Set JOBS_ENABLED=false to run with no broker at all â€” every enqueue no-ops.
JOBS_ENABLED=true
# Cron patterns are read in Asia/Kolkata, so "19:00" means the builder's evening.
WHATSAPP_SUMMARY_CRON=0 19 * * *
WHATSAPP_DPR_REMINDER_CRON=30 17 * * *
REPORTS_ROLLUP_CRON=0 1 * * *
WAGE_PERIOD_DRAFT_CRON=0 2 * * *

# WhatsApp Cloud API. With no token the client logs what it would have sent and
# reports success, so the summary job is inspectable without Meta credentials.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# --- platform console (super admin) ---------------------------------------
# Optional. Leave both unset and /v1/admin/* refuses every request, which is the right
# default for any deployment that is not the one the platform team operates.
#
# ADMIN_DATABASE_URL must point at a role with BYPASSRLS â€” see
# infra/postgres/init/02-admin-role.sql. Never reuse DATABASE_URL here: the app role
# cannot read across tenants, so the console would show an empty platform.
ADMIN_DATABASE_URL=
# Comma-separated phones in stored form (91XXXXXXXXXX).
PLATFORM_ADMIN_PHONES=
# Console session length. No refresh flow â€” re-authenticating means another SMS.
PLATFORM_TOKEN_TTL_SECONDS=28800

# --- billing (Razorpay) ---------------------------------------------------
# Optional. With none of this set, billing runs in dry-run: checkout returns a fake subscription
# and the webhook still verifies signatures, so the flow is testable without a Razorpay account.
#
# RAZORPAY_WEBHOOK_SECRET is NOT the API secret. Razorpay signs webhooks with a secret you choose
# when adding the endpoint in their dashboard; using the API secret means every webhook is rejected
# as forged, which looks exactly like an attack.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create a monthly plan in Razorpay for each of ours, then paste the plan ids here.
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PRO=
# Days of access after a failed charge, beyond the period already paid for.
BILLING_GRACE_DAYS=7

# Geocoding. Without it the search falls back to Nominatim, OpenStreetMap's volunteer service -
# fine for a checkout, not fine for a deployment, for the same reason as the tiles.
MAPTILER_KEY=