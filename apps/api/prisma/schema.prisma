  // Bill of quantities
  boqs            Boq[]
  boqItems        BoqItem[]
  boqMeasurements BoqMeasurement[]
  boqBills        BoqBill[]
  boqBillLines    BoqBillLine[]

  // Company groups — not tenant data; see CompanyGroup
  companyGroupMember      CompanyGroupMember?
  companyGroupInvitations CompanyGroupInvitation[]

  // RFIs and submittals
  rfiSettings        RfiSettings?
  rfis               Rfi[]
  rfiDocuments       RfiDocument[]
  rfiResponses       RfiResponse[]
  rfiAttachments     RfiAttachment[]
  submittals         Submittal[]
  submittalRevisions SubmittalRevision[]
  submittalFiles     SubmittalFile[]

  // Equipment and plant
  equipment             Equipment[]
  equipmentAllocations  EquipmentAllocation[]
  equipmentLogs         EquipmentLog[]
  equipmentFuel         EquipmentFuel[]
  equipmentServicePlans EquipmentServicePlan[]
  equipmentMaintenance  EquipmentMaintenance[]
  equipmentDocuments    EquipmentDocument[]
  equipmentHireBookings EquipmentHireBooking[]

  // Single sign-on and provisioning
  ssoConnection      SsoConnection?
  ssoDomains         SsoDomain[]
  ssoDomainDirectory SsoDomainDirectory[]
  ssoLoginRequests   SsoLoginRequest[]
  scimTokens         ScimToken[]
  scimTokenDirectory ScimTokenDirectory[]
  scimUsers          ScimUser[]
  scimGroups         ScimGroup[]
  scimGroupMembers   ScimGroupMember[]
  scimRoleMappings   ScimRoleMapping[]

  // Two-factor, session timeouts and IP allow-lists
  securitySettings TenantSecuritySettings?
