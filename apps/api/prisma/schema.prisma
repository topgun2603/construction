  @@unique([projectId, reportDate], map: "daily_reports_project_id_report_date_key")
  @@unique([tenantId, clientId], map: "daily_reports_tenant_id_client_id_key")
  @@index([tenantId, reportDate])
  @@index([tenantId, updatedAt])
  @@map("daily_reports")
}

model DprActivity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
