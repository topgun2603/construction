  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  unit      String
  category  String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  indentItems    IndentItem[]
  estimates      MaterialEstimate[]
  stockMovements StockMovement[]
  rfqItems       PurchaseRfqItem[]
  orderLines     PurchaseOrderLine[]

  @@unique([tenantId, name], map: "materials_tenant_id_name_key")
  @@index([tenantId, updatedAt])
  @@map("materials")
}

model MaterialIndent {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  requestedBy String       @map("requested_by") @db.Uuid
  status      IndentStatus @default(requested)
  urgency     Urgency      @default(normal)
  notes       String?
  requiredBy  DateTime?    @map("required_by") @db.Date
  approvedBy  String?      @map("approved_by") @db.Uuid
  approvedAt  DateTime?    @map("approved_at") @db.Timestamptz(6)
  clientId    String?      @map("client_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User    @relation("indent_requested_by", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver  User?   @relation("indent_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)

  items          IndentItem[]
  stockMovements StockMovement[]
  rfqs           PurchaseRfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, clientId], map: "material_indents_tenant_id_client_id_key")
  @@index([tenantId, status])
  @@index([projectId, createdAt])
  @@index([tenantId, updatedAt])
  @@map("material_indents")
}

model IndentItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  indentId         String  @map("indent_id") @db.Uuid
  materialId       String  @map("material_id") @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indent   MaterialIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([indentId, materialId], map: "indent_items_indent_id_material_id_key")
  @@map("indent_items")
}

enum StockMovementType {
  in
  out

  @@map("stock_movement_type")
}

/// What a site is expected to consume of a material (spec Â§7, Phase 2).
///
/// One row per project and material, which is what makes the overrun report possible: without
/// an expected figure, "you have used 180 bags" is a number nobody can act on.
model MaterialEstimate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  materialId        String   @map("material_id") @db.Uuid
  estimatedQuantity Decimal  @map("estimated_quantity") @db.Decimal(14, 3)
  note              String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([projectId, materialId], map: "material_estimates_project_id_material_id_key")
  @@index([tenantId, projectId])
  @@map("material_estimates")
}

/// Every movement of material on or off a site (spec Â§7, Phase 2).
///
/// An append-only ledger rather than a running `stock_on_hand` column. Stock is the sum of its
/// movements, so "why do we have 12 bags" is always answerable â€” a single balance column would
/// give the number and lose the reason, and the first disagreement with the site would have
/// nothing to check against.
model StockMovement {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  projectId  String            @map("project_id") @db.Uuid
  materialId String            @map("material_id") @db.Uuid
  type       StockMovementType
  quantity   Decimal           @db.Decimal(14, 3)
  /// The day the material moved, which is not the day it was typed in.
  movedOn    DateTime          @map("moved_on") @db.Date
  /// Set when this row came from receiving an indent, so a GRN can be traced back.
  indentId   String?           @map("indent_id") @db.Uuid
  /// Challan or bill number for an inward movement; free text because every supplier differs.
  ref        String?
  note       String?
  recordedBy String            @map("recorded_by") @db.Uuid
  clientId   String?           @map("client_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  indent   MaterialIndent? @relation(fields: [indentId], references: [id], onDelete: SetNull)
  recorder User            @relation("stock_recorded_by", fields: [recordedBy], references: [id], onDelete: Restrict)

  subcontractDeductions SubcontractDeduction[]
  goodsReceiptLine      GoodsReceiptLine?

  @@unique([tenantId, clientId], map: "stock_movements_tenant_id_client_id_key")
  @@index([tenantId, projectId, materialId])
  @@index([projectId, movedOn])
  @@map("stock_movements")
}

/// Site expenses and petty cash (spec Â§3 item 9, Â§7).
///
/// `spentOn` is the day the money left, which is not the day it was entered â€” a
/// supervisor photographs a bill on Tuesday for a Saturday purchase, and the cost
/// belongs to Saturday. Reports group on `spentOn` for that reason.
model Expense {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  /// Paise. Never a float (ADR 0003).
  amount        BigInt
  category      String
  spentOn       DateTime      @map("spent_on") @db.Date
  billS3Key     String?       @map("bill_s3_key")
  /// VAT or GST included in `amount` (roadmap Phase 1, item 5): the input tax a company can
  /// reclaim. Zero when the bill showed none or nobody entered it.
  taxAmount     BigInt        @default(0) @map("tax_amount")
  /// The supplier's tax registration number, checked against the company's regime.
  supplierTaxId String?       @map("supplier_tax_id")
  /// The line of the site's work breakdown this spend is booked to (roadmap Phase 2, module 1).
  /// Null is "unallocated": the budget report shows it as its own line rather than losing it.
  costCodeId    String?       @map("cost_code_id") @db.Uuid
  note          String?
  status        ExpenseStatus @default(pending)
  submittedBy   String        @map("submitted_by") @db.Uuid
  approvedBy    String?       @map("approved_by") @db.Uuid
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(6)
  /// Device-generated id when recorded offline; the sync idempotency key.
  clientId      String?       @map("client_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitter User      @relation("expense_submitted_by", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver  User?     @relation("expense_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)
  costCode  CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  subcontractDeductions SubcontractDeduction[]
  purchaseInvoiceLines  PurchaseInvoiceLine[]

  @@unique([tenantId, clientId], map: "expenses_tenant_id_client_id_key")
  @@index([tenantId, status])
  @@index([tenantId, spentOn])
  @@index([projectId, spentOn])
  @@index([tenantId, updatedAt])
  @@index([costCodeId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notifications, sync, audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json      @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Append-only record of what each device pushed, including conflicts, so a
/// supervisor's "but I entered it" can be answered (spec Â§8).
model SyncLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  deviceId String   @map("device_id")
  entity   String
  entityId String?  @map("entity_id") @db.Uuid
  clientId String?  @map("client_id") @db.Uuid
  op       SyncOp
  status   String
  detail   Json?    @db.JsonB
  serverTs DateTime @default(now()) @map("server_ts") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, serverTs])
  @@index([tenantId, entity, serverTs])
  @@map("sync_log")
}

/// Phone â†’ (tenant, user) directory. Deliberately has NO row-level security and no
/// foreign keys: `/auth/exchange` has to resolve a phone to a tenant *before* any
/// tenant context exists, and that is the only lookup allowed to run untenanted.
/// Maintained by the `users_sync_auth_identity` trigger â€” never written from
/// application code.
model AuthIdentity {
  userId   String  @id @map("user_id") @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  phone    String
  /// Mirrors `users.email`. What a Google sign-in is looked up by, before any tenant is known.
  email    String?
  // The email index and its per-tenant unique are partial — `WHERE email IS NOT NULL`, so the
  // rows without one cost nothing and do not collide with each other. Prisma cannot express a
  // partial index, so both live in the migration SQL and are deliberately absent here.

  @@unique([phone, tenantId], map: "auth_identities_phone_tenant_id_key")
  @@index([phone])
  @@map("auth_identities")
}

/// Audit trail for approvals and money movements (spec Â§15).
enum BillingStatus {
  none
  trialing
  active
  past_due
  cancelled

  @@map("billing_status")
}

/// One tenant's subscription (spec Â§3 item 12).
///
/// The Razorpay subscription is the authority on what is being charged; this row is the local
/// projection of it, updated only from a signature-verified webhook or an explicit fetch. Nothing
/// a browser sends ever sets `status` or `plan` here.
model Subscription {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @unique @map("tenant_id") @db.Uuid
  plan                   String
  status                 BillingStatus @default(none)
  razorpaySubscriptionId String?       @unique @map("razorpay_subscription_id")
  razorpayPlanId         String?       @map("razorpay_plan_id")
  /// razorpay | stripe. Rupees go through Razorpay, every other currency through Stripe.
  provider               String        @default("razorpay")
  currency               String        @default("INR")
  stripeSessionId        String?       @unique @map("stripe_session_id")
  stripeSubscriptionId   String?       @unique @map("stripe_subscription_id")
  /// Paise per cycle, copied at subscribe time so a later price change cannot rewrite history.
  amount                 BigInt        @default(0)
  /// Access runs to here. A past-due tenant keeps working until it passes.
  currentPeriodEnd       DateTime?     @map("current_period_end") @db.Timestamptz(6)
  /// Set when cancellation was requested but the paid period has not run out yet.
  cancelAt               DateTime?     @map("cancel_at") @db.Timestamptz(6)
  cancelledAt            DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  /// Why the last charge failed, for the banner the owner sees.
  lastFailureReason      String?       @map("last_failure_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([status])
  @@map("subscriptions")
}

/// Which tenant a Razorpay subscription belongs to. One of the few tables with no RLS.
///
/// A webhook arrives with no tenant context â€” it is authenticated by signature, and the tenant has to
/// be worked out before any tenant-scoped query can run. `subscriptions` is RLS protected, so reading
/// it without that context returns nothing, which is correct and useless here.
///
/// So this directory holds the mapping and nothing else: a Razorpay id and a tenant id. Exactly the
/// reasoning behind `auth_identities`, which exists so `/auth/exchange` can find a tenant from a phone
/// number. Kept in step by a trigger so application code never writes it and cannot let it drift.
model BillingIdentity {
  razorpaySubscriptionId String   @id @map("razorpay_subscription_id")
  tenantId               String   @map("tenant_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("billing_identities")
}

/// A charge Razorpay raised, successful or not.
///
/// Kept locally so an owner can see what they have been billed without this app needing to call
/// Razorpay to render a page, and so the history survives a subscription being cancelled.
model Invoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  razorpayInvoiceId String?   @unique @map("razorpay_invoice_id")
  stripeInvoiceId   String?   @unique @map("stripe_invoice_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  amount            BigInt
  /// `paid`, `issued`, `failed` â€” Razorpay's own words, not translated.
  status            String
  /// Razorpay's hosted invoice, for the owner who needs it for their accountant.
  invoiceUrl        String?   @map("invoice_url")
  issuedAt          DateTime? @map("issued_at") @db.Timestamptz(6)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt(sort: Desc)])
  @@map("invoices")
}

/// Every webhook Razorpay has delivered, by its own event id.
///
/// Razorpay retries until it gets a 2xx, so the same event arrives more than once as a matter of
/// course. Without this table a retried `subscription.charged` would raise a second invoice and
/// extend the period twice. No tenant_id and no RLS: the webhook is verified by signature before any
/// tenant is known, so there is no tenant context in which to read it.
model WebhookEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Razorpay's `x-razorpay-event-id` header. Unique, which is what makes replay a no-op.
  eventId   String    @unique @map("event_id")
  eventType String    @map("event_type")
  payload   Json
  /// Null until handled, so a crash mid-processing leaves a row to retry rather than a silent gap.
  handledAt DateTime? @map("handled_at") @db.Timestamptz(6)
  error     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt(sort: Desc)])
  @@map("webhook_events")
}

/// Platform console actions, outside every tenant.
///
/// Its own table rather than rows in `audit_log`: that table is tenant-scoped and RLS
/// protected, and an owner reading their own audit trail should not see the platform
/// operator's notes about them. This one has no tenant_id and no policy, and is only
/// ever written through the BYPASSRLS connection.
model PlatformAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The operator's phone in stored form. Not a user id: platform admins are an env
  /// allowlist, not rows in `users`.
  actorPhone String   @map("actor_phone")
  action     String
  /// Which tenant was acted on, when the action was about one.
  tenantId   String?  @map("tenant_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("platform_audit_log")
}

/// An operator the console itself granted access to.
///
/// `PLATFORM_ADMIN_PHONES` stays the root of trust and is unaffected by this table: those
/// numbers are always allowed in, can never be revoked from inside the console, and are the
/// only ones permitted to grant access to anybody else. This table exists so that adding a
/// second support person is not a redeploy — not so that the console can rewrite who owns it.
///
/// No `tenant_id` and no RLS, like `platform_audit_log`: it is read before any tenant context
/// exists, by the BYPASSRLS connection the console uses for everything.
model PlatformOperator {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored form, `91XXXXXXXXXX`, matching how a verified phone arrives from Firebase.
  phone     String    @unique
  name      String?
  /// A Google address this operator may also sign in with.
  ///
  /// An alternative key to the same person, never a second identity: a sign-in by address is
  /// resolved to this row's `phone` before a token is issued, so the audit trail stays phone-keyed
  /// and a Google login and an SMS login by the same operator are indistinguishable in it.
  ///
  /// Nullable, because most operators never link one, and unique where present so one address can
  /// never open two operator accounts.
  email     String?   @unique
  /// The root operator who granted this. Kept as a phone, not a foreign key, because the
  /// grantor is usually an env entry with no row here at all.
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Revoked rather than deleted, so the trail of who had access when survives.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by")

  @@index([revokedAt])
  @@map("platform_operators")
}

/// Every create, update and delete on tenant data, plus the business events services name by hand.
///
/// Two writers, one table:
///   * `audit_row_change()` — a Postgres trigger attached to each tenant table with
///     `SELECT audit_attach('<table>')`. It writes `create` / `update` / `delete` rows with the
///     changed fields, and cannot be forgotten by a new service or bypassed by a raw query.
///   * Services, for events a row change cannot express: an approval decision, a reveal of an
///     encrypted document number (a read), a wage period being finalised. Those keep their dotted
///     action names (`expense.approved`), and were the whole of this table before.
///
/// Who did it, the request id, IP and user agent are filled in by a BEFORE INSERT trigger from the
/// transaction-local settings `TenantDb` sets beside `app.tenant_id` — so neither writer passes them.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// The user who acted. Deliberately not a foreign key: an audit row must keep naming its actor
  /// after that person is removed, and must never be rewritten by an ON DELETE SET NULL.
  actorId       String?  @map("actor_id") @db.Uuid
  /// user | system (a scheduled job or webhook) | platform (the support console).
  actorType     String   @default("system") @map("actor_type")
  action        String
  entity        String
  entityId      String?  @map("entity_id") @db.Uuid
  /// The row's name or title at the time, so a deleted worker still reads as "Ravi" in the log.
  entityLabel   String?  @map("entity_label")
  /// For an update, which columns changed; empty for create and delete.
  changedFields String[] @default([]) @map("changed_fields")
  before        Json?    @db.JsonB
  after         Json?    @db.JsonB
  requestId     String?  @map("request_id")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_logs")
}

/// Who a message in the site conversation is for.
enum MessageAudience {
  /// The client sees it. This is what the portal is for.
  everyone

  /// The team only. A supervisor's note about a client is a normal part of running a job, and a
  /// portal with nowhere to put it sends those conversations back to WhatsApp.
  team

  /// One named person, and nobody else â€” whichever side of the client/team line they are on. The
  /// row carries a `recipientId`, and the database enforces that it always does.
  direct

  @@map("message_audience")
}

/// One message in a site's conversation.
///
/// Soft deleted, like everything else that is a record of something somebody said. A client asking
/// a question and a builder answering it is evidence about the job, and "who agreed to the granite"
/// is exactly the question this exists to answer six months later.
model SiteMessage {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  authorId    String          @map("author_id") @db.Uuid
  /// Set only for `direct`, and always set for it â€” the database holds both halves of that.
  recipientId String?         @map("recipient_id") @db.Uuid
  body        String
  audience    MessageAudience @default(everyone)
  /// Idempotency for a phone that sent and lost the answer.
  clientId    String?         @map("client_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                    @relation("message_author", fields: [authorId], references: [id], onDelete: Restrict)
  recipient   User?                   @relation("message_recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  attachments SiteMessageAttachment[]

  @@unique([tenantId, clientId], map: "site_messages_tenant_id_client_id_key")
  @@index([projectId, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("site_messages")
}

/// A photo or file hanging off a message. Half of what a client asks is "is this right?" about
/// something they can point at.
model SiteMessageAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  s3Key       String   @map("s3_key")
  thumbS3Key  String?  @map("thumb_s3_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  /// What the file was called. Null for a photograph, where the picture is the name.
  filename    String?
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message SiteMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("site_message_attachments")
}

/// How far one person has read one site's conversation.
///
/// A watermark rather than a row per message: "seen" is a question about a point in time, and
/// storing it that way means the table is the size of the team rather than the size of the thread.
model SiteMessageRead {
  tenantId   String   @map("tenant_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @default(now()) @map("last_read_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([tenantId, userId])
  @@map("site_message_reads")
}

enum DocumentCategory {
  drawing
  contract
  approval
  permit
  invoice
  other

  @@map("document_category")
}

/// A drawing, contract or approval, with its revisions.
///
/// Revisions share a `familyId` and count up. The point is the client: somebody looking at revision
/// 3 of a slab drawing must not be able to reach revision 1 by accident, and the builder must be
/// able to prove which one was current when the slab was poured.
///
/// `visibleToClient` defaults to false everywhere â€” schema, API and UI. A contract or an internal
/// costing becoming visible because somebody forgot to untick a box is not a mistake you can take
/// back.
model Document {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  /// Null for something that belongs to the company rather than one job.
  projectId       String?          @map("project_id") @db.Uuid
  /// Groups every revision of the same document.
  familyId        String           @map("family_id") @db.Uuid
  version         Int              @default(1)
  title           String
  category        DocumentCategory @default(other)
  s3Key           String           @map("s3_key")
  contentType     String           @map("content_type")
  sizeBytes       Int              @map("size_bytes")
  visibleToClient Boolean          @default(false) @map("visible_to_client")
  uploadedBy      String           @map("uploaded_by") @db.Uuid
  clientId        String?          @map("client_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  /// When its text was last read out for searching. Null means nobody has tried yet.
  textExtractedAt DateTime?        @map("text_extracted_at") @db.Timestamptz(6)
  /// Pages that yielded readable text. Zero after a successful read means a scan, not a failure.
  textPages       Int?             @map("text_pages")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User            @relation("document_uploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  Approval Approval[]
  chunks   DocumentChunk[]

  subcontractLinks SubcontractDocument[]

  @@unique([tenantId, clientId], map: "documents_tenant_id_client_id_key")
  @@unique([familyId, version], map: "documents_family_id_version_key")
  @@index([tenantId, projectId, createdAt(sort: Desc)])
  @@map("documents")
}

/// One readable piece of one document, so a question can be answered with a page number.
///
/// The full-text index over `content` is a GIN expression index created in the migration — Prisma's
/// datamodel cannot express one, and leaving it out here keeps the drift check honest.
model DocumentChunk {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  /// 1-based, as a PDF viewer counts them, so a citation can be followed by hand.
  page       Int
  /// Which piece of that page, for pages long enough to split.
  ordinal    Int      @default(0)
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, page, ordinal], map: "document_chunks_document_id_page_ordinal_key")
  @@index([tenantId, documentId])
  @@map("document_chunks")
}

// ---------------------------------------------------------------------------
// Client billing â€” money coming in
// ---------------------------------------------------------------------------
//
// Deliberately not the same tables as `expenses` and `labour_payments`, which are money going out.
// The difference between the two is the margin on the job, and a client must never be able to reach
// the outgoing side. Two tables keep that a structural fact rather than a `WHERE` clause somebody
// has to remember.

/// One instalment of what the client owes.
model PaymentStage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  /// "On completion of the slab" is a milestone; "On signing" is not.
  milestoneId String?   @map("milestone_id") @db.Uuid
  label       String
  /// Paise.
  amount      BigInt
  /// VAT charged on top of `amount` (roadmap Phase 1, item 5); the client owes both.
  taxAmount   BigInt    @default(0) @map("tax_amount")
  dueDate     DateTime? @map("due_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  /// When the builder actually asked for it. Upcoming, due and paid are derived from this and the
  /// receipts, so no status column can drift out of step with the money.
  raisedAt    DateTime? @map("raised_at") @db.Timestamptz(6)
  clientId    String?   @map("client_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  receipts  ClientPayment[]
  /// Set when this instalment is a BOQ running bill raised to the client (Phase 2, module 5).
  boqBill   BoqBill?

  @@unique([tenantId, clientId], map: "payment_stages_tenant_id_client_id_key")
  @@index([projectId, sortOrder])
  @@map("payment_stages")
}

/// Money that actually arrived from the client.
model ClientPayment {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  projectId  String      @map("project_id") @db.Uuid
  /// Null for a round sum somebody reconciles later. It still counts against the total.
  stageId    String?     @map("stage_id") @db.Uuid
  amount     BigInt
  receivedOn DateTime    @map("received_on") @db.Date
  mode       PaymentMode @default(bank)
  reference  String?
  note       String?
  recordedBy String      @map("recorded_by") @db.Uuid
  clientId   String?     @map("client_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    PaymentStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  recorder User          @relation("client_payment_recorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientId], map: "client_payments_tenant_id_client_id_key")
  @@index([projectId, receivedOn(sort: Desc)])
  @@index([stageId])
  @@map("client_payments")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@map("approval_status")
}

/// Something the client has been asked to sign off â€” a drawing, a selection, a variation.
///
/// The decision names whoever gave it. That is the whole value of the row: six months later the
/// argument is whether the client ever agreed to the granite, and an approval with nobody's name on
/// it settles nothing. The database enforces that a decided row carries all three of status,
/// decider and time, or none of them.
model Approval {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  /// Usually the drawing or quote in question, referenced so it always points at the revision that
  /// was current when the question was asked.
  documentId   String?        @map("document_id") @db.Uuid
  title        String
  body         String         @default("")
  status       ApprovalStatus @default(pending)
  requestedBy  String         @map("requested_by") @db.Uuid
  decidedBy    String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote String?        @map("decision_note")
  clientId     String?        @map("client_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  requester User      @relation("approval_requester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider   User?     @relation("approval_decider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientId], map: "approvals_tenant_id_client_id_key")
  @@index([projectId, status, createdAt(sort: Desc)])
  @@map("approvals")
}

/// One forecast per site per day (roadmap: AI agent 2, overrun early warning).
///
/// Written nightly on the company's clock and on demand. Kept per day rather than overwritten so
/// "it was fine last week" can be checked, and so a warning an owner acted on can be found again.
/// Figures are minor units in the company's currency, like every other amount.
model SiteForecast {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  asOf        DateTime @map("as_of") @db.Date
  /// progress | burn_rate | spend_only
  method      String
  spent       BigInt
  budget      BigInt?
  forecast    BigInt?
  overrunPct  Int?     @map("overrun_pct")
  progressPct Int?     @map("progress_pct")
  elapsedPct  Int?     @map("elapsed_pct")
  /// ok | watch | warning | critical
  severity    String
  /// ForecastDriver[] from @sitebook/shared, amounts as strings.
  drivers     Json
  explanation String
  /// template | ai — whether a language model reworded the explanation.
  explainedBy String   @map("explained_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, asOf])
  @@index([tenantId, asOf])
  @@map("site_forecasts")
}

/// A leak or fraud finding for a person to confirm or dismiss (roadmap: AI agent 3).
///
/// Unique on kind + subject so a finding is raised once and a dismissal sticks: the nightly run
/// inserts what is new and never reopens what somebody has already decided.
model SiteCheck {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  /// double_booked | never_off | headcount_gap | duplicate_expense | unusual_expense | unidentified_paid
  kind       String
  subjectKey String    @map("subject_key")
  /// high | medium
  severity   String
  title      String
  details    Json
  /// open | confirmed | dismissed
  status     String    @default("open")
  decidedBy  String?   @map("decided_by") @db.Uuid
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz(6)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, subjectKey])
  @@index([tenantId, status])
  @@map("site_checks")
}

/// A worker's passport, visa, Emirates ID, Iqama or labour card (roadmap Phase 1, item 3).
///
/// The number is encrypted by the API (AES-256-GCM, DOCUMENT_ENCRYPTION_KEY) and stored only as
/// ciphertext; `numberHint` keeps its last four characters so a list can tell two papers apart.
/// The expiry date is the point of the table: a lapsed residence visa is a fine for the employer.
model WorkerDocument {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  workerId     String    @map("worker_id") @db.Uuid
  /// One of WORKER_DOCUMENT_KINDS in @sitebook/shared.
  kind         String
  numberCipher String    @map("number_cipher")
  numberHint   String    @map("number_hint")
  issuedOn     DateTime? @map("issued_on") @db.Date
  expiresOn    DateTime? @map("expires_on") @db.Date
  s3Key        String?   @map("s3_key")
  /// When the owners were told it is about to lapse, so they are told once, not every morning.
  remindedAt   DateTime? @map("reminded_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([workerId])
  @@map("worker_documents")
}

/// A labour camp, and the bus that serves it (roadmap Phase 1, item 4).
model Camp {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  address       String?
  capacity      Int?
  transportNote String?   @map("transport_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residents Worker[]

  @@index([tenantId])
  @@map("camps")
}

/// Which tenant a Stripe subscription belongs to — the Stripe twin of BillingIdentity, and like it
/// one of the few tables with no RLS: a webhook arrives with no tenant context, and the nightly
/// lapse sweep needs the list of subscribed tenants without reading across them.
model StripeIdentity {
  stripeSubscriptionId String   @id @map("stripe_subscription_id")
  tenantId             String   @map("tenant_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stripe_identities")
}

/// One line of a site's work breakdown structure, and its budget (roadmap Phase 2, module 1).
///
/// The thing every later module posts against: expenses now, purchase orders and subcontracts
/// next. A tree through `parentId`; a parent may carry a budget of its own as well as its
/// children's. Hard-deleted, and only when nothing is posted to it and it has no children —
/// a code with history is renamed, not removed.
model CostCode {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  /// `03.20` — unique within the site.
  code          String
  name          String
  /// What the line is measured in, when it is measured: m3, m2, kg, nos.
  unit          String?
  /// Minor units, like every other amount.
  budget        BigInt   @default(0)
  /// Labour on the site lands on this line unless it is booked elsewhere. At most one per site.
  labourDefault Boolean  @default(false) @map("labour_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   CostCode?  @relation("cost_code_tree", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCode[] @relation("cost_code_tree")
  expenses Expense[]

  subcontractLines      SubcontractLine[]
  subcontractDeductions SubcontractDeduction[]
  rfqItems              PurchaseRfqItem[]
  orderLines            PurchaseOrderLine[]
  boqItems              BoqItem[]

  @@unique([projectId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("cost_codes")
}

/// A company's own work breakdown template, copied into a site to start its cost codes.
///
/// The built-in standard template is code (`STANDARD_WBS` in @sitebook/shared), not rows: every
/// company gets it without a migration writing into every tenant, and it can be improved later
/// without touching anybody's copy.
model CostCodeTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CostCodeTemplateItem[]

  @@index([tenantId])
  @@map("cost_code_templates")
}

/// A line of a template. The tree is by code (`parentCode`), because a template is copied by code
/// and edited as a list — there are no ids anything else points at.
model CostCodeTemplateItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  code       String
  name       String
  parentCode String? @map("parent_code")
  unit       String?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template CostCodeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([tenantId])
  @@map("cost_code_template_items")
}

// ---------------------------------------------------------------------------
// Subcontracts and progress (RA) billing (roadmap Phase 2, module 3)
// ---------------------------------------------------------------------------
//
// The subcontractor is a `Contractor`: the same party a labour gang is paid through, so one firm
// that supplies a gang on one site and plasters another on a lump sum is one name with one history.
//
// People are stored as bare ids (`submitted_by`, `certified_by`, ...) rather than relations to
// `User`: the audit log already records who wrote each row, and leaving `User` alone keeps this
// module out of a model every other module also extends.

enum SubcontractStatus {
  draft
  active
  completed
  closed
  terminated

  @@map("subcontract_status")
}

enum RaBillStatus {
  draft
  submitted
  certified
  paid

  @@map("ra_bill_status")
}

enum SubcontractDeductionKind {
  material
  labour
  damage
  penalty
  other

  @@map("subcontract_deduction_kind")
}

enum SubcontractPaymentKind {
  advance
  bill
  retention

  @@map("subcontract_payment_kind")
}

/// A subcontract: a scope of work on one site, let to one contractor, priced line by line.
///
/// The contract value is not a column — it is the sum of the original lines, plus approved
/// variations. A stored total would be one more figure that can disagree with the schedule it
/// claims to add up.
model Subcontract {
  id                             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                       String            @map("tenant_id") @db.Uuid
  projectId                      String            @map("project_id") @db.Uuid
  contractorId                   String            @map("contractor_id") @db.Uuid
  /// `SC-007`, unique within the company.
  number                         String
  title                          String
  scope                          String?
  startDate                      DateTime?         @map("start_date") @db.Date
  endDate                        DateTime?         @map("end_date") @db.Date
  /// Basis points held back from every bill: 500 = 5%.
  retentionBp                    Int               @default(0) @map("retention_bp")
  /// The share of retention due back at completion; the rest after the defects period.
  retentionReleaseAtCompletionBp Int               @default(5000) @map("retention_release_at_completion_bp")
  defectsLiabilityMonths         Int               @default(12) @map("defects_liability_months")
  /// Mobilisation advance agreed. What was actually paid is the `advance` payments.
  advanceAmount                  BigInt            @default(0) @map("advance_amount")
  advanceRecoveryBp              Int               @default(0) @map("advance_recovery_bp")
  /// The subcontractor's GST or VAT on their bills, basis points.
  taxRateBp                      Int               @default(0) @map("tax_rate_bp")
  paymentTerms                   String?           @map("payment_terms")
  status                         SubcontractStatus @default(draft)
  completedOn                    DateTime?         @map("completed_on") @db.Date
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: NoAction)

  lines      SubcontractLine[]
  variations SubcontractVariation[]
  bills      SubcontractBill[]
  releases   SubcontractRetentionRelease[]
  payments   SubcontractPayment[]
  documents  SubcontractDocument[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([contractorId])
  @@map("subcontracts")
}

/// A line of the schedule of rates. Lines with a `variationId` came from a variation and count
/// towards the contract only once it is approved.
model SubcontractLine {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  subcontractId String   @map("subcontract_id") @db.Uuid
  variationId   String?  @map("variation_id") @db.Uuid
  /// Refused (no action), not SetNull: un-coding a subcontract line would silently move its commitment and
  /// its certified cost to "Unallocated".
  costCodeId    String?  @map("cost_code_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  itemCode      String?  @map("item_code")
  description   String
  unit          String
  quantity      Decimal  @db.Decimal(14, 3)
  /// Minor units per unit.
  rate          BigInt
  /// `quantity × rate`, rounded to the minor unit once, here.
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract           @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  variation   SubcontractVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  costCode    CostCode?             @relation(fields: [costCodeId], references: [id], onDelete: NoAction)
  billLines   SubcontractBillLine[]

  @@index([tenantId])
  @@index([subcontractId, sortOrder])
  @@index([costCodeId])
  @@map("subcontract_lines")
}

/// Extra work (or a changed scope) on a running subcontract. Pending until somebody with
/// `subcontracts.certify` decides; the decision names them.
model SubcontractVariation {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  subcontractId String         @map("subcontract_id") @db.Uuid
  number        Int
  title         String
  reason        String?
  status        ApprovalStatus @default(pending)
  requestedBy   String         @map("requested_by") @db.Uuid
  decidedBy     String?        @map("decided_by") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?        @map("decision_note")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract       @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  lines       SubcontractLine[]

  @@unique([subcontractId, number])
  @@index([tenantId])
  @@map("subcontract_variations")
}

/// A running-account (RA) bill. The money columns are the bill's figures from `computeRaBill` —
/// kept up to date while it is a draft, and frozen at certification, so a certified bill always
/// prints what was certified.
model SubcontractBill {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  subcontractId          String       @map("subcontract_id") @db.Uuid
  /// RA-1, RA-2 … within the subcontract.
  number                 Int
  periodFrom             DateTime?    @map("period_from") @db.Date
  periodTo               DateTime     @map("period_to") @db.Date
  billDate               DateTime     @map("bill_date") @db.Date
  status                 RaBillStatus @default(draft)
  grossToDate            BigInt       @default(0) @map("gross_to_date")
  previousGross          BigInt       @default(0) @map("previous_gross")
  gross                  BigInt       @default(0)
  retentionToDate        BigInt       @default(0) @map("retention_to_date")
  retention              BigInt       @default(0)
  advanceRecoveredToDate BigInt       @default(0) @map("advance_recovered_to_date")
  advanceRecovery        BigInt       @default(0) @map("advance_recovery")
  deductions             BigInt       @default(0)
  taxRateBp              Int          @default(0) @map("tax_rate_bp")
  tax                    BigInt       @default(0)
  netPayable             BigInt       @default(0) @map("net_payable")
  note                   String?
  createdBy              String       @map("created_by") @db.Uuid
  submittedBy            String?      @map("submitted_by") @db.Uuid
  submittedAt            DateTime?    @map("submitted_at") @db.Timestamptz(6)
  certifiedBy            String?      @map("certified_by") @db.Uuid
  certifiedAt            DateTime?    @map("certified_at") @db.Timestamptz(6)
  certificationNote      String?      @map("certification_note")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract   Subcontract            @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  lines         SubcontractBillLine[]
  deductionRows SubcontractDeduction[]
  payments      SubcontractPayment[]

  @@unique([subcontractId, number])
  @@index([tenantId, status])
  @@map("subcontract_bills")
}

/// Work done to date on one line, as claimed and — once certified — as certified.
model SubcontractBillLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  billId            String   @map("bill_id") @db.Uuid
  lineId            String   @map("line_id") @db.Uuid
  claimedQuantity   Decimal  @map("claimed_quantity") @db.Decimal(14, 3)
  certifiedQuantity Decimal? @map("certified_quantity") @db.Decimal(14, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  line   SubcontractLine @relation(fields: [lineId], references: [id], onDelete: NoAction)

  @@unique([billId, lineId])
  @@index([tenantId])
  @@index([lineId])
  @@map("subcontract_bill_lines")
}

/// A back-charge on a bill: material or labour we supplied, damage, a penalty.
model SubcontractDeduction {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  billId          String                   @map("bill_id") @db.Uuid
  kind            SubcontractDeductionKind
  description     String
  amount          BigInt
  /// Where the recovery is booked: the cost it gives back belongs to the line that bore it.
  costCodeId      String?                  @map("cost_code_id") @db.Uuid
  expenseId       String?                  @map("expense_id") @db.Uuid
  stockMovementId String?                  @map("stock_movement_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill          SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  costCode      CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: NoAction)
  expense       Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  stockMovement StockMovement?  @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([billId])
  @@index([costCodeId])
  @@map("subcontract_deductions")
}

/// Retention handed back — at completion, after the defects period, or early by agreement. Once
/// released it is owed, and paid through a `retention` payment.
model SubcontractRetentionRelease {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  subcontractId String   @map("subcontract_id") @db.Uuid
  amount        BigInt
  releasedOn    DateTime @map("released_on") @db.Date
  note          String?
  approvedBy    String   @map("approved_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract          @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  payments    SubcontractPayment[]

  @@index([tenantId])
  @@index([subcontractId])
  @@map("subcontract_retention_releases")
}

/// Money paid to a subcontractor: the advance, a certified bill, or released retention.
model SubcontractPayment {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  subcontractId      String                 @map("subcontract_id") @db.Uuid
  kind               SubcontractPaymentKind
  billId             String?                @map("bill_id") @db.Uuid
  retentionReleaseId String?                @map("retention_release_id") @db.Uuid
  amount             BigInt
  paidOn             DateTime               @map("paid_on") @db.Date
  mode               PaymentMode            @default(bank)
  reference          String?
  note               String?
  recordedBy         String                 @map("recorded_by") @db.Uuid
  clientId           String?                @map("client_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract      Subcontract                  @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  bill             SubcontractBill?             @relation(fields: [billId], references: [id], onDelete: NoAction)
  retentionRelease SubcontractRetentionRelease? @relation(fields: [retentionReleaseId], references: [id], onDelete: NoAction)

  @@unique([tenantId, clientId], map: "subcontract_payments_tenant_id_client_id_key")
  @@index([tenantId])
  @@index([subcontractId, paidOn])
  @@index([billId])
  @@map("subcontract_payments")
}

/// The signed subcontract, its drawings, the subcontractor's insurance — documents uploaded through
/// the documents library and linked here, so a revision there is the revision here.
model SubcontractDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  subcontractId String   @map("subcontract_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([subcontractId, documentId])
  @@index([tenantId])
  @@map("subcontract_documents")
}

// ---------------------------------------------------------------------------
// Procurement (roadmap Phase 2, module 2)
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  draft
  pending_approval
  approved
  sent
  partially_received
  received
  closed
  cancelled

  @@map("purchase_order_status")
}

enum RfqStatus {
  open
  awarded
  cancelled

  @@map("rfq_status")
}

enum PurchaseInvoiceStatus {
  matched
  mismatch
  approved
  rejected

  @@map("purchase_invoice_status")
}

/// A supplier of materials. Not a `Contractor`: a contractor supplies labour and is paid through
/// wage periods; a vendor supplies goods against purchase orders and is paid on invoices.
/// Never hard-deleted once anything was ordered from it — it is made inactive instead.
model Vendor {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  contactName      String?  @map("contact_name")
  /// E.164 without the plus, like every phone in the product.
  phone            String?
  email            String?
  address          String?
  /// GSTIN, TRN or VAT number, normalised and checked against the company's regime.
  taxId            String?  @map("tax_id")
  /// Days after the invoice date the supplier expects payment.
  paymentTermsDays Int?     @map("payment_terms_days")
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes         PurchaseQuote[]
  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("vendors")
}

/// The most a role or a person may approve on one purchase order (company setting). Exactly one of
/// `roleId` and `userId`; a person's own row wins over their role's. `maxAmount` null is unlimited.
/// Anybody no row covers may approve nothing — owners are always unlimited.
model PurchaseApprovalLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String?  @map("role_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  maxAmount BigInt?  @map("max_amount")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId])
  @@unique([tenantId, userId])
  @@map("purchase_approval_limits")
}

/// A request for quotation: what a site needs, sent to several suppliers to price.
model PurchaseRfq {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  /// `RFQ-0001`, per company.
  number         String
  title          String
  notes          String?
  status         RfqStatus @default(open)
  indentId       String?   @map("indent_id") @db.Uuid
  requiredBy     DateTime? @map("required_by") @db.Date
  createdBy      String    @map("created_by") @db.Uuid
  /// The quote that won. Not a foreign key: the quote belongs to this RFQ and goes with it.
  awardedQuoteId String?   @map("awarded_quote_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  indent         MaterialIndent?   @relation(fields: [indentId], references: [id], onDelete: SetNull)
  creator        User              @relation("rfq_created_by", fields: [createdBy], references: [id], onDelete: Restrict)
  items          PurchaseRfqItem[]
  quotes         PurchaseQuote[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([projectId])
  @@map("purchase_rfqs")
}

model PurchaseRfqItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  rfqId       String  @map("rfq_id") @db.Uuid
  materialId  String? @map("material_id") @db.Uuid
  description String
  unit        String
  quantity    Decimal @db.Decimal(14, 3)
  costCodeId  String? @map("cost_code_id") @db.Uuid
  position    Int     @default(0)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq        PurchaseRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  material   Material?           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  costCode   CostCode?           @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  quoteLines PurchaseQuoteLine[]

  @@index([rfqId])
  @@index([tenantId])
  @@map("purchase_rfq_items")
}

/// One supplier's answer to an RFQ. One per supplier per RFQ; entering it again replaces it.
model PurchaseQuote {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  rfqId        String    @map("rfq_id") @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  deliveryDays Int?      @map("delivery_days")
  validUntil   DateTime? @map("valid_until") @db.Date
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq    PurchaseRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines  PurchaseQuoteLine[]

  @@unique([rfqId, vendorId])
  @@index([tenantId])
  @@map("purchase_quotes")
}

model PurchaseQuoteLine {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  quoteId   String @map("quote_id") @db.Uuid
  rfqItemId String @map("rfq_item_id") @db.Uuid
  /// Minor units per unit, before tax.
  unitRate  BigInt @map("unit_rate")
  /// Basis points: 500 = 5%.
  taxRateBp Int    @map("tax_rate_bp")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote   PurchaseQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem PurchaseRfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  @@unique([quoteId, rfqItemId])
  @@index([tenantId])
  @@map("purchase_quote_lines")
}

/// An order to a supplier. Totals are stored, added from the lines whenever they change, because
/// the approval limit is checked against them and a list of orders is sorted and summed by them.
model PurchaseOrder {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  projectId       String              @map("project_id") @db.Uuid
  vendorId        String              @map("vendor_id") @db.Uuid
  /// `PO-00001`, per company.
  number          String
  status          PurchaseOrderStatus @default(draft)
  rfqId           String?             @map("rfq_id") @db.Uuid
  indentId        String?             @map("indent_id") @db.Uuid
  notes           String?
  deliveryAddress String?             @map("delivery_address")
  expectedOn      DateTime?           @map("expected_on") @db.Date
  subtotal        BigInt              @default(0)
  taxTotal        BigInt              @default(0) @map("tax_total")
  total           BigInt              @default(0)
  createdBy       String              @map("created_by") @db.Uuid
  submittedAt     DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedBy      String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz(6)
  /// The approver's note, or why it was sent back.
  decisionNote    String?             @map("decision_note")
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor   Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  rfq      PurchaseRfq?        @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  indent   MaterialIndent?     @relation(fields: [indentId], references: [id], onDelete: SetNull)
  creator  User                @relation("po_created_by", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User?               @relation("po_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([projectId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  /// From the catalogue where there is one: only those lines can be booked into stock.
  materialId       String? @map("material_id") @db.Uuid
  description      String
  unit             String
  quantity         Decimal @db.Decimal(14, 3)
  unitRate         BigInt  @map("unit_rate")
  taxRateBp        Int     @map("tax_rate_bp")
  /// quantity × unitRate, rounded; and the tax on it. Stored so the order prints what was agreed.
  amount           BigInt
  taxAmount        BigInt  @map("tax_amount")
  /// Restrict: a cost code with an order against it cannot be deleted out from under it.
  costCodeId       String? @map("cost_code_id") @db.Uuid
  /// Sum of goods received against this line; kept in step by the receipt that changes it.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)
  position         Int     @default(0)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material     Material?             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  costCode     CostCode?             @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  receiptLines GoodsReceiptLine[]
  invoiceLines PurchaseInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([costCodeId])
  @@index([tenantId])
  @@map("purchase_order_lines")
}

/// A delivery signed for against an order (GRN). Each line books stock in on the site.
model GoodsReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  receivedOn      DateTime @map("received_on") @db.Date
  /// Delivery challan number.
  ref             String?
  note            String?
  receivedBy      String   @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receiver User               @relation("grn_received_by", fields: [receivedBy], references: [id], onDelete: Restrict)
  lines    GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([tenantId, receivedOn])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  /// The stock ledger row this line wrote; null for a line with no catalogue material.
  stockMovementId     String? @unique @map("stock_movement_id") @db.Uuid

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt       GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine     PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  stockMovement StockMovement?    @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([purchaseOrderLineId])
  @@index([tenantId])
  @@map("goods_receipt_lines")
}

/// A supplier's invoice against an order, matched to the order and to what was received.
/// Approving it books the expense; until then the order's value stays committed.
model PurchaseInvoice {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  purchaseOrderId String                @map("purchase_order_id") @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  vendorId        String                @map("vendor_id") @db.Uuid
  invoiceNumber   String                @map("invoice_number")
  invoiceDate     DateTime              @map("invoice_date") @db.Date
  dueDate         DateTime?             @map("due_date") @db.Date
  subtotal        BigInt
  taxTotal        BigInt                @map("tax_total")
  total           BigInt
  attachmentS3Key String?               @map("attachment_s3_key")
  status          PurchaseInvoiceStatus
  /// What the three-way match found, as `MatchFlag[]`. Empty when it matched.
  flags           Json                  @default("[]") @db.JsonB
  /// The tolerance it was matched with, so a later change of setting does not rewrite history.
  toleranceBp     Int                   @map("tolerance_bp")
  note            String?
  recordedBy      String                @map("recorded_by") @db.Uuid
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz(6)
  decisionNote    String?               @map("decision_note")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor   Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  recorder User                  @relation("pinv_recorded_by", fields: [recordedBy], references: [id], onDelete: Restrict)
  approver User?                 @relation("pinv_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)
  lines    PurchaseInvoiceLine[]

  /// The same supplier invoice entered twice is how a bill gets paid twice.
  @@unique([vendorId, invoiceNumber])
  @@index([tenantId, status])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  invoiceId           String  @map("invoice_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  unitRate            BigInt  @map("unit_rate")
  amount              BigInt
  taxAmount           BigInt  @map("tax_amount")
  /// The expense this line was booked into when the invoice was approved (one per cost code).
  expenseId           String? @map("expense_id") @db.Uuid

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   PurchaseInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  expense   Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([purchaseOrderLineId])
  @@index([expenseId])
  @@index([tenantId])
  @@map("purchase_invoice_lines")
}

// ---------------------------------------------------------------------------
// Bill of quantities (roadmap Phase 2, module 5)
// ---------------------------------------------------------------------------
//
// The client-side BOQ: what the builder bills the client, item by item. Not a subcontract's schedule
// of rates (what a subcontractor bills us) — the difference between the two is the margin.
//
// A certified BOQ bill becomes money owed through the existing client billing: invoicing it adds an
// instalment to the site's payment schedule (`payment_stages`), and receipts against that instalment
// are what make it paid. There is one client ledger, not two.

enum BoqItemKind {
  section
  item

  @@map("boq_item_kind")
}

enum BoqBillStatus {
  draft
  submitted
  certified
  invoiced

  @@map("boq_bill_status")
}

/// One site's bill of quantities, and the client's billing terms on it. At most one per site.
model Boq {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @unique @map("project_id") @db.Uuid
  title             String   @default("Bill of quantities")
  /// Basis points the client holds back from every bill: 500 = 5%.
  retentionBp       Int      @default(0) @map("retention_bp")
  /// Mobilisation advance the client paid, minor units; recovered from the bills.
  advanceAmount     BigInt   @default(0) @map("advance_amount")
  advanceRecoveryBp Int      @default(0) @map("advance_recovery_bp")
  /// GST or VAT charged to the client on each bill, basis points.
  taxRateBp         Int      @default(0) @map("tax_rate_bp")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BoqItem[]
  bills   BoqBill[]

  @@index([tenantId])
  @@map("boqs")
}

/// A section heading or a priced item. A tree through `parentId`; the contract value of a section is
/// its items' sum, worked out rather than stored.
model BoqItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  boqId       String      @map("boq_id") @db.Uuid
  parentId    String?     @map("parent_id") @db.Uuid
  /// Refused (no action) rather than nulled, like a subcontract line: un-coding an item quietly moves
  /// its revenue off the line it was priced against.
  costCodeId  String?     @map("cost_code_id") @db.Uuid
  kind        BoqItemKind @default(item)
  /// `2.1.3`, unique within the BOQ.
  itemNo      String      @map("item_no")
  description String
  unit        String?
  /// Contract quantity. Null on a section.
  quantity    Decimal?    @db.Decimal(14, 3)
  /// Minor units per unit.
  rate        BigInt?
  /// `quantity × rate`, rounded to the minor unit once, here.
  amount      BigInt?
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boq          Boq              @relation(fields: [boqId], references: [id], onDelete: Cascade)
  parent       BoqItem?         @relation("boq_item_tree", fields: [parentId], references: [id], onDelete: Cascade)
  children     BoqItem[]        @relation("boq_item_tree")
  costCode     CostCode?        @relation(fields: [costCodeId], references: [id], onDelete: NoAction)
  measurements BoqMeasurement[]
  billLines    BoqBillLine[]

  @@unique([boqId, itemNo])
  @@index([tenantId])
  @@index([boqId, sortOrder])
  @@index([parentId])
  @@index([costCodeId])
  @@map("boq_items")
}

/// One entry in the measurement book: work measured on site against an item.
model BoqMeasurement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  measuredOn DateTime @map("measured_on") @db.Date
  location   String?
  count      Decimal? @db.Decimal(14, 3)
  length     Decimal? @db.Decimal(14, 3)
  breadth    Decimal? @db.Decimal(14, 3)
  height     Decimal? @db.Decimal(14, 3)
  /// The product of the dimensions given; negative for a deduction.
  quantity   Decimal  @db.Decimal(14, 3)
  note       String?
  photoKeys  String[] @default([]) @map("photo_keys")
  /// A bare id, like the people on a subcontract bill: the audit log already says who wrote the row.
  measuredBy String   @map("measured_by") @db.Uuid
  clientId   String?  @map("client_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   BoqItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId], map: "boq_measurements_tenant_id_client_id_key")
  @@index([tenantId])
  @@index([itemId, measuredOn])
  @@map("boq_measurements")
}

/// A running-account bill to the client. The money columns are `boqComputeBill`'s figures — kept up
/// to date while it is a draft, frozen at certification — so a certified bill always prints what the
/// client certified. `claimedGross` keeps what was asked for, beside what was certified.
model BoqBill {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  boqId                  String        @map("boq_id") @db.Uuid
  /// RA-1, RA-2 … within the BOQ.
  number                 Int
  periodFrom             DateTime?     @map("period_from") @db.Date
  periodTo               DateTime      @map("period_to") @db.Date
  billDate               DateTime      @map("bill_date") @db.Date
  status                 BoqBillStatus @default(draft)
  claimedGross           BigInt        @default(0) @map("claimed_gross")
  grossToDate            BigInt        @default(0) @map("gross_to_date")
  previousGross          BigInt        @default(0) @map("previous_gross")
  gross                  BigInt        @default(0)
  retentionToDate        BigInt        @default(0) @map("retention_to_date")
  retention              BigInt        @default(0)
  advanceRecoveredToDate BigInt        @default(0) @map("advance_recovered_to_date")
  advanceRecovery        BigInt        @default(0) @map("advance_recovery")
  taxRateBp              Int           @default(0) @map("tax_rate_bp")
  tax                    BigInt        @default(0)
  netPayable             BigInt        @default(0) @map("net_payable")
  note                   String?
  createdBy              String        @map("created_by") @db.Uuid
  submittedBy            String?       @map("submitted_by") @db.Uuid
  submittedAt            DateTime?     @map("submitted_at") @db.Timestamptz(6)
  certifiedBy            String?       @map("certified_by") @db.Uuid
  certifiedAt            DateTime?     @map("certified_at") @db.Timestamptz(6)
  certificationNote      String?       @map("certification_note")
  invoicedBy             String?       @map("invoiced_by") @db.Uuid
  invoicedAt             DateTime?     @map("invoiced_at") @db.Timestamptz(6)
  /// The instalment this bill became in the client's payment schedule.
  paymentStageId         String?       @unique @map("payment_stage_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boq          Boq           @relation(fields: [boqId], references: [id], onDelete: Cascade)
  paymentStage PaymentStage? @relation(fields: [paymentStageId], references: [id], onDelete: SetNull)
  lines        BoqBillLine[]

  @@unique([boqId, number])
  @@index([tenantId, status])
  @@map("boq_bills")
}

/// Quantity to date on one item, as claimed and — once the client certifies — as certified.
model BoqBillLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  billId            String   @map("bill_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  claimedQuantity   Decimal  @map("claimed_quantity") @db.Decimal(14, 3)
  certifiedQuantity Decimal? @map("certified_quantity") @db.Decimal(14, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   BoqBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  item   BoqItem @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@unique([billId, itemId])
  @@index([tenantId])
  @@index([itemId])
  @@map("boq_bill_lines")
}
