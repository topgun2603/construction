// SiteBook data model â€” Phase 1 tables (spec Â§7).
//
// Conventions (spec Â§17):
//   * Every tenant-scoped model carries `tenantId` and has an RLS policy created in
//     the same migration. Child tables (dpr_*, wage_lines, indent_items) carry
//     `tenantId` too, so RLS protects them directly rather than only via the parent.
//   * Every tenant table is audited unless it is listed as excluded in migration
//     20261006000200_full_audit_log: its migration adds `SELECT audit_attach('table');`.
//   * Money is `BigInt` paise. Never Float, never Decimal.
//   * Report/attendance dates are `@db.Date`; everything else is `@db.Timestamptz(6)`.
//   * `clientId` is the device-generated UUID used as the sync idempotency key (Â§8).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// What a builder can buy.
///
/// A row rather than an enum, because the price of a term, what it is called, and how long it runs
/// are commercial decisions — the sort that change on a phone call with a customer, and should not
/// need a deploy. Adding "two years" is now an operator's afternoon rather than a migration.
///
/// No `tenant_id` and no RLS: the catalogue is the same for everybody, read by tenants who are
/// deciding and written only from the platform console.
model Plan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable identifier stored on `tenants.plan`. Never shown to anybody.
  code        String   @unique
  /// What a builder reads: "3 months", "Lifetime".
  name        String
  /// How long the term runs. Null is a plan that never expires.
  months      Int?
  /// Whole-term price in paise, like all money here.
  pricePaise  BigInt   @map("price_paise")
  /// The price in other currencies, in each one's minor units: { "AED": 99900 } (roadmap Phase 0,
  /// item 7). A company paying in a currency with no entry here cannot subscribe online yet.
  prices      Json     @default("{}")
  /// A sentence under the price, for anything the name cannot carry.
  description String?
  /// A ribbon on the card: "Best value", "Most popular". Null for a plan that is not called out.
  badge       String?
  /// Bullets shown beneath a plan. Every plan includes every feature, so these are for terms and
  /// promises — "best value", "no renewals ever" — not for feature lists.
  highlights  String[] @default([])
  /// Whether it can still be bought. Retired rather than deleted, so an account already on it
  /// keeps a plan that resolves to something.
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("plans")
}

enum TenantStatus {
  active
  suspended
  cancelled

  @@map("tenant_status")
}

enum UserRole {
  owner
  project_manager
  site_supervisor
  accounts
  client

  @@map("user_role")
}

enum UserStatus {
  pending
  active
  disabled

  @@map("user_status")
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed

  @@map("project_status")
}

enum PaymentTerms {
  weekly
  fortnightly
  monthly

  @@map("payment_terms")
}

enum SkillLevel {
  unskilled
  semi
  skilled

  @@map("skill_level")
}

enum WorkerStatus {
  active
  inactive

  @@map("worker_status")
}

enum DprStatus {
  draft
  submitted

  @@map("dpr_status")
}

enum AttendanceStatus {
  present
  half_day
  absent

  @@map("attendance_status")
}

enum WagePeriodStatus {
  open
  finalised
  paid

  @@map("wage_period_status")
}

enum LabourPaymentType {
  advance
  wage
  bonus
  deduction

  @@map("labour_payment_type")
}

enum PaymentMode {
  cash
  upi
  bank
  bkash
  nagad
  esewa
  khalti

  @@map("payment_mode")
}

enum IndentStatus {
  requested
  approved
  rejected
  ordered
  received

  @@map("indent_status")
}

enum Urgency {
  low
  normal
  high

  @@map("urgency")
}

enum ExpenseStatus {
  pending
  approved
  rejected

  @@map("expense_status")
}

enum SyncOp {
  create
  update

  @@map("sync_op")
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

/// The builder. Root of every tenant-scoped row; has no tenant_id of its own, so
/// it is guarded by a policy matching on `id` instead.
model Tenant {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  logoUrl            String?      @map("logo_url")
  /// The `code` of a row in `plans`. Deliberately not a foreign key: a plan that is retired or
  /// mistakenly deleted must not take its customers' accounts down with it.
  plan               String       @default("three_months")
  /// When the current term began. Null on an account that has never had one set.
  planStartedOn      DateTime?    @map("plan_started_on") @db.Timestamptz(6)
  /// When it runs out. Null means lifetime — not "already expired", which is the reading that
  /// would lock out exactly the customers who paid the most.
  planExpiresOn      DateTime?    @map("plan_expires_on") @db.Timestamptz(6)
  enabledModules     String[]     @default([]) @map("enabled_modules")
  razorpayCustomerId String?      @map("razorpay_customer_id")
  /// Locale settings (roadmap Phase 0). Defaults are India's, so every existing company reads
  /// exactly as before. Validated by `tenantLocaleSchema` in @sitebook/shared.
  /// ISO 3166-1 alpha-2.
  country            String       @default("IN") @db.Char(2)
  /// ISO 4217. Fixes the exponent of every minor-unit amount this company has stored, so it is
  /// set at onboarding and not editable afterwards — changing it would re-read paise as fils.
  currency           String       @default("INR") @db.Char(3)
  /// IANA zone. "Today" for attendance and reports, and when scheduled jobs fire.
  timezone           String       @default("Asia/Kolkata")
  /// BCP 47 tag for number and date display.
  locale             String       @default("en-IN")
  /// One of TAX_REGIMES in @sitebook/shared.
  taxRegime          String       @default("gst_in") @map("tax_regime")
  /// UAE Wage Protection System: the 13-digit MOL establishment id and the routing code of the
  /// bank or exchange house that pays the salaries. Both appear in every salary file (SIF).
  wpsEmployerId      String?      @map("wps_employer_id")
  wpsBankCode        String?      @map("wps_bank_code")
  /// Procurement's three-way match tolerance, in basis points (200 = 2%).
  matchToleranceBp   Int          @default(200) @map("invoice_match_tolerance_bp")
  status             TenantStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                 User[]
  refreshTokens         RefreshToken[]
  projects              Project[]
  projectMembers        ProjectMember[]
  milestones            Milestone[]
  contractors           Contractor[]
  workers               Worker[]
  workerProjects        WorkerProject[]
  dailyReports          DailyReport[]
  dprActivities         DprActivity[]
  dprPhotos             DprPhoto[]
  dprManpower           DprManpower[]
  attendance            Attendance[]
  wagePeriods           WagePeriod[]
  wageLines             WageLine[]
  labourPayments        LabourPayment[]
  materials             Material[]
  materialIndents       MaterialIndent[]
  indentItems           IndentItem[]
  expenses              Expense[]
  siteForecasts         SiteForecast[]
  siteChecks            SiteCheck[]
  workerDocuments       WorkerDocument[]
  camps                 Camp[]
  costCodes             CostCode[]
  costCodeTemplates     CostCodeTemplate[]
  costCodeTemplateItems CostCodeTemplateItem[]
  subcontracts          Subcontract[]
  subcontractLines      SubcontractLine[]
  subcontractVariations SubcontractVariation[]
  subcontractBills      SubcontractBill[]
  subcontractBillLines  SubcontractBillLine[]
  subcontractDeductions SubcontractDeduction[]
  retentionReleases     SubcontractRetentionRelease[]
  subcontractPayments   SubcontractPayment[]
  subcontractDocuments  SubcontractDocument[]
  notifications         Notification[]
  syncLogs              SyncLog[]
  auditLogs             AuditLog[]

  roles Role[]

  materialEstimates  MaterialEstimate[]
  stockMovements     StockMovement[]
  subscription       Subscription?
  invoices           Invoice[]
  projectMedia       ProjectMedia[]
  billingIdentities  BillingIdentity[]
  stripeIdentities   StripeIdentity[]
  siteMessages       SiteMessage[]
  messageAttachments SiteMessageAttachment[]
  messageReads       SiteMessageRead[]
  documents          Document[]
  documentChunks     DocumentChunk[]
  paymentStages      PaymentStage[]
  clientPayments     ClientPayment[]
  approvals          Approval[]

  // Procurement
  vendors                Vendor[]
  purchaseApprovalLimits PurchaseApprovalLimit[]
  purchaseRfqs           PurchaseRfq[]
  purchaseRfqItems       PurchaseRfqItem[]
  purchaseQuotes         PurchaseQuote[]
  purchaseQuoteLines     PurchaseQuoteLine[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderLines     PurchaseOrderLine[]
  goodsReceipts          GoodsReceipt[]
  goodsReceiptLines      GoodsReceiptLine[]
  purchaseInvoices       PurchaseInvoice[]
  purchaseInvoiceLines   PurchaseInvoiceLine[]

  // Bill of quantities
  boqs            Boq[]
  boqItems        BoqItem[]
  boqMeasurements BoqMeasurement[]
  boqBills        BoqBill[]
  boqBillLines    BoqBillLine[]

  @@map("tenants")
}

/// A role within one tenant: a name, a permission set, and how much it can see.
///
/// The five built-in roles are rows here too (`isSystem`), seeded for every tenant, so the
/// permission check has one code path rather than "is it a preset or a custom one". System
/// rows cannot be edited or deleted â€” an owner who could strip `roles.manage` from the
/// owner role would lock the account's last administrator out of fixing it.
model Role {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  /// The built-in role this one is based on, which still drives `project_members` and the
  /// wage-sheet semantics that are not expressible as permissions.
  baseRole        UserRole @map("base_role")
  permissions     String[] @default([])
  /// Tenant-wide visibility rather than only assigned projects.
  seesAllProjects Boolean  @default(false) @map("sees_all_projects")
  isSystem        Boolean  @default(false) @map("is_system")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  purchaseApprovalLimits PurchaseApprovalLimit[]

  @@unique([tenantId, name], map: "roles_tenant_id_name_key")
  @@index([tenantId])
  @@map("roles")
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  phone     String
  /// Work email, if they have given one. Only used to let Google sign-in find them — the phone
  /// stays the identity everything else is keyed by. Unique per tenant among live users.
  email     String?
  name      String
  role      UserRole
  status    UserStatus @default(pending)
  /// Which role row applies. Backfilled from `role` for every existing user.
  roleId    String?    @map("role_id") @db.Uuid
  roleRef   Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  fcmTokens String[]   @default([]) @map("fcm_tokens")
  lastLogin DateTime?  @map("last_login") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  refreshTokens      RefreshToken[]
  projectMemberships ProjectMember[]
  submittedReports   DailyReport[]     @relation("dpr_submitted_by")
  recordedAttendance Attendance[]      @relation("attendance_recorded_by")
  finalisedPeriods   WagePeriod[]      @relation("wage_period_finalised_by")
  recordedPayments   LabourPayment[]   @relation("labour_payment_recorded_by")
  requestedIndents   MaterialIndent[]  @relation("indent_requested_by")
  approvedIndents    MaterialIndent[]  @relation("indent_approved_by")
  submittedExpenses  Expense[]         @relation("expense_submitted_by")
  approvedExpenses   Expense[]         @relation("expense_approved_by")
  notifications      Notification[]
  workers            Worker[]          @relation("worker_portal_user")
  stockRecorded      StockMovement[]   @relation("stock_recorded_by")
  mediaUploaded      ProjectMedia[]    @relation("media_uploaded_by")
  messagesWritten    SiteMessage[]     @relation("message_author")
  messagesReceived   SiteMessage[]     @relation("message_recipient")
  paymentsRecorded   ClientPayment[]   @relation("client_payment_recorder")
  approvalsRaised    Approval[]        @relation("approval_requester")
  approvalsDecided   Approval[]        @relation("approval_decider")
  messageReads       SiteMessageRead[]
  documentsUploaded  Document[]        @relation("document_uploader")

  // Procurement
  purchaseApprovalLimits   PurchaseApprovalLimit[]
  rfqsCreated              PurchaseRfq[]           @relation("rfq_created_by")
  purchaseOrdersCreated    PurchaseOrder[]         @relation("po_created_by")
  purchaseOrdersApproved   PurchaseOrder[]         @relation("po_approved_by")
  goodsReceived            GoodsReceipt[]          @relation("grn_received_by")
  purchaseInvoicesRecorded PurchaseInvoice[]       @relation("pinv_recorded_by")
  purchaseInvoicesApproved PurchaseInvoice[]       @relation("pinv_approved_by")

  /// Phone is unique within a tenant, not globally â€” the same person can be a
  /// supervisor at one builder and an owner at another.
  @@unique([tenantId, phone], map: "users_tenant_id_phone_key")
  @@index([tenantId, role])
  @@index([tenantId, updatedAt])
  @@index([roleId])
  @@map("users")
}

/// Refresh tokens are stored hashed and rotated on use (spec Â§6.2, Â§15).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  deviceId     String?   @map("device_id")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when this token was rotated, so a replayed token reveals the whole chain.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  name          String
  clientName    String?       @map("client_name")
  address       String?
  lat           Float?
  lng           Float?
  startDate     DateTime?     @map("start_date") @db.Date
  targetEndDate DateTime?     @map("target_end_date") @db.Date
  budgetAmount  BigInt?       @map("budget_amount")
  status        ProjectStatus @default(planning)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members           ProjectMember[]
  milestones        Milestone[]
  dailyReports      DailyReport[]
  attendance        Attendance[]
  workerProjects    WorkerProject[]
  labourPayments    LabourPayment[]
  indents           MaterialIndent[]
  expenses          Expense[]
  siteForecasts     SiteForecast[]
  siteChecks        SiteCheck[]
  messages          SiteMessage[]
  messageReads      SiteMessageRead[]
  documents         Document[]
  paymentStages     PaymentStage[]
  clientPayments    ClientPayment[]
  approvals         Approval[]
  materialEstimates MaterialEstimate[]
  stockMovements    StockMovement[]
  media             ProjectMedia[]
  costCodes         CostCode[]
  subcontracts      Subcontract[]
  purchaseRfqs      PurchaseRfq[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  purchaseInvoices  PurchaseInvoice[]
  boq               Boq?

  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@map("projects")
}

/// Project-level assignment: controls which projects a supervisor, PM or client sees.
model ProjectMember {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  roleOnProject UserRole @map("role_on_project")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], map: "project_members_project_id_user_id_key")
  @@index([tenantId, userId])
  @@map("project_members")
}

model Milestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String
  plannedDate DateTime? @map("planned_date") @db.Date
  actualDate  DateTime? @map("actual_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  PaymentStage PaymentStage[]

  @@index([projectId, sortOrder])
  @@map("milestones")
}

// ---------------------------------------------------------------------------
// Labour registry
// ---------------------------------------------------------------------------

model Contractor {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  trade        String?
  phone        String?
  paymentTerms PaymentTerms @default(weekly) @map("payment_terms")
  /// GSTIN or TRN, for a contractor that bills as a subcontractor (roadmap Phase 2, module 3).
  taxId        String?      @map("tax_id")
  address      String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workers        Worker[]
  wagePeriods    WagePeriod[]
  labourPayments LabourPayment[]
  subcontracts   Subcontract[]

  @@index([tenantId, updatedAt])
  @@map("contractors")
}

model Worker {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  /// Null means direct labour rather than a subcontracted gang.
  contractorId        String?      @map("contractor_id") @db.Uuid
  name                String
  phone               String?
  trade               String?
  skillLevel          SkillLevel   @default(unskilled) @map("skill_level")
  /// Paise per day. Changing this never alters past attendance â€” see wage_snapshot.
  dailyWage           BigInt       @map("daily_wage")
  overtimeRatePerHour BigInt       @default(0) @map("overtime_rate_per_hour")
  idProofS3Key        String?      @map("id_proof_s3_key")
  photoS3Key          String?      @map("photo_s3_key")
  status              WorkerStatus @default(active)
  /// Device-generated UUID when the supervisor added this worker offline.
  clientId            String?      @map("client_id") @db.Uuid
  /// Optional link to a `client`-role user for Phase 3 worker self-service.
  portalUserId        String?      @map("portal_user_id") @db.Uuid
  /// daily | monthly (roadmap Phase 1, item 2). A monthly worker's dailyWage is kept at fixed/30
  /// so reports that price a roll-call day stay right; the wage period uses the salary itself.
  payBasis            String       @default("daily") @map("pay_basis")
  basicSalary         BigInt?      @map("basic_salary")
  housingAllowance    BigInt       @default(0) @map("housing_allowance")
  transportAllowance  BigInt       @default(0) @map("transport_allowance")
  foodAllowance       BigInt       @default(0) @map("food_allowance")
  /// UAE Wage Protection System: the 14-digit MOL personal number, the routing code of the
  /// worker's bank or exchange house, and the IBAN or salary card number the salary goes to.
  wpsPersonId         String?      @map("wps_person_id")
  wpsAgentCode        String?      @map("wps_agent_code")
  wpsAccount          String?      @map("wps_account")
  /// The labour camp the worker lives in (roadmap Phase 1, item 4). Null for local hires.
  campId              String?      @map("camp_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  portalUser User?       @relation("worker_portal_user", fields: [portalUserId], references: [id], onDelete: SetNull)

  workerProjects WorkerProject[]
  attendance     Attendance[]
  wageLines      WageLine[]
  labourPayments LabourPayment[]
  documents      WorkerDocument[]
  camp           Camp?            @relation(fields: [campId], references: [id], onDelete: SetNull)

  @@unique([tenantId, clientId], map: "workers_tenant_id_client_id_key")
  @@index([campId])
  @@index([tenantId, contractorId])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@map("workers")
}

/// Which sites a worker is on, over time. The roll call lists only workers whose
/// assignment window covers the attendance date.
model WorkerProject {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  workerId  String    @map("worker_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  fromDate  DateTime  @map("from_date") @db.Date
  toDate    DateTime? @map("to_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workerId, projectId, fromDate], map: "worker_projects_worker_project_from_key")
  @@index([projectId, fromDate, toDate])
  @@index([tenantId, updatedAt])
  @@map("worker_projects")
}

// ---------------------------------------------------------------------------
// Daily progress reports
// ---------------------------------------------------------------------------

model DailyReport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  reportDate  DateTime  @map("report_date") @db.Date
  submittedBy String    @map("submitted_by") @db.Uuid
  weather     String?
  workDone    String?   @map("work_done")
  issues      String?
  status      DprStatus @default(draft)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
