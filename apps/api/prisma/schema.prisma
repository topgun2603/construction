/// Project-level assignment: controls which projects a supervisor, PM or client sees.
model ProjectMember {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  roleOnProject UserRole @map("role_on_project")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], map: "project_members_project_id_user_id_key")
  @@index([tenantId, userId])
  @@map("project_members")
}

model Milestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String
  plannedDate DateTime? @map("planned_date") @db.Date
  actualDate  DateTime? @map("actual_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  PaymentStage       PaymentStage[]
  qualityInspections QualityInspection[]
  /// The schedule task this milestone is, once it has been put on the schedule.
  scheduleTask       ScheduleTask?

  @@index([projectId, sortOrder])
  @@map("milestones")
}

// ---------------------------------------------------------------------------
// Labour registry
// ---------------------------------------------------------------------------

model Contractor {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  name         String
  trade        String?
  phone        String?
  paymentTerms PaymentTerms @default(weekly) @map("payment_terms")
  /// GSTIN or TRN, for a contractor that bills as a subcontractor (roadmap Phase 2, module 3).
  taxId        String?      @map("tax_id")
  address      String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workers        Worker[]
  wagePeriods    WagePeriod[]
  labourPayments LabourPayment[]
  subcontracts   Subcontract[]
  snagsAssigned  Snag[]
  scheduleTasks  ScheduleTask[]

  submittals Submittal[]

  @@index([tenantId, updatedAt])
  @@map("contractors")
}

model Worker {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  /// Null means direct labour rather than a subcontracted gang.
  contractorId        String?      @map("contractor_id") @db.Uuid
  name                String
  phone               String?
  trade               String?
  skillLevel          SkillLevel   @default(unskilled) @map("skill_level")
  /// Paise per day. Changing this never alters past attendance â€” see wage_snapshot.
  dailyWage           BigInt       @map("daily_wage")
  overtimeRatePerHour BigInt       @default(0) @map("overtime_rate_per_hour")
  idProofS3Key        String?      @map("id_proof_s3_key")
  photoS3Key          String?      @map("photo_s3_key")
  status              WorkerStatus @default(active)
  /// Device-generated UUID when the supervisor added this worker offline.
  clientId            String?      @map("client_id") @db.Uuid
  /// Optional link to a `client`-role user for Phase 3 worker self-service.
  portalUserId        String?      @map("portal_user_id") @db.Uuid
  /// daily | monthly (roadmap Phase 1, item 2). A monthly worker's dailyWage is kept at fixed/30
  /// so reports that price a roll-call day stay right; the wage period uses the salary itself.
  payBasis            String       @default("daily") @map("pay_basis")
  basicSalary         BigInt?      @map("basic_salary")
  housingAllowance    BigInt       @default(0) @map("housing_allowance")
  transportAllowance  BigInt       @default(0) @map("transport_allowance")
  foodAllowance       BigInt       @default(0) @map("food_allowance")
  /// UAE Wage Protection System: the 14-digit MOL personal number, the routing code of the
  /// worker's bank or exchange house, and the IBAN or salary card number the salary goes to.
  wpsPersonId         String?      @map("wps_person_id")
  wpsAgentCode        String?      @map("wps_agent_code")
  wpsAccount          String?      @map("wps_account")
  /// The labour camp the worker lives in (roadmap Phase 1, item 4). Null for local hires.
  campId              String?      @map("camp_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  portalUser User?       @relation("worker_portal_user", fields: [portalUserId], references: [id], onDelete: SetNull)

  workerProjects WorkerProject[]
  attendance     Attendance[]
  wageLines      WageLine[]
  labourPayments LabourPayment[]
  documents      WorkerDocument[]
  camp           Camp?            @relation(fields: [campId], references: [id], onDelete: SetNull)

  // Safety (HSE)
  safetyIncidentPeople SafetyIncidentPerson[]
  safetyPermitCrew     SafetyPermitCrew[]
  safetyToolboxTalks   SafetyToolboxAttendee[]

  // Equipment: the machines they operated
  equipmentLogs EquipmentLog[]

  @@unique([tenantId, clientId], map: "workers_tenant_id_client_id_key")
  @@index([campId])
  @@index([tenantId, contractorId])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@map("workers")
}

/// Which sites a worker is on, over time. The roll call lists only workers whose
/// assignment window covers the attendance date.
model WorkerProject {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  workerId  String    @map("worker_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  fromDate  DateTime  @map("from_date") @db.Date
  toDate    DateTime? @map("to_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workerId, projectId, fromDate], map: "worker_projects_worker_project_from_key")
  @@index([projectId, fromDate, toDate])
  @@index([tenantId, updatedAt])
  @@map("worker_projects")
}

// ---------------------------------------------------------------------------
// Daily progress reports
// ---------------------------------------------------------------------------

model DailyReport {
