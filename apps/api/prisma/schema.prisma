  @@unique([indentId, materialId], map: "indent_items_indent_id_material_id_key")
  @@map("indent_items")
}

enum StockMovementType {
  in
  out

  @@map("stock_movement_type")
}

/// What a site is expected to consume of a material (spec Â§7, Phase 2).
///
/// One row per project and material, which is what makes the overrun report possible: without
/// an expected figure, "you have used 180 bags" is a number nobody can act on.
model MaterialEstimate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  materialId        String   @map("material_id") @db.Uuid
  estimatedQuantity Decimal  @map("estimated_quantity") @db.Decimal(14, 3)
  note              String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([projectId, materialId], map: "material_estimates_project_id_material_id_key")
  @@index([tenantId, projectId])
  @@map("material_estimates")
}

/// Every movement of material on or off a site (spec Â§7, Phase 2).
///
/// An append-only ledger rather than a running `stock_on_hand` column. Stock is the sum of its
/// movements, so "why do we have 12 bags" is always answerable â€” a single balance column would
/// give the number and lose the reason, and the first disagreement with the site would have
/// nothing to check against.
model StockMovement {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  projectId  String            @map("project_id") @db.Uuid
  materialId String            @map("material_id") @db.Uuid
  type       StockMovementType
  quantity   Decimal           @db.Decimal(14, 3)
  /// The day the material moved, which is not the day it was typed in.
  movedOn    DateTime          @map("moved_on") @db.Date
  /// Set when this row came from receiving an indent, so a GRN can be traced back.
  indentId   String?           @map("indent_id") @db.Uuid
  /// Challan or bill number for an inward movement; free text because every supplier differs.
  ref        String?
  note       String?
  recordedBy String            @map("recorded_by") @db.Uuid
  clientId   String?           @map("client_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  indent   MaterialIndent? @relation(fields: [indentId], references: [id], onDelete: SetNull)
  recorder User            @relation("stock_recorded_by", fields: [recordedBy], references: [id], onDelete: Restrict)

  subcontractDeductions SubcontractDeduction[]
  goodsReceiptLine      GoodsReceiptLine?

  equipmentFuel EquipmentFuel?

  @@unique([tenantId, clientId], map: "stock_movements_tenant_id_client_id_key")
  @@index([tenantId, projectId, materialId])
  @@index([projectId, movedOn])
  @@map("stock_movements")
}

/// Site expenses and petty cash (spec Â§3 item 9, Â§7).
///
/// `spentOn` is the day the money left, which is not the day it was entered â€” a
/// supervisor photographs a bill on Tuesday for a Saturday purchase, and the cost
/// belongs to Saturday. Reports group on `spentOn` for that reason.
model Expense {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  /// Paise. Never a float (ADR 0003).
  amount        BigInt
  category      String
  spentOn       DateTime      @map("spent_on") @db.Date
  billS3Key     String?       @map("bill_s3_key")
  /// VAT or GST included in `amount` (roadmap Phase 1, item 5): the input tax a company can
  /// reclaim. Zero when the bill showed none or nobody entered it.
  taxAmount     BigInt        @default(0) @map("tax_amount")
  /// The supplier's tax registration number, checked against the company's regime.
  supplierTaxId String?       @map("supplier_tax_id")
  /// The line of the site's work breakdown this spend is booked to (roadmap Phase 2, module 1).
  /// Null is "unallocated": the budget report shows it as its own line rather than losing it.
  costCodeId    String?       @map("cost_code_id") @db.Uuid
  note          String?
  status        ExpenseStatus @default(pending)
  submittedBy   String        @map("submitted_by") @db.Uuid
  approvedBy    String?       @map("approved_by") @db.Uuid
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(6)
  /// Device-generated id when recorded offline; the sync idempotency key.
  clientId      String?       @map("client_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitter User      @relation("expense_submitted_by", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver  User?     @relation("expense_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)
  costCode  CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  subcontractDeductions SubcontractDeduction[]
  purchaseInvoiceLines  PurchaseInvoiceLine[]

  equipmentFuel         EquipmentFuel[]
  equipmentMaintenance  EquipmentMaintenance[]
  equipmentHireBookings EquipmentHireBooking[]

  @@unique([tenantId, clientId], map: "expenses_tenant_id_client_id_key")
  @@index([tenantId, status])
  @@index([tenantId, spentOn])
  @@index([projectId, spentOn])
  @@index([tenantId, updatedAt])
  @@index([costCodeId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notifications, sync, audit
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json      @db.JsonB
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Append-only record of what each device pushed, including conflicts, so a
/// supervisor's "but I entered it" can be answered (spec Â§8).
model SyncLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  deviceId String   @map("device_id")
  entity   String
  entityId String?  @map("entity_id") @db.Uuid
  clientId String?  @map("client_id") @db.Uuid
  op       SyncOp
  status   String
  detail   Json?    @db.JsonB
  serverTs DateTime @default(now()) @map("server_ts") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, serverTs])
  @@index([tenantId, entity, serverTs])
  @@map("sync_log")
}

/// Phone â†’ (tenant, user) directory. Deliberately has NO row-level security and no
/// foreign keys: `/auth/exchange` has to resolve a phone to a tenant *before* any
/// tenant context exists, and that is the only lookup allowed to run untenanted.
/// Maintained by the `users_sync_auth_identity` trigger â€” never written from
/// application code.
model AuthIdentity {
  userId   String  @id @map("user_id") @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  phone    String
  /// Mirrors `users.email`. What a Google sign-in is looked up by, before any tenant is known.
  email    String?
  // The email index and its per-tenant unique are partial — `WHERE email IS NOT NULL`, so the
  // rows without one cost nothing and do not collide with each other. Prisma cannot express a
  // partial index, so both live in the migration SQL and are deliberately absent here.

  @@unique([phone, tenantId], map: "auth_identities_phone_tenant_id_key")
  @@index([phone])
  @@map("auth_identities")
}

/// Audit trail for approvals and money movements (spec Â§15).
enum BillingStatus {
  none
  trialing
  active
  past_due
  cancelled

  @@map("billing_status")
}

/// One tenant's subscription (spec Â§3 item 12).
///
/// The Razorpay subscription is the authority on what is being charged; this row is the local
/// projection of it, updated only from a signature-verified webhook or an explicit fetch. Nothing
/// a browser sends ever sets `status` or `plan` here.
model Subscription {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @unique @map("tenant_id") @db.Uuid
  plan                   String
  status                 BillingStatus @default(none)
  razorpaySubscriptionId String?       @unique @map("razorpay_subscription_id")
  razorpayPlanId         String?       @map("razorpay_plan_id")
  /// razorpay | stripe. Rupees go through Razorpay, every other currency through Stripe.
  provider               String        @default("razorpay")
  currency               String        @default("INR")
  stripeSessionId        String?       @unique @map("stripe_session_id")
  stripeSubscriptionId   String?       @unique @map("stripe_subscription_id")
  /// Paise per cycle, copied at subscribe time so a later price change cannot rewrite history.
  amount                 BigInt        @default(0)
  /// Access runs to here. A past-due tenant keeps working until it passes.
  currentPeriodEnd       DateTime?     @map("current_period_end") @db.Timestamptz(6)
  /// Set when cancellation was requested but the paid period has not run out yet.
  cancelAt               DateTime?     @map("cancel_at") @db.Timestamptz(6)
  cancelledAt            DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  /// Why the last charge failed, for the banner the owner sees.
  lastFailureReason      String?       @map("last_failure_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([status])
  @@map("subscriptions")
}

/// Which tenant a Razorpay subscription belongs to. One of the few tables with no RLS.
///
/// A webhook arrives with no tenant context â€” it is authenticated by signature, and the tenant has to
/// be worked out before any tenant-scoped query can run. `subscriptions` is RLS protected, so reading
/// it without that context returns nothing, which is correct and useless here.
///
/// So this directory holds the mapping and nothing else: a Razorpay id and a tenant id. Exactly the
/// reasoning behind `auth_identities`, which exists so `/auth/exchange` can find a tenant from a phone
/// number. Kept in step by a trigger so application code never writes it and cannot let it drift.
model BillingIdentity {
  razorpaySubscriptionId String   @id @map("razorpay_subscription_id")
  tenantId               String   @map("tenant_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("billing_identities")
}

/// A charge Razorpay raised, successful or not.
///
/// Kept locally so an owner can see what they have been billed without this app needing to call
/// Razorpay to render a page, and so the history survives a subscription being cancelled.
model Invoice {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  razorpayInvoiceId String?   @unique @map("razorpay_invoice_id")
  stripeInvoiceId   String?   @unique @map("stripe_invoice_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  amount            BigInt
  /// `paid`, `issued`, `failed` â€” Razorpay's own words, not translated.
  status            String
  /// Razorpay's hosted invoice, for the owner who needs it for their accountant.
  invoiceUrl        String?   @map("invoice_url")
  issuedAt          DateTime? @map("issued_at") @db.Timestamptz(6)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt(sort: Desc)])
  @@map("invoices")
}

/// Every webhook Razorpay has delivered, by its own event id.
///
/// Razorpay retries until it gets a 2xx, so the same event arrives more than once as a matter of
/// course. Without this table a retried `subscription.charged` would raise a second invoice and
/// extend the period twice. No tenant_id and no RLS: the webhook is verified by signature before any
/// tenant is known, so there is no tenant context in which to read it.
model WebhookEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Razorpay's `x-razorpay-event-id` header. Unique, which is what makes replay a no-op.
  eventId   String    @unique @map("event_id")
  eventType String    @map("event_type")
  payload   Json
  /// Null until handled, so a crash mid-processing leaves a row to retry rather than a silent gap.
  handledAt DateTime? @map("handled_at") @db.Timestamptz(6)
  error     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt(sort: Desc)])
  @@map("webhook_events")
}

/// Platform console actions, outside every tenant.
///
/// Its own table rather than rows in `audit_log`: that table is tenant-scoped and RLS
/// protected, and an owner reading their own audit trail should not see the platform
/// operator's notes about them. This one has no tenant_id and no policy, and is only
/// ever written through the BYPASSRLS connection.
model PlatformAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The operator's phone in stored form. Not a user id: platform admins are an env
  /// allowlist, not rows in `users`.
  actorPhone String   @map("actor_phone")
  action     String
  /// Which tenant was acted on, when the action was about one.
  tenantId   String?  @map("tenant_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("platform_audit_log")
}

/// An operator the console itself granted access to.
///
/// `PLATFORM_ADMIN_PHONES` stays the root of trust and is unaffected by this table: those
/// numbers are always allowed in, can never be revoked from inside the console, and are the
/// only ones permitted to grant access to anybody else. This table exists so that adding a
/// second support person is not a redeploy — not so that the console can rewrite who owns it.
///
/// No `tenant_id` and no RLS, like `platform_audit_log`: it is read before any tenant context
/// exists, by the BYPASSRLS connection the console uses for everything.
model PlatformOperator {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored form, `91XXXXXXXXXX`, matching how a verified phone arrives from Firebase.
  phone     String    @unique
  name      String?
  /// A Google address this operator may also sign in with.
  ///
  /// An alternative key to the same person, never a second identity: a sign-in by address is
  /// resolved to this row's `phone` before a token is issued, so the audit trail stays phone-keyed
  /// and a Google login and an SMS login by the same operator are indistinguishable in it.
  ///
  /// Nullable, because most operators never link one, and unique where present so one address can
  /// never open two operator accounts.
  email     String?   @unique
  /// The root operator who granted this. Kept as a phone, not a foreign key, because the
  /// grantor is usually an env entry with no row here at all.
  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Revoked rather than deleted, so the trail of who had access when survives.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by")

  @@index([revokedAt])
  @@map("platform_operators")
}

/// Every create, update and delete on tenant data, plus the business events services name by hand.
///
/// Two writers, one table:
///   * `audit_row_change()` — a Postgres trigger attached to each tenant table with
///     `SELECT audit_attach('<table>')`. It writes `create` / `update` / `delete` rows with the
///     changed fields, and cannot be forgotten by a new service or bypassed by a raw query.
///   * Services, for events a row change cannot express: an approval decision, a reveal of an
///     encrypted document number (a read), a wage period being finalised. Those keep their dotted
///     action names (`expense.approved`), and were the whole of this table before.
///
/// Who did it, the request id, IP and user agent are filled in by a BEFORE INSERT trigger from the
/// transaction-local settings `TenantDb` sets beside `app.tenant_id` — so neither writer passes them.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// The user who acted. Deliberately not a foreign key: an audit row must keep naming its actor
  /// after that person is removed, and must never be rewritten by an ON DELETE SET NULL.
  actorId       String?  @map("actor_id") @db.Uuid
  /// user | system (a scheduled job or webhook) | platform (the support console).
  actorType     String   @default("system") @map("actor_type")
  action        String
  entity        String
  entityId      String?  @map("entity_id") @db.Uuid
  /// The row's name or title at the time, so a deleted worker still reads as "Ravi" in the log.
  entityLabel   String?  @map("entity_label")
  /// For an update, which columns changed; empty for create and delete.
  changedFields String[] @default([]) @map("changed_fields")
  before        Json?    @db.JsonB
  after         Json?    @db.JsonB
  requestId     String?  @map("request_id")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
  @@map("audit_logs")
}

/// Who a message in the site conversation is for.
enum MessageAudience {
  /// The client sees it. This is what the portal is for.
  everyone

  /// The team only. A supervisor's note about a client is a normal part of running a job, and a
  /// portal with nowhere to put it sends those conversations back to WhatsApp.
  team

  /// One named person, and nobody else â€” whichever side of the client/team line they are on. The
  /// row carries a `recipientId`, and the database enforces that it always does.
  direct

  @@map("message_audience")
}

/// One message in a site's conversation.
///
/// Soft deleted, like everything else that is a record of something somebody said. A client asking
/// a question and a builder answering it is evidence about the job, and "who agreed to the granite"
/// is exactly the question this exists to answer six months later.
model SiteMessage {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  authorId    String          @map("author_id") @db.Uuid
  /// Set only for `direct`, and always set for it â€” the database holds both halves of that.
  recipientId String?         @map("recipient_id") @db.Uuid
  body        String
  audience    MessageAudience @default(everyone)
  /// Idempotency for a phone that sent and lost the answer.
  clientId    String?         @map("client_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User                    @relation("message_author", fields: [authorId], references: [id], onDelete: Restrict)
  recipient   User?                   @relation("message_recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  attachments SiteMessageAttachment[]

  @@unique([tenantId, clientId], map: "site_messages_tenant_id_client_id_key")
  @@index([projectId, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("site_messages")
}

/// A photo or file hanging off a message. Half of what a client asks is "is this right?" about
/// something they can point at.
model SiteMessageAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  messageId   String   @map("message_id") @db.Uuid
  s3Key       String   @map("s3_key")
  thumbS3Key  String?  @map("thumb_s3_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  /// What the file was called. Null for a photograph, where the picture is the name.
  filename    String?
  caption     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message SiteMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("site_message_attachments")
}

/// How far one person has read one site's conversation.
///
/// A watermark rather than a row per message: "seen" is a question about a point in time, and
/// storing it that way means the table is the size of the team rather than the size of the thread.
model SiteMessageRead {
  tenantId   String   @map("tenant_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @default(now()) @map("last_read_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([tenantId, userId])
  @@map("site_message_reads")
}

enum DocumentCategory {
  drawing
  contract
  approval
  permit
  invoice
  other

  @@map("document_category")
}

/// A drawing, contract or approval, with its revisions.
///
/// Revisions share a `familyId` and count up. The point is the client: somebody looking at revision
/// 3 of a slab drawing must not be able to reach revision 1 by accident, and the builder must be
/// able to prove which one was current when the slab was poured.
///
/// `visibleToClient` defaults to false everywhere â€” schema, API and UI. A contract or an internal
/// costing becoming visible because somebody forgot to untick a box is not a mistake you can take
/// back.
model Document {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  /// Null for something that belongs to the company rather than one job.
  projectId       String?          @map("project_id") @db.Uuid
  /// Groups every revision of the same document.
  familyId        String           @map("family_id") @db.Uuid
  version         Int              @default(1)
  title           String
  category        DocumentCategory @default(other)
  s3Key           String           @map("s3_key")
  contentType     String           @map("content_type")
  sizeBytes       Int              @map("size_bytes")
  visibleToClient Boolean          @default(false) @map("visible_to_client")
  uploadedBy      String           @map("uploaded_by") @db.Uuid
  clientId        String?          @map("client_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  /// When its text was last read out for searching. Null means nobody has tried yet.
  textExtractedAt DateTime?        @map("text_extracted_at") @db.Timestamptz(6)
  /// Pages that yielded readable text. Zero after a successful read means a scan, not a failure.
  textPages       Int?             @map("text_pages")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User            @relation("document_uploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  Approval Approval[]
  chunks   DocumentChunk[]

  subcontractLinks SubcontractDocument[]
  changeOrderLinks ChangeOrderAttachment[]

  rfiLinks       RfiDocument[]
  rfiAttachments RfiAttachment[]
  submittalFiles SubmittalFile[]

  @@unique([tenantId, clientId], map: "documents_tenant_id_client_id_key")
  @@unique([familyId, version], map: "documents_family_id_version_key")
  @@index([tenantId, projectId, createdAt(sort: Desc)])
  @@map("documents")
}

/// One readable piece of one document, so a question can be answered with a page number.
///
/// The full-text index over `content` is a GIN expression index created in the migration — Prisma's
/// datamodel cannot express one, and leaving it out here keeps the drift check honest.
model DocumentChunk {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  /// 1-based, as a PDF viewer counts them, so a citation can be followed by hand.
  page       Int
  /// Which piece of that page, for pages long enough to split.
  ordinal    Int      @default(0)
  content    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, page, ordinal], map: "document_chunks_document_id_page_ordinal_key")
  @@index([tenantId, documentId])
  @@map("document_chunks")
}

// ---------------------------------------------------------------------------
// Client billing â€” money coming in
// ---------------------------------------------------------------------------
//
// Deliberately not the same tables as `expenses` and `labour_payments`, which are money going out.
// The difference between the two is the margin on the job, and a client must never be able to reach
// the outgoing side. Two tables keep that a structural fact rather than a `WHERE` clause somebody
// has to remember.

/// One instalment of what the client owes.
model PaymentStage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  /// "On completion of the slab" is a milestone; "On signing" is not.
  milestoneId String?   @map("milestone_id") @db.Uuid
  label       String
  /// Paise.
  amount      BigInt
  /// VAT charged on top of `amount` (roadmap Phase 1, item 5); the client owes both.
  taxAmount   BigInt    @default(0) @map("tax_amount")
  dueDate     DateTime? @map("due_date") @db.Date
  sortOrder   Int       @default(0) @map("sort_order")
  /// When the builder actually asked for it. Upcoming, due and paid are derived from this and the
  /// receipts, so no status column can drift out of step with the money.
  raisedAt    DateTime? @map("raised_at") @db.Timestamptz(6)
  clientId    String?   @map("client_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  receipts  ClientPayment[]

  /// Set when this instalment is a BOQ running bill raised to the client (Phase 2, module 5).
  boqBill BoqBill?

  @@unique([tenantId, clientId], map: "payment_stages_tenant_id_client_id_key")
  @@index([projectId, sortOrder])
  @@map("payment_stages")
}

/// Money that actually arrived from the client.
model ClientPayment {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  projectId  String      @map("project_id") @db.Uuid
  /// Null for a round sum somebody reconciles later. It still counts against the total.
  stageId    String?     @map("stage_id") @db.Uuid
  amount     BigInt
  receivedOn DateTime    @map("received_on") @db.Date
  mode       PaymentMode @default(bank)
  reference  String?
  note       String?
  recordedBy String      @map("recorded_by") @db.Uuid
  clientId   String?     @map("client_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    PaymentStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  recorder User          @relation("client_payment_recorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientId], map: "client_payments_tenant_id_client_id_key")
  @@index([projectId, receivedOn(sort: Desc)])
  @@index([stageId])
  @@map("client_payments")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@map("approval_status")
}

/// Something the client has been asked to sign off â€” a drawing, a selection, a variation.
///
/// The decision names whoever gave it. That is the whole value of the row: six months later the
/// argument is whether the client ever agreed to the granite, and an approval with nobody's name on
/// it settles nothing. The database enforces that a decided row carries all three of status,
/// decider and time, or none of them.
model Approval {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  /// Usually the drawing or quote in question, referenced so it always points at the revision that
  /// was current when the question was asked.
  documentId   String?        @map("document_id") @db.Uuid
  title        String
  body         String         @default("")
  status       ApprovalStatus @default(pending)
  requestedBy  String         @map("requested_by") @db.Uuid
  decidedBy    String?        @map("decided_by") @db.Uuid
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote String?        @map("decision_note")
  clientId     String?        @map("client_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  requester User      @relation("approval_requester", fields: [requestedBy], references: [id], onDelete: Restrict)
  decider   User?     @relation("approval_decider", fields: [decidedBy], references: [id], onDelete: Restrict)

  /// Set when the question is a change order: the client's answer here is what applies it.
  changeOrder ChangeOrder?

  /// Set when the question is a submittal the client reviews.
  submittalRevision SubmittalRevision?

  @@unique([tenantId, clientId], map: "approvals_tenant_id_client_id_key")
  @@index([projectId, status, createdAt(sort: Desc)])
  @@map("approvals")
}

/// One forecast per site per day (roadmap: AI agent 2, overrun early warning).
///
/// Written nightly on the company's clock and on demand. Kept per day rather than overwritten so
/// "it was fine last week" can be checked, and so a warning an owner acted on can be found again.
/// Figures are minor units in the company's currency, like every other amount.
model SiteForecast {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  asOf        DateTime @map("as_of") @db.Date
  /// progress | burn_rate | spend_only
  method      String
  spent       BigInt
  budget      BigInt?
  forecast    BigInt?
  overrunPct  Int?     @map("overrun_pct")
  progressPct Int?     @map("progress_pct")
  elapsedPct  Int?     @map("elapsed_pct")
  /// ok | watch | warning | critical
  severity    String
  /// ForecastDriver[] from @sitebook/shared, amounts as strings.
  drivers     Json
  explanation String
  /// template | ai — whether a language model reworded the explanation.
  explainedBy String   @map("explained_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, asOf])
  @@index([tenantId, asOf])
  @@map("site_forecasts")
}

/// A leak or fraud finding for a person to confirm or dismiss (roadmap: AI agent 3).
///
/// Unique on kind + subject so a finding is raised once and a dismissal sticks: the nightly run
/// inserts what is new and never reopens what somebody has already decided.
model SiteCheck {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  /// double_booked | never_off | headcount_gap | duplicate_expense | unusual_expense | unidentified_paid
  kind       String
  subjectKey String    @map("subject_key")
  /// high | medium
  severity   String
  title      String
  details    Json
  /// open | confirmed | dismissed
  status     String    @default("open")
  decidedBy  String?   @map("decided_by") @db.Uuid
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz(6)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, subjectKey])
  @@index([tenantId, status])
  @@map("site_checks")
}

/// A worker's passport, visa, Emirates ID, Iqama or labour card (roadmap Phase 1, item 3).
///
/// The number is encrypted by the API (AES-256-GCM, DOCUMENT_ENCRYPTION_KEY) and stored only as
/// ciphertext; `numberHint` keeps its last four characters so a list can tell two papers apart.
/// The expiry date is the point of the table: a lapsed residence visa is a fine for the employer.
model WorkerDocument {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  workerId     String    @map("worker_id") @db.Uuid
  /// One of WORKER_DOCUMENT_KINDS in @sitebook/shared.
  kind         String
  numberCipher String    @map("number_cipher")
  numberHint   String    @map("number_hint")
  issuedOn     DateTime? @map("issued_on") @db.Date
  expiresOn    DateTime? @map("expires_on") @db.Date
  s3Key        String?   @map("s3_key")
  /// When the owners were told it is about to lapse, so they are told once, not every morning.
  remindedAt   DateTime? @map("reminded_at") @db.Timestamptz(6)
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([workerId])
  @@map("worker_documents")
}

/// A labour camp, and the bus that serves it (roadmap Phase 1, item 4).
model Camp {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  address       String?
  capacity      Int?
  transportNote String?   @map("transport_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residents Worker[]

  @@index([tenantId])
  @@map("camps")
}

/// Which tenant a Stripe subscription belongs to — the Stripe twin of BillingIdentity, and like it
/// one of the few tables with no RLS: a webhook arrives with no tenant context, and the nightly
/// lapse sweep needs the list of subscribed tenants without reading across them.
model StripeIdentity {
  stripeSubscriptionId String   @id @map("stripe_subscription_id")
  tenantId             String   @map("tenant_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stripe_identities")
}

/// One line of a site's work breakdown structure, and its budget (roadmap Phase 2, module 1).
///
/// The thing every later module posts against: expenses now, purchase orders and subcontracts
/// next. A tree through `parentId`; a parent may carry a budget of its own as well as its
/// children's. Hard-deleted, and only when nothing is posted to it and it has no children —
/// a code with history is renamed, not removed.
model CostCode {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  /// `03.20` — unique within the site.
  code          String
  name          String
  /// What the line is measured in, when it is measured: m3, m2, kg, nos.
  unit          String?
  /// Minor units, like every other amount.
  budget        BigInt   @default(0)
  /// Labour on the site lands on this line unless it is booked elsewhere. At most one per site.
  labourDefault Boolean  @default(false) @map("labour_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   CostCode?  @relation("cost_code_tree", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCode[] @relation("cost_code_tree")
  expenses Expense[]

  subcontractLines      SubcontractLine[]
  subcontractDeductions SubcontractDeduction[]
  rfqItems              PurchaseRfqItem[]
  orderLines            PurchaseOrderLine[]
  qualityInspections    QualityInspection[]
  qualityTests          QualityTest[]
  snags                 Snag[]

  changeOrderLines           ChangeOrderLine[]
  changeOrderBudgetRevisions ChangeOrderBudgetRevision[]
  scheduleTasks              ScheduleTask[]

  boqItems BoqItem[]

  submittals Submittal[]

  equipmentAllocations EquipmentAllocation[]
  equipmentLogs        EquipmentLog[]
  equipmentFuel        EquipmentFuel[]
  equipmentMaintenance EquipmentMaintenance[]

  @@unique([projectId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("cost_codes")
}

/// A company's own work breakdown template, copied into a site to start its cost codes.
///
/// The built-in standard template is code (`STANDARD_WBS` in @sitebook/shared), not rows: every
/// company gets it without a migration writing into every tenant, and it can be improved later
/// without touching anybody's copy.
model CostCodeTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  CostCodeTemplateItem[]

  @@index([tenantId])
  @@map("cost_code_templates")
}

/// A line of a template. The tree is by code (`parentCode`), because a template is copied by code
/// and edited as a list — there are no ids anything else points at.
model CostCodeTemplateItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  code       String
  name       String
  parentCode String? @map("parent_code")
  unit       String?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template CostCodeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([tenantId])
  @@map("cost_code_template_items")
}

// ---------------------------------------------------------------------------
// Subcontracts and progress (RA) billing (roadmap Phase 2, module 3)
// ---------------------------------------------------------------------------
//
// The subcontractor is a `Contractor`: the same party a labour gang is paid through, so one firm
// that supplies a gang on one site and plasters another on a lump sum is one name with one history.
//
// People are stored as bare ids (`submitted_by`, `certified_by`, ...) rather than relations to
// `User`: the audit log already records who wrote each row, and leaving `User` alone keeps this
// module out of a model every other module also extends.

enum SubcontractStatus {
  draft
  active
  completed
  closed
  terminated

  @@map("subcontract_status")
}

enum RaBillStatus {
  draft
  submitted
  certified
  paid

  @@map("ra_bill_status")
}

enum SubcontractDeductionKind {
  material
  labour
  damage
  penalty
  other

  @@map("subcontract_deduction_kind")
}

enum SubcontractPaymentKind {
  advance
  bill
  retention

  @@map("subcontract_payment_kind")
}

/// A subcontract: a scope of work on one site, let to one contractor, priced line by line.
///
/// The contract value is not a column — it is the sum of the original lines, plus approved
/// variations. A stored total would be one more figure that can disagree with the schedule it
/// claims to add up.
model Subcontract {
  id                             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                       String            @map("tenant_id") @db.Uuid
  projectId                      String            @map("project_id") @db.Uuid
  contractorId                   String            @map("contractor_id") @db.Uuid
  /// `SC-007`, unique within the company.
  number                         String
  title                          String
  scope                          String?
  startDate                      DateTime?         @map("start_date") @db.Date
  endDate                        DateTime?         @map("end_date") @db.Date
  /// Basis points held back from every bill: 500 = 5%.
  retentionBp                    Int               @default(0) @map("retention_bp")
  /// The share of retention due back at completion; the rest after the defects period.
  retentionReleaseAtCompletionBp Int               @default(5000) @map("retention_release_at_completion_bp")
  defectsLiabilityMonths         Int               @default(12) @map("defects_liability_months")
  /// Mobilisation advance agreed. What was actually paid is the `advance` payments.
  advanceAmount                  BigInt            @default(0) @map("advance_amount")
  advanceRecoveryBp              Int               @default(0) @map("advance_recovery_bp")
  /// The subcontractor's GST or VAT on their bills, basis points.
  taxRateBp                      Int               @default(0) @map("tax_rate_bp")
  paymentTerms                   String?           @map("payment_terms")
  status                         SubcontractStatus @default(draft)
  completedOn                    DateTime?         @map("completed_on") @db.Date
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: NoAction)

  lines      SubcontractLine[]
  variations SubcontractVariation[]
  bills      SubcontractBill[]
  releases   SubcontractRetentionRelease[]
  payments   SubcontractPayment[]
  documents  SubcontractDocument[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([contractorId])
  @@map("subcontracts")
}

/// A line of the schedule of rates. Lines with a `variationId` came from a variation and count
/// towards the contract only once it is approved.
model SubcontractLine {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  subcontractId String   @map("subcontract_id") @db.Uuid
  variationId   String?  @map("variation_id") @db.Uuid
  /// Refused (no action), not SetNull: un-coding a subcontract line would silently move its commitment and
  /// its certified cost to "Unallocated".
  costCodeId    String?  @map("cost_code_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  itemCode      String?  @map("item_code")
  description   String
  unit          String
  quantity      Decimal  @db.Decimal(14, 3)
  /// Minor units per unit.
  rate          BigInt
  /// `quantity × rate`, rounded to the minor unit once, here.
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract           @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  variation   SubcontractVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  costCode    CostCode?             @relation(fields: [costCodeId], references: [id], onDelete: NoAction)
  billLines   SubcontractBillLine[]

  @@index([tenantId])
  @@index([subcontractId, sortOrder])
  @@index([costCodeId])
  @@map("subcontract_lines")
}

/// Extra work (or a changed scope) on a running subcontract. Pending until somebody with
/// `subcontracts.certify` decides; the decision names them.
model SubcontractVariation {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  subcontractId String         @map("subcontract_id") @db.Uuid
  number        Int
  title         String
  reason        String?
  status        ApprovalStatus @default(pending)
  requestedBy   String         @map("requested_by") @db.Uuid
  decidedBy     String?        @map("decided_by") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?        @map("decision_note")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract       @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  lines       SubcontractLine[]

  @@unique([subcontractId, number])
  @@index([tenantId])
  @@map("subcontract_variations")
}

/// A running-account (RA) bill. The money columns are the bill's figures from `computeRaBill` —
/// kept up to date while it is a draft, and frozen at certification, so a certified bill always
/// prints what was certified.
model SubcontractBill {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String       @map("tenant_id") @db.Uuid
  subcontractId          String       @map("subcontract_id") @db.Uuid
  /// RA-1, RA-2 … within the subcontract.
  number                 Int
  periodFrom             DateTime?    @map("period_from") @db.Date
  periodTo               DateTime     @map("period_to") @db.Date
  billDate               DateTime     @map("bill_date") @db.Date
  status                 RaBillStatus @default(draft)
  grossToDate            BigInt       @default(0) @map("gross_to_date")
  previousGross          BigInt       @default(0) @map("previous_gross")
  gross                  BigInt       @default(0)
  retentionToDate        BigInt       @default(0) @map("retention_to_date")
  retention              BigInt       @default(0)
  advanceRecoveredToDate BigInt       @default(0) @map("advance_recovered_to_date")
  advanceRecovery        BigInt       @default(0) @map("advance_recovery")
  deductions             BigInt       @default(0)
  taxRateBp              Int          @default(0) @map("tax_rate_bp")
  tax                    BigInt       @default(0)
  netPayable             BigInt       @default(0) @map("net_payable")
  note                   String?
  createdBy              String       @map("created_by") @db.Uuid
  submittedBy            String?      @map("submitted_by") @db.Uuid
  submittedAt            DateTime?    @map("submitted_at") @db.Timestamptz(6)
  certifiedBy            String?      @map("certified_by") @db.Uuid
  certifiedAt            DateTime?    @map("certified_at") @db.Timestamptz(6)
  certificationNote      String?      @map("certification_note")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract   Subcontract            @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  lines         SubcontractBillLine[]
  deductionRows SubcontractDeduction[]
  payments      SubcontractPayment[]

  @@unique([subcontractId, number])
  @@index([tenantId, status])
  @@map("subcontract_bills")
}

/// Work done to date on one line, as claimed and — once certified — as certified.
model SubcontractBillLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  billId            String   @map("bill_id") @db.Uuid
  lineId            String   @map("line_id") @db.Uuid
  claimedQuantity   Decimal  @map("claimed_quantity") @db.Decimal(14, 3)
  certifiedQuantity Decimal? @map("certified_quantity") @db.Decimal(14, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  line   SubcontractLine @relation(fields: [lineId], references: [id], onDelete: NoAction)

  @@unique([billId, lineId])
  @@index([tenantId])
  @@index([lineId])
  @@map("subcontract_bill_lines")
}

/// A back-charge on a bill: material or labour we supplied, damage, a penalty.
model SubcontractDeduction {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  billId          String                   @map("bill_id") @db.Uuid
  kind            SubcontractDeductionKind
  description     String
  amount          BigInt
  /// Where the recovery is booked: the cost it gives back belongs to the line that bore it.
  costCodeId      String?                  @map("cost_code_id") @db.Uuid
  expenseId       String?                  @map("expense_id") @db.Uuid
  stockMovementId String?                  @map("stock_movement_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill          SubcontractBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  costCode      CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: NoAction)
  expense       Expense?        @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  stockMovement StockMovement?  @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([billId])
  @@index([costCodeId])
  @@map("subcontract_deductions")
}

/// Retention handed back — at completion, after the defects period, or early by agreement. Once
/// released it is owed, and paid through a `retention` payment.
model SubcontractRetentionRelease {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  subcontractId String   @map("subcontract_id") @db.Uuid
  amount        BigInt
  releasedOn    DateTime @map("released_on") @db.Date
  note          String?
  approvedBy    String   @map("approved_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract          @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  payments    SubcontractPayment[]

  @@index([tenantId])
  @@index([subcontractId])
  @@map("subcontract_retention_releases")
}

/// Money paid to a subcontractor: the advance, a certified bill, or released retention.
model SubcontractPayment {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  subcontractId      String                 @map("subcontract_id") @db.Uuid
  kind               SubcontractPaymentKind
  billId             String?                @map("bill_id") @db.Uuid
  retentionReleaseId String?                @map("retention_release_id") @db.Uuid
  amount             BigInt
  paidOn             DateTime               @map("paid_on") @db.Date
  mode               PaymentMode            @default(bank)
  reference          String?
  note               String?
  recordedBy         String                 @map("recorded_by") @db.Uuid
  clientId           String?                @map("client_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract      Subcontract                  @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  bill             SubcontractBill?             @relation(fields: [billId], references: [id], onDelete: NoAction)
  retentionRelease SubcontractRetentionRelease? @relation(fields: [retentionReleaseId], references: [id], onDelete: NoAction)

  @@unique([tenantId, clientId], map: "subcontract_payments_tenant_id_client_id_key")
  @@index([tenantId])
  @@index([subcontractId, paidOn])
  @@index([billId])
  @@map("subcontract_payments")
}

/// The signed subcontract, its drawings, the subcontractor's insurance — documents uploaded through
/// the documents library and linked here, so a revision there is the revision here.
model SubcontractDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  subcontractId String   @map("subcontract_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontract Subcontract @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([subcontractId, documentId])
  @@index([tenantId])
  @@map("subcontract_documents")
}

// ---------------------------------------------------------------------------
// Procurement (roadmap Phase 2, module 2)
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  draft
  pending_approval
  approved
  sent
  partially_received
  received
  closed
  cancelled

  @@map("purchase_order_status")
}

enum RfqStatus {
  open
  awarded
  cancelled

  @@map("rfq_status")
}

enum PurchaseInvoiceStatus {
  matched
  mismatch
  approved
  rejected

  @@map("purchase_invoice_status")
}

/// A supplier of materials. Not a `Contractor`: a contractor supplies labour and is paid through
/// wage periods; a vendor supplies goods against purchase orders and is paid on invoices.
/// Never hard-deleted once anything was ordered from it — it is made inactive instead.
model Vendor {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  contactName      String?  @map("contact_name")
  /// E.164 without the plus, like every phone in the product.
  phone            String?
  email            String?
  address          String?
  /// GSTIN, TRN or VAT number, normalised and checked against the company's regime.
  taxId            String?  @map("tax_id")
  /// Days after the invoice date the supplier expects payment.
  paymentTermsDays Int?     @map("payment_terms_days")
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes         PurchaseQuote[]
  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]

  submittals Submittal[]

  equipment             Equipment[]
  equipmentHireBookings EquipmentHireBooking[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("vendors")
}

/// The most a role or a person may approve on one purchase order (company setting). Exactly one of
/// `roleId` and `userId`; a person's own row wins over their role's. `maxAmount` null is unlimited.
/// Anybody no row covers may approve nothing — owners are always unlimited.
model PurchaseApprovalLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String?  @map("role_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  maxAmount BigInt?  @map("max_amount")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId])
  @@unique([tenantId, userId])
  @@map("purchase_approval_limits")
}

/// A request for quotation: what a site needs, sent to several suppliers to price.
model PurchaseRfq {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  /// `RFQ-0001`, per company.
  number         String
  title          String
  notes          String?
  status         RfqStatus @default(open)
  indentId       String?   @map("indent_id") @db.Uuid
  requiredBy     DateTime? @map("required_by") @db.Date
  createdBy      String    @map("created_by") @db.Uuid
  /// The quote that won. Not a foreign key: the quote belongs to this RFQ and goes with it.
  awardedQuoteId String?   @map("awarded_quote_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  indent         MaterialIndent?   @relation(fields: [indentId], references: [id], onDelete: SetNull)
  creator        User              @relation("rfq_created_by", fields: [createdBy], references: [id], onDelete: Restrict)
  items          PurchaseRfqItem[]
  quotes         PurchaseQuote[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([projectId])
  @@map("purchase_rfqs")
}

model PurchaseRfqItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  rfqId       String  @map("rfq_id") @db.Uuid
  materialId  String? @map("material_id") @db.Uuid
  description String
  unit        String
  quantity    Decimal @db.Decimal(14, 3)
  costCodeId  String? @map("cost_code_id") @db.Uuid
  position    Int     @default(0)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq        PurchaseRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  material   Material?           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  costCode   CostCode?           @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  quoteLines PurchaseQuoteLine[]

  @@index([rfqId])
  @@index([tenantId])
  @@map("purchase_rfq_items")
}

/// One supplier's answer to an RFQ. One per supplier per RFQ; entering it again replaces it.
model PurchaseQuote {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  rfqId        String    @map("rfq_id") @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  deliveryDays Int?      @map("delivery_days")
  validUntil   DateTime? @map("valid_until") @db.Date
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq    PurchaseRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines  PurchaseQuoteLine[]

  @@unique([rfqId, vendorId])
  @@index([tenantId])
  @@map("purchase_quotes")
}

model PurchaseQuoteLine {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  quoteId   String @map("quote_id") @db.Uuid
  rfqItemId String @map("rfq_item_id") @db.Uuid
  /// Minor units per unit, before tax.
  unitRate  BigInt @map("unit_rate")
  /// Basis points: 500 = 5%.
  taxRateBp Int    @map("tax_rate_bp")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote   PurchaseQuote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  rfqItem PurchaseRfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  @@unique([quoteId, rfqItemId])
  @@index([tenantId])
  @@map("purchase_quote_lines")
}

/// An order to a supplier. Totals are stored, added from the lines whenever they change, because
/// the approval limit is checked against them and a list of orders is sorted and summed by them.
model PurchaseOrder {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  projectId       String              @map("project_id") @db.Uuid
  vendorId        String              @map("vendor_id") @db.Uuid
  /// `PO-00001`, per company.
  number          String
  status          PurchaseOrderStatus @default(draft)
  rfqId           String?             @map("rfq_id") @db.Uuid
  indentId        String?             @map("indent_id") @db.Uuid
  notes           String?
  deliveryAddress String?             @map("delivery_address")
  expectedOn      DateTime?           @map("expected_on") @db.Date
  subtotal        BigInt              @default(0)
  taxTotal        BigInt              @default(0) @map("tax_total")
  total           BigInt              @default(0)
  createdBy       String              @map("created_by") @db.Uuid
  submittedAt     DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedBy      String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at") @db.Timestamptz(6)
  /// The approver's note, or why it was sent back.
  decisionNote    String?             @map("decision_note")
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(6)
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor   Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  rfq      PurchaseRfq?        @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  indent   MaterialIndent?     @relation(fields: [indentId], references: [id], onDelete: SetNull)
  creator  User                @relation("po_created_by", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User?               @relation("po_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([projectId, status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  /// From the catalogue where there is one: only those lines can be booked into stock.
  materialId       String? @map("material_id") @db.Uuid
  description      String
  unit             String
  quantity         Decimal @db.Decimal(14, 3)
  unitRate         BigInt  @map("unit_rate")
  taxRateBp        Int     @map("tax_rate_bp")
  /// quantity × unitRate, rounded; and the tax on it. Stored so the order prints what was agreed.
  amount           BigInt
  taxAmount        BigInt  @map("tax_amount")
  /// Restrict: a cost code with an order against it cannot be deleted out from under it.
  costCodeId       String? @map("cost_code_id") @db.Uuid
  /// Sum of goods received against this line; kept in step by the receipt that changes it.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)
  position         Int     @default(0)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material     Material?             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  costCode     CostCode?             @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  receiptLines GoodsReceiptLine[]
  invoiceLines PurchaseInvoiceLine[]

  @@index([purchaseOrderId])
  @@index([costCodeId])
  @@index([tenantId])
  @@map("purchase_order_lines")
}

/// A delivery signed for against an order (GRN). Each line books stock in on the site.
model GoodsReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  receivedOn      DateTime @map("received_on") @db.Date
  /// Delivery challan number.
  ref             String?
  note            String?
  receivedBy      String   @map("received_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  receiver User               @relation("grn_received_by", fields: [receivedBy], references: [id], onDelete: Restrict)
  lines    GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([tenantId, receivedOn])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  /// The stock ledger row this line wrote; null for a line with no catalogue material.
  stockMovementId     String? @unique @map("stock_movement_id") @db.Uuid

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt       GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine     PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  stockMovement StockMovement?    @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([purchaseOrderLineId])
  @@index([tenantId])
  @@map("goods_receipt_lines")
}

/// A supplier's invoice against an order, matched to the order and to what was received.
/// Approving it books the expense; until then the order's value stays committed.
model PurchaseInvoice {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  purchaseOrderId String                @map("purchase_order_id") @db.Uuid
  projectId       String                @map("project_id") @db.Uuid
  vendorId        String                @map("vendor_id") @db.Uuid
  invoiceNumber   String                @map("invoice_number")
  invoiceDate     DateTime              @map("invoice_date") @db.Date
  dueDate         DateTime?             @map("due_date") @db.Date
  subtotal        BigInt
  taxTotal        BigInt                @map("tax_total")
  total           BigInt
  attachmentS3Key String?               @map("attachment_s3_key")
  status          PurchaseInvoiceStatus
  /// What the three-way match found, as `MatchFlag[]`. Empty when it matched.
  flags           Json                  @default("[]") @db.JsonB
  /// The tolerance it was matched with, so a later change of setting does not rewrite history.
  toleranceBp     Int                   @map("tolerance_bp")
  note            String?
  recordedBy      String                @map("recorded_by") @db.Uuid
  approvedBy      String?               @map("approved_by") @db.Uuid
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz(6)
  decisionNote    String?               @map("decision_note")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor   Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  recorder User                  @relation("pinv_recorded_by", fields: [recordedBy], references: [id], onDelete: Restrict)
  approver User?                 @relation("pinv_approved_by", fields: [approvedBy], references: [id], onDelete: SetNull)
  lines    PurchaseInvoiceLine[]

  /// The same supplier invoice entered twice is how a bill gets paid twice.
  @@unique([vendorId, invoiceNumber])
  @@index([tenantId, status])
  @@index([purchaseOrderId])
  @@index([projectId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  invoiceId           String  @map("invoice_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)
  unitRate            BigInt  @map("unit_rate")
  amount              BigInt
  taxAmount           BigInt  @map("tax_amount")
  /// The expense this line was booked into when the invoice was approved (one per cost code).
  expenseId           String? @map("expense_id") @db.Uuid

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   PurchaseInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  expense   Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([purchaseOrderLineId])
  @@index([expenseId])
  @@index([tenantId])
  @@map("purchase_invoice_lines")
}

// ---------------------------------------------------------------------------
// Change orders (roadmap Phase 2, module 4)
// ---------------------------------------------------------------------------
//
// A variation to the client's contract: what the change costs the builder, what the client is
// charged for it, and how many days it adds. The client's yes goes through the existing portal
// `Approval`, and once given it moves the cost codes' budgets, the handover date and the contract
// value — each recorded as a revision row rather than an overwrite, so the original figures can
// always be read back.
//
// People are bare ids, as in subcontracts: the audit log already names whoever wrote each row, and
// leaving `User` alone keeps this module out of a model every other module also extends.

enum ChangeOrderStatus {
  draft
  submitted
  sent
  approved
  rejected
  implemented
  cancelled

  @@map("change_order_status")
}

enum ChangeOrderReason {
  client_request
  design_change
  site_condition
  error_omission

  @@map("change_order_reason")
}

enum ChangeOrderSuggestionStatus {
  open
  dismissed
  converted

  @@map("change_order_suggestion_status")
}

enum ChangeOrderSourceKind {
  daily_report
  site_message

  @@map("change_order_source_kind")
}

model ChangeOrder {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  /// CO-001 is 1. Numbered per site; a revision keeps its number and counts `revision` up.
  number          Int
  revision        Int               @default(0)
  title           String
  description     String?
  reason          ChangeOrderReason
  status          ChangeOrderStatus @default(draft)
  raisedBy        String            @map("raised_by") @db.Uuid
  raisedOn        DateTime          @map("raised_on") @db.Date
  /// Markup on cost, basis points. Ignored when `enteredPrice` is set.
  markupBp        Int               @default(0) @map("markup_bp")
  /// A price agreed outright rather than cost plus markup.
  enteredPrice    BigInt?           @map("entered_price")
  taxRateBp       Int               @default(0) @map("tax_rate_bp")
  /// The stored figures, worked out by `changeOrderFigures` whenever the lines or pricing change.
  costImpact      BigInt            @default(0) @map("cost_impact")
  clientPrice     BigInt            @default(0) @map("client_price")
  taxAmount       BigInt            @default(0) @map("tax_amount")
  clientTotal     BigInt            @default(0) @map("client_total")
  timeImpactDays  Int               @default(0) @map("time_impact_days")
  submittedBy     String?           @map("submitted_by") @db.Uuid
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz(6)
  approvedBy      String?           @map("approved_by") @db.Uuid
  approvedAt      DateTime?         @map("approved_at") @db.Timestamptz(6)
  /// The approver's note — why it was returned, or anything said on approving it.
  reviewNote      String?           @map("review_note")
  sentAt          DateTime?         @map("sent_at") @db.Timestamptz(6)
  /// The portal approval the client answers. One per revision sent; the current one is linked.
  approvalId      String?           @unique @map("approval_id") @db.Uuid
  clientDecidedBy String?           @map("client_decided_by") @db.Uuid
  clientDecidedAt DateTime?         @map("client_decided_at") @db.Timestamptz(6)
  clientNote      String?           @map("client_note")
  /// When the budgets, handover and contract value were moved. Set once, on the client's yes.
  appliedAt       DateTime?         @map("applied_at") @db.Timestamptz(6)
  implementedBy   String?           @map("implemented_by") @db.Uuid
  implementedAt   DateTime?         @map("implemented_at") @db.Timestamptz(6)
  cancelledBy     String?           @map("cancelled_by") @db.Uuid
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason    String?           @map("cancel_reason")
  clientId        String?           @map("client_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approval        Approval?                   @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  lines           ChangeOrderLine[]
  attachments     ChangeOrderAttachment[]
  budgetRevisions ChangeOrderBudgetRevision[]
  siteRevision    ChangeOrderSiteRevision?
  suggestions     ChangeOrderSuggestion[]

  /// RFIs whose answer this change order was raised from.
  rfis Rfi[]

  @@unique([projectId, number])
  @@unique([tenantId, clientId], map: "change_orders_tenant_id_client_id_key")
  @@index([tenantId, status])
  @@map("change_orders")
}

model ChangeOrderLine {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  changeOrderId String   @map("change_order_id") @db.Uuid
  costCodeId    String?  @map("cost_code_id") @db.Uuid
  sortOrder     Int      @default(0) @map("sort_order")
  description   String
  unit          String?
  /// Null for a lump sum.
  quantity      Decimal? @db.Decimal(14, 3)
  rate          BigInt?
  /// Cost to the builder, minor units. Negative for an omission.
  amount        BigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  costCode    CostCode?   @relation(fields: [costCodeId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([changeOrderId, sortOrder])
  @@index([costCodeId])
  @@map("change_order_lines")
}

/// A photo or document backing a change order: one from the library, or an uploaded photo.
model ChangeOrderAttachment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  changeOrderId String   @map("change_order_id") @db.Uuid
  documentId    String?  @map("document_id") @db.Uuid
  s3Key         String?  @map("s3_key")
  contentType   String?  @map("content_type")
  caption       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([changeOrderId])
  @@index([documentId])
  @@map("change_order_attachments")
}

/// One cost code's budget moved by one approved change order: what was asked, what was applied
/// (a credit never takes a budget below zero), and the budget either side.
model ChangeOrderBudgetRevision {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  changeOrderId String   @map("change_order_id") @db.Uuid
  costCodeId    String   @map("cost_code_id") @db.Uuid
  requested     BigInt
  amount        BigInt
  budgetBefore  BigInt   @map("budget_before")
  budgetAfter   BigInt   @map("budget_after")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  costCode    CostCode    @relation(fields: [costCodeId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([projectId, costCodeId])
  @@index([changeOrderId])
  @@index([costCodeId])
  @@map("change_order_budget_revisions")
}

/// What one approved change order did to the site: the handover date, the contract value and the
/// site budget, each before and after. Null pairs where the site had no such figure.
model ChangeOrderSiteRevision {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  changeOrderId    String    @unique @map("change_order_id") @db.Uuid
  timeImpactDays   Int       @map("time_impact_days")
  handoverBefore   DateTime? @map("handover_before") @db.Date
  handoverAfter    DateTime? @map("handover_after") @db.Date
  contractBefore   BigInt?   @map("contract_before")
  contractAfter    BigInt?   @map("contract_after")
  siteBudgetBefore BigInt?   @map("site_budget_before")
  siteBudgetAfter  BigInt?   @map("site_budget_after")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId, createdAt])
  @@map("change_order_site_revisions")
}

/// The scope-creep catcher's find: a daily report or site message that reads like extra work,
/// waiting for a manager to raise a change order from it or dismiss it.
model ChangeOrderSuggestion {
  id            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                      @map("tenant_id") @db.Uuid
  projectId     String                      @map("project_id") @db.Uuid
  sourceKind    ChangeOrderSourceKind       @map("source_kind")
  sourceId      String                      @map("source_id") @db.Uuid
  excerpt       String
  matched       String[]                    @default([])
  /// `rules` (keywords) or `ai` (keywords confirmed by the model).
  detectedBy    String                      @default("rules") @map("detected_by")
  /// The model's one-line reading of it, when one was asked.
  summary       String?
  status        ChangeOrderSuggestionStatus @default(open)
  changeOrderId String?                     @map("change_order_id") @db.Uuid
  decidedBy     String?                     @map("decided_by") @db.Uuid
  decidedAt     DateTime?                   @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@unique([sourceKind, sourceId])
  @@index([tenantId, status])
  @@index([projectId, status])
  @@map("change_order_suggestions")
}

// ---------------------------------------------------------------------------
// QA/QC (roadmap Phase 2, module 7)
// ---------------------------------------------------------------------------
//
// Every name here says `quality`, `inspection` or `snag`: safety (HSE) has checklists and
// observations of its own, and the two modules must never collide on a table or an enum.

enum QualityItemKind {
  pass_fail
  number
  text
  photo

  @@map("quality_item_kind")
}

enum QualityItemOutcome {
  pass
  fail
  na

  @@map("quality_item_outcome")
}

enum QualityInspectionStatus {
  in_progress
  completed

  @@map("quality_inspection_status")
}

enum QualityInspectionResult {
  pass
  pass_with_comments
  fail

  @@map("quality_inspection_result")
}

enum QualitySignoffParty {
  inspector
  client
  consultant

  @@map("quality_signoff_party")
}

enum QualityTestType {
  concrete_cube
  concrete_slump
  steel_tensile
  soil_compaction
  brick_compressive
  water_absorption
  other

  @@map("quality_test_type")
}

enum QualityTestResult {
  pass
  fail

  @@map("quality_test_result")
}

enum SnagStatus {
  draft
  open
  fixed
  closed

  @@map("snag_status")
}

enum SnagPriority {
  low
  medium
  high
  critical

  @@map("snag_priority")
}

enum SnagSource {
  manual
  inspection
  quick_capture
  test

  @@map("snag_source")
}

enum SnagPhotoStage {
  before
  after

  @@map("snag_photo_stage")
}

/// A checklist in the company's library. Copied from the standard set the first time the library
/// is opened (`standardKey` says which), then the company's own to edit.
model QualityChecklistTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  /// The trade a failed line's snag is filed under.
  trade       String?
  description String?
  /// The standard checklist this was copied from, if any.
  standardKey String?  @map("standard_key")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       QualityChecklistItem[]
  inspections QualityInspection[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("quality_checklist_templates")
}

model QualityChecklistItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  templateId     String          @map("template_id") @db.Uuid
  position       Int
  label          String
  kind           QualityItemKind
  required       Boolean         @default(true)
  photoRequired  Boolean         @default(false) @map("photo_required")
  unit           String?
  targetValue    Decimal?        @map("target_value") @db.Decimal(12, 3)
  toleranceMinus Decimal?        @map("tolerance_minus") @db.Decimal(12, 3)
  tolerancePlus  Decimal?        @map("tolerance_plus") @db.Decimal(12, 3)
  guidance       String?

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template QualityChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@index([tenantId])
  @@map("quality_checklist_items")
}

/// One checklist run on one place on one site. The lines are copied in when it starts, so editing
/// the library later never rewrites an inspection somebody signed.
model QualityInspection {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  projectId       String                   @map("project_id") @db.Uuid
  templateId      String?                  @map("template_id") @db.Uuid
  /// QI-12: numbered within the company.
  number          Int
  /// The template's name when the inspection started.
  title           String
  trade           String?
  /// "Block A, 3rd floor slab".
  location        String
  inspectionDate  DateTime                 @map("inspection_date") @db.Date
  inspectorId     String?                  @map("inspector_id") @db.Uuid
  costCodeId      String?                  @map("cost_code_id") @db.Uuid
  milestoneId     String?                  @map("milestone_id") @db.Uuid
  status          QualityInspectionStatus  @default(in_progress)
  result          QualityInspectionResult?
  notes           String?
  /// Shown to the client in the portal once completed, for their countersignature.
  shareWithClient Boolean                  @default(false) @map("share_with_client")
  completedAt     DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template  QualityChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  inspector User?                     @relation("quality_inspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  costCode  CostCode?                 @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  milestone Milestone?                @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  items    QualityInspectionItem[]
  signoffs QualityInspectionSignoff[]
  snags    Snag[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId, inspectionDate])
  @@index([templateId])
  @@map("quality_inspections")
}

model QualityInspectionItem {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  inspectionId   String              @map("inspection_id") @db.Uuid
  position       Int
  label          String
  kind           QualityItemKind
  required       Boolean             @default(true)
  photoRequired  Boolean             @default(false) @map("photo_required")
  unit           String?
  targetValue    Decimal?            @map("target_value") @db.Decimal(12, 3)
  toleranceMinus Decimal?            @map("tolerance_minus") @db.Decimal(12, 3)
  tolerancePlus  Decimal?            @map("tolerance_plus") @db.Decimal(12, 3)
  guidance       String?
  outcome        QualityItemOutcome?
  numberValue    Decimal?            @map("number_value") @db.Decimal(12, 3)
  textValue      String?             @map("text_value")
  comment        String?
  /// Uploaded with kind `quality_photo`.
  photoKeys      String[]            @default([]) @map("photo_keys")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  snag       Snag?

  @@index([inspectionId, position])
  @@index([tenantId])
  @@map("quality_inspection_items")
}

/// A signature on an inspection: the inspector's completes it; a client's or consultant's
/// countersigns it. One per party — a second signature would make the first one meaningless.
model QualityInspectionSignoff {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  inspectionId  String              @map("inspection_id") @db.Uuid
  party         QualitySignoffParty
  userId        String?             @map("user_id") @db.Uuid
  /// Typed in full by the signer; what the printed report shows.
  signatureName String              @map("signature_name")
  accepted      Boolean             @default(true)
  note          String?
  signedAt      DateTime            @default(now()) @map("signed_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  user       User?             @relation("quality_signoff_user", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([inspectionId, party])
  @@index([tenantId])
  @@map("quality_inspection_signoffs")
}

/// A material or lab test. A cube set is one row per crushing age, sharing the sample reference.
model QualityTest {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  projectId    String             @map("project_id") @db.Uuid
  /// QT-5: numbered within the company.
  number       Int
  testType     QualityTestType    @map("test_type")
  title        String?
  sampleRef    String             @map("sample_ref")
  location     String?
  costCodeId   String?            @map("cost_code_id") @db.Uuid
  grade        String?
  castOn       DateTime?          @map("cast_on") @db.Date
  ageDays      Int?               @map("age_days")
  dueOn        DateTime?          @map("due_on") @db.Date
  testedOn     DateTime?          @map("tested_on") @db.Date
  specMin      Decimal?           @map("spec_min") @db.Decimal(12, 3)
  specMax      Decimal?           @map("spec_max") @db.Decimal(12, 3)
  unit         String?
  resultValue  Decimal?           @map("result_value") @db.Decimal(12, 3)
  result       QualityTestResult?
  labName      String?            @map("lab_name")
  /// The lab's report, uploaded with kind `quality_report`.
  reportS3Key  String?            @map("report_s3_key")
  notes        String?
  recordedById String?            @map("recorded_by") @db.Uuid
  /// When the "due for testing" reminder went out, so it goes out once.
  remindedAt   DateTime?          @map("reminded_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode   CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  recordedBy User?     @relation("quality_test_recorded_by", fields: [recordedById], references: [id], onDelete: SetNull)
  snags      Snag[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([tenantId, dueOn])
  @@map("quality_tests")
}

/// A defect to put right: from an inspection's failed line, a failed test, a quick photo, or typed.
/// The handover punch list is the snags marked `clientVisible`.
model Snag {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  projectId            String       @map("project_id") @db.Uuid
  /// SN-34: numbered within the company.
  number               Int
  title                String
  description          String?
  location             String?
  trade                String?
  priority             SnagPriority @default(medium)
  status               SnagStatus   @default(open)
  source               SnagSource   @default(manual)
  assignedUserId       String?      @map("assigned_user_id") @db.Uuid
  assignedContractorId String?      @map("assigned_contractor_id") @db.Uuid
  dueOn                DateTime?    @map("due_on") @db.Date
  clientVisible        Boolean      @default(false) @map("client_visible")
  costCodeId           String?      @map("cost_code_id") @db.Uuid
  inspectionId         String?      @map("inspection_id") @db.Uuid
  inspectionItemId     String?      @unique @map("inspection_item_id") @db.Uuid
  testId               String?      @map("test_id") @db.Uuid
  raisedById           String?      @map("raised_by") @db.Uuid
  /// What a voice note said, kept beside the draft so the words can be checked.
  transcript           String?
  /// A voice note kept because it could not be transcribed, so somebody can still listen to it.
  voiceS3Key           String?      @map("voice_s3_key")
  aiSuggested          Boolean      @default(false) @map("ai_suggested")
  reopenCount          Int          @default(0) @map("reopen_count")
  fixedAt              DateTime?    @map("fixed_at") @db.Timestamptz(6)
  closedAt             DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUser       User?                  @relation("snag_assignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedContractor Contractor?            @relation(fields: [assignedContractorId], references: [id], onDelete: SetNull)
  costCode           CostCode?              @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  inspection         QualityInspection?     @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  inspectionItem     QualityInspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  test               QualityTest?           @relation(fields: [testId], references: [id], onDelete: SetNull)
  raisedBy           User?                  @relation("snag_raised_by", fields: [raisedById], references: [id], onDelete: SetNull)

  photos SnagPhoto[]
  events SnagEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@index([assignedUserId])
  @@index([assignedContractorId])
  @@index([inspectionId])
  @@index([testId])
  @@map("snags")
}

model SnagPhoto {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  snagId       String         @map("snag_id") @db.Uuid
  stage        SnagPhotoStage @default(before)
  s3Key        String         @map("s3_key")
  uploadedById String?        @map("uploaded_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snag       Snag   @relation(fields: [snagId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("snag_photo_uploaded_by", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([snagId])
  @@index([tenantId])
  @@map("snag_photos")
}

/// The snag's own history — raised, fixed, closed, reopened and why — for the timeline on the snag.
/// The audit log holds the same facts; this is the readable version, kept with the snag.
model SnagEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  snagId    String   @map("snag_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snag   Snag   @relation(fields: [snagId], references: [id], onDelete: Cascade)
  actor  User?  @relation("snag_event_actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([snagId, createdAt])
  @@index([tenantId])
  @@map("snag_events")
}

// ---------------------------------------------------------------------------
// Scheduling (roadmap Phase 2, module 6)
// ---------------------------------------------------------------------------

/// A summary task is not a kind: any task with subtasks is one.
enum ScheduleTaskKind {
  task
  milestone

  @@map("schedule_task_kind")
}

/// As soon as possible, start no earlier than, finish no later than.
enum ScheduleConstraintType {
  asap
  snet
  fnlt

  @@map("schedule_constraint_type")
}

enum ScheduleLinkType {
  FS
  SS
  FF
  SF

  @@map("schedule_link_type")
}

/// Which days are worked. One per site at most, and one for the company (`projectId` null) that a
/// site without its own uses. Neither row has to exist: the company's country decides the weekend.
model ScheduleCalendar {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  projectId   String?    @unique @map("project_id") @db.Uuid
  name        String
  /// Weekdays worked, 0 Sunday … 6 Saturday.
  workingDays Int[]      @map("working_days")
  holidays    DateTime[] @db.Date
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("schedule_calendars")
}

/// One line of a site's programme. Only what a planner decides is stored — durations, links,
/// constraints and progress. The dates are worked out by the engine on every read
/// (`scheduleCompute`), so they can never be stale and a slip does not write a row per task moved.
model ScheduleTask {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  projectId         String                 @map("project_id") @db.Uuid
  parentId          String?                @map("parent_id") @db.Uuid
  /// The site milestone this task is. Its planned date follows the schedule.
  milestoneId       String?                @unique @map("milestone_id") @db.Uuid
  costCodeId        String?                @map("cost_code_id") @db.Uuid
  responsibleUserId String?                @map("responsible_user_id") @db.Uuid
  contractorId      String?                @map("contractor_id") @db.Uuid
  wbsCode           String?                @map("wbs_code")
  name              String
  kind              ScheduleTaskKind       @default(task)
  sortOrder         Int                    @default(0) @map("sort_order")
  /// Working days. Zero for a milestone.
  durationDays      Int                    @default(1) @map("duration_days")
  constraintType    ScheduleConstraintType @default(asap) @map("constraint_type")
  constraintDate    DateTime?              @map("constraint_date") @db.Date
  percentComplete   Int                    @default(0) @map("percent_complete")
  actualStart       DateTime?              @map("actual_start") @db.Date
  actualFinish      DateTime?              @map("actual_finish") @db.Date
  notes             String?
  /// The task's id in the file it was imported from (an MSP UID, a P6 activity id).
  externalId        String?                @map("external_id")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      ScheduleTask?  @relation("schedule_task_tree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ScheduleTask[] @relation("schedule_task_tree")
  milestone   Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  costCode    CostCode?      @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  responsible User?          @relation("schedule_task_responsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  contractor  Contractor?    @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  successors    ScheduleDependency[]   @relation("schedule_predecessor")
  predecessors  ScheduleDependency[]   @relation("schedule_successor")
  baselineTasks ScheduleBaselineTask[]

  rfis Rfi[]

  @@index([projectId, sortOrder])
  @@index([parentId])
  @@index([tenantId])
  @@map("schedule_tasks")
}

/// "B waits on A": finish-to-start, start-to-start, finish-to-finish or start-to-finish, with a lag
/// in working days (negative is a lead). The service refuses any link that would close a loop.
model ScheduleDependency {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  predecessorId String           @map("predecessor_id") @db.Uuid
  successorId   String           @map("successor_id") @db.Uuid
  type          ScheduleLinkType @default(FS)
  lagDays       Int              @default(0) @map("lag_days")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor ScheduleTask @relation("schedule_predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleTask @relation("schedule_successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@index([successorId])
  @@index([tenantId])
  @@map("schedule_dependencies")
}

/// A saved copy of the plan's dates, to measure slippage against. Never edited after it is taken.
model ScheduleBaseline {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  /// When the plan it copies was due to finish.
  finishDate  DateTime @map("finish_date") @db.Date
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("schedule_baseline_creator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     ScheduleBaselineTask[]

  @@index([projectId, createdAt])
  @@index([tenantId])
  @@map("schedule_baselines")
}

/// One task's dates in a baseline. Kept, with its name, if the task is later deleted.
model ScheduleBaselineTask {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  baselineId   String   @map("baseline_id") @db.Uuid
  taskId       String?  @map("task_id") @db.Uuid
  name         String
  startDate    DateTime @map("start_date") @db.Date
  finishDate   DateTime @map("finish_date") @db.Date
  durationDays Int      @map("duration_days")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseline ScheduleBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  task     ScheduleTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([baselineId, taskId])
  @@index([taskId])
  @@index([tenantId])
  @@map("schedule_baseline_tasks")
}

// ---------------------------------------------------------------------------
// Safety (HSE) — roadmap Phase 2, module 8
// ---------------------------------------------------------------------------
//
// Everything is prefixed `safety_`: QA/QC has checklists and observations of its own. People who
// report, sign and close are plain user ids (no foreign key), like a variation's requester — the
// record must keep naming them after they leave. Workers are real foreign keys, because the roster
// is what the crew, the attendees and the injured are picked from.

enum SafetyIncidentType {
  near_miss
  first_aid
  medical_treatment
  lost_time_injury
  fatality
  property_damage
  environmental

  @@map("safety_incident_type")
}

enum SafetySeverity {
  low
  medium
  high
  critical

  @@map("safety_severity")
}

enum SafetyIncidentStatus {
  reported
  investigating
  actions_open
  closed

  @@map("safety_incident_status")
}

enum SafetyPersonRole {
  injured
  involved
  witness

  @@map("safety_person_role")
}

enum SafetyActionKind {
  corrective
  preventive

  @@map("safety_action_kind")
}

enum SafetyActionStatus {
  open
  done
  cancelled

  @@map("safety_action_status")
}

enum SafetyPermitType {
  hot_work
  work_at_height
  confined_space
  excavation
  electrical_isolation
  lifting

  @@map("safety_permit_type")
}

enum SafetyPermitStatus {
  requested
  active
  suspended
  closed

  @@map("safety_permit_status")
}

enum SafetyObservationType {
  unsafe_act
  unsafe_condition
  positive

  @@map("safety_observation_type")
}

enum SafetyObservationStatus {
  open
  closed

  @@map("safety_observation_status")
}

/// An incident or near miss on a site.
model SafetyIncident {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  projectId         String               @map("project_id") @db.Uuid
  /// Per company, shown as `INC-0007`.
  number            Int
  /// The instant it happened; entered and shown on the company's clock.
  occurredAt        DateTime             @map("occurred_at") @db.Timestamptz(6)
  /// The calendar day it happened on the company's clock, for "days since" and date filters.
  occurredOn        DateTime             @map("occurred_on") @db.Date
  type              SafetyIncidentType
  severity          SafetySeverity       @default(medium)
  title             String
  description       String?
  location          String?
  immediateAction   String?              @map("immediate_action")
  /// Five whys, in order.
  rootCauseWhys     String[]             @default([]) @map("root_cause_whys")
  rootCause         String?              @map("root_cause")
  lostDays          Int?                 @map("lost_days")
  status            SafetyIncidentStatus @default(reported)
  reportedBy        String               @map("reported_by") @db.Uuid
  investigatedBy    String?              @map("investigated_by") @db.Uuid
  closedBy          String?              @map("closed_by") @db.Uuid
  closedAt          DateTime?            @map("closed_at") @db.Timestamptz(6)
  closureNote       String?              @map("closure_note")
  /// When the owners were told about a serious incident; set once so an edit never re-alerts.
  seriousNotifiedAt DateTime?            @map("serious_notified_at") @db.Timestamptz(6)
  clientId          String?              @map("client_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  people  SafetyIncidentPerson[]
  actions SafetyAction[]
  photos  SafetyPhoto[]

  @@unique([tenantId, number])
  @@unique([tenantId, clientId])
  @@index([tenantId, projectId, occurredOn])
  @@index([tenantId, status])
  @@map("safety_incidents")
}

/// Somebody hurt, involved or watching. A worker from the roster, or a name for anybody else.
model SafetyIncidentPerson {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  incidentId   String           @map("incident_id") @db.Uuid
  workerId     String?          @map("worker_id") @db.Uuid
  /// The worker's name when recorded, or the free-text name of a visitor.
  name         String
  role         SafetyPersonRole @default(involved)
  bodyPart     String?          @map("body_part")
  injuryNature String?          @map("injury_nature")
  statement    String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident SafetyIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  worker   Worker?        @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([workerId])
  @@index([tenantId])
  @@map("safety_incident_people")
}

/// A corrective or preventive action, raised from an incident or an observation.
model SafetyAction {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  projectId     String             @map("project_id") @db.Uuid
  incidentId    String?            @map("incident_id") @db.Uuid
  observationId String?            @map("observation_id") @db.Uuid
  kind          SafetyActionKind   @default(corrective)
  description   String
  assigneeId    String?            @map("assignee_id") @db.Uuid
  dueOn         DateTime?          @map("due_on") @db.Date
  status        SafetyActionStatus @default(open)
  /// The day it was raised on the company's clock, which its age is counted from.
  raisedOn      DateTime           @map("raised_on") @db.Date
  raisedBy      String             @map("raised_by") @db.Uuid
  doneBy        String?            @map("done_by") @db.Uuid
  doneAt        DateTime?          @map("done_at") @db.Timestamptz(6)
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incident    SafetyIncident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  observation SafetyObservation? @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([incidentId])
  @@index([observationId])
  @@index([projectId])
  @@map("safety_actions")
}

/// A permit to work: a hazardous job, where, when, who, and the two signatures that let it start.
model SafetyPermit {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  projectId       String             @map("project_id") @db.Uuid
  /// Per company, shown as `PTW-0012`.
  number          Int
  type            SafetyPermitType
  description     String
  area            String
  precautions     String?
  /// `[{ item, checked }]`, seeded from the type's default checklist.
  checklist       Json               @default("[]") @db.JsonB
  validFrom       DateTime           @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime           @map("valid_to") @db.Timestamptz(6)
  status          SafetyPermitStatus @default(requested)
  requestedBy     String             @map("requested_by") @db.Uuid
  issuerId        String?            @map("issuer_id") @db.Uuid
  issuedAt        DateTime?          @map("issued_at") @db.Timestamptz(6)
  areaAuthorityId String?            @map("area_authority_id") @db.Uuid
  areaAuthorityAt DateTime?          @map("area_authority_at") @db.Timestamptz(6)
  suspendedReason String?            @map("suspended_reason")
  closedBy        String?            @map("closed_by") @db.Uuid
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(6)
  closeNote       String?            @map("close_note")
  /// Set when the "this permit has expired and is still open" alert went out, so it goes once.
  expiryAlertedAt DateTime?          @map("expiry_alerted_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crew    SafetyPermitCrew[]
  photos  SafetyPhoto[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@index([tenantId, status, validTo])
  @@map("safety_permits")
}

/// A worker on a permit's crew.
model SafetyPermitCrew {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  permitId  String   @map("permit_id") @db.Uuid
  workerId  String   @map("worker_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permit SafetyPermit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  worker Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([permitId, workerId])
  @@index([workerId])
  @@index([tenantId])
  @@map("safety_permit_crew")
}

/// A toolbox talk: the five-minute briefing before a shift, who gave it and who heard it.
model SafetyToolboxTalk {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  talkDate        DateTime @map("talk_date") @db.Date
  /// The library topic it came from, if any.
  topicKey        String?  @map("topic_key")
  topic           String
  notes           String?
  presenterId     String   @map("presenter_id") @db.Uuid
  durationMinutes Int      @default(15) @map("duration_minutes")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendees SafetyToolboxAttendee[]
  photos    SafetyPhoto[]

  @@index([tenantId, projectId, talkDate])
  @@map("safety_toolbox_talks")
}

/// A worker at a toolbox talk, picked from that day's roll, and when they signed.
model SafetyToolboxAttendee {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  talkId    String    @map("talk_id") @db.Uuid
  workerId  String    @map("worker_id") @db.Uuid
  signedAt  DateTime? @map("signed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  talk   SafetyToolboxTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)
  worker Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([talkId, workerId])
  @@index([workerId])
  @@index([tenantId])
  @@map("safety_toolbox_attendees")
}

/// A safety observation: an unsafe act, an unsafe condition, or something done right.
model SafetyObservation {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  /// Per company, shown as `OBS-0003`.
  number      Int
  observedAt  DateTime                @map("observed_at") @db.Timestamptz(6)
  observedOn  DateTime                @map("observed_on") @db.Date
  type        SafetyObservationType
  /// One of SAFETY_CATEGORIES in @sitebook/shared.
  category    String
  severity    SafetySeverity          @default(medium)
  description String
  location    String?
  /// What was said, when it came in as a voice note.
  transcript  String?
  /// Where the type, category and severity first came from: `ai`, `rules`, or null when typed.
  suggestedBy String?                 @map("suggested_by")
  status      SafetyObservationStatus @default(open)
  reportedBy  String                  @map("reported_by") @db.Uuid
  closedBy    String?                 @map("closed_by") @db.Uuid
  closedAt    DateTime?               @map("closed_at") @db.Timestamptz(6)
  closeNote   String?                 @map("close_note")
  clientId    String?                 @map("client_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actions SafetyAction[]
  photos  SafetyPhoto[]

  @@unique([tenantId, number])
  @@unique([tenantId, clientId])
  @@index([tenantId, projectId, observedOn])
  @@index([tenantId, status])
  @@map("safety_observations")
}

/// A photo attached to exactly one safety record: evidence, a witness statement, a close-out.
model SafetyPhoto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  incidentId    String?  @map("incident_id") @db.Uuid
  observationId String?  @map("observation_id") @db.Uuid
  permitId      String?  @map("permit_id") @db.Uuid
  toolboxTalkId String?  @map("toolbox_talk_id") @db.Uuid
  /// One of SAFETY_PHOTO_PURPOSES in @sitebook/shared.
  purpose       String   @default("evidence")
  s3Key         String   @map("s3_key")
  caption       String?
  uploadedBy    String   @map("uploaded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incident    SafetyIncident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  observation SafetyObservation? @relation(fields: [observationId], references: [id], onDelete: Cascade)
  permit      SafetyPermit?      @relation(fields: [permitId], references: [id], onDelete: Cascade)
  toolboxTalk SafetyToolboxTalk? @relation(fields: [toolboxTalkId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([observationId])
  @@index([permitId])
  @@index([toolboxTalkId])
  @@index([tenantId])
  @@map("safety_photos")
}

// ---------------------------------------------------------------------------
// Bill of quantities (roadmap Phase 2, module 5)
// ---------------------------------------------------------------------------
//
// The client-side BOQ: what the builder bills the client, item by item. Not a subcontract's schedule
// of rates (what a subcontractor bills us) — the difference between the two is the margin.
//
// A certified BOQ bill becomes money owed through the existing client billing: invoicing it adds an
// instalment to the site's payment schedule (`payment_stages`), and receipts against that instalment
// are what make it paid. There is one client ledger, not two.

enum BoqItemKind {
  section
  item

  @@map("boq_item_kind")
}

enum BoqBillStatus {
  draft
  submitted
  certified
  invoiced

  @@map("boq_bill_status")
}

/// One site's bill of quantities, and the client's billing terms on it. At most one per site.
model Boq {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @unique @map("project_id") @db.Uuid
  title             String   @default("Bill of quantities")
  /// Basis points the client holds back from every bill: 500 = 5%.
  retentionBp       Int      @default(0) @map("retention_bp")
  /// Mobilisation advance the client paid, minor units; recovered from the bills.
  advanceAmount     BigInt   @default(0) @map("advance_amount")
  advanceRecoveryBp Int      @default(0) @map("advance_recovery_bp")
  /// GST or VAT charged to the client on each bill, basis points.
  taxRateBp         Int      @default(0) @map("tax_rate_bp")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BoqItem[]
  bills   BoqBill[]

  @@index([tenantId])
  @@map("boqs")
}

/// A section heading or a priced item. A tree through `parentId`; the contract value of a section is
/// its items' sum, worked out rather than stored.
model BoqItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  boqId       String      @map("boq_id") @db.Uuid
  parentId    String?     @map("parent_id") @db.Uuid
  /// Refused (no action) rather than nulled, like a subcontract line: un-coding an item quietly moves
  /// its revenue off the line it was priced against.
  costCodeId  String?     @map("cost_code_id") @db.Uuid
  kind        BoqItemKind @default(item)
  /// `2.1.3`, unique within the BOQ.
  itemNo      String      @map("item_no")
  description String
  unit        String?
  /// Contract quantity. Null on a section.
  quantity    Decimal?    @db.Decimal(14, 3)
  /// Minor units per unit.
  rate        BigInt?
  /// `quantity × rate`, rounded to the minor unit once, here.
  amount      BigInt?
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boq          Boq              @relation(fields: [boqId], references: [id], onDelete: Cascade)
  parent       BoqItem?         @relation("boq_item_tree", fields: [parentId], references: [id], onDelete: Cascade)
  children     BoqItem[]        @relation("boq_item_tree")
  costCode     CostCode?        @relation(fields: [costCodeId], references: [id], onDelete: NoAction)
  measurements BoqMeasurement[]
  billLines    BoqBillLine[]

  @@unique([boqId, itemNo])
  @@index([tenantId])
  @@index([boqId, sortOrder])
  @@index([parentId])
  @@index([costCodeId])
  @@map("boq_items")
}

/// One entry in the measurement book: work measured on site against an item.
model BoqMeasurement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  measuredOn DateTime @map("measured_on") @db.Date
  location   String?
  count      Decimal? @db.Decimal(14, 3)
  length     Decimal? @db.Decimal(14, 3)
  breadth    Decimal? @db.Decimal(14, 3)
  height     Decimal? @db.Decimal(14, 3)
  /// The product of the dimensions given; negative for a deduction.
  quantity   Decimal  @db.Decimal(14, 3)
  note       String?
  photoKeys  String[] @default([]) @map("photo_keys")
  /// A bare id, like the people on a subcontract bill: the audit log already says who wrote the row.
  measuredBy String   @map("measured_by") @db.Uuid
  clientId   String?  @map("client_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   BoqItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId], map: "boq_measurements_tenant_id_client_id_key")
  @@index([tenantId])
  @@index([itemId, measuredOn])
  @@map("boq_measurements")
}

/// A running-account bill to the client. The money columns are `boqComputeBill`'s figures — kept up
/// to date while it is a draft, frozen at certification — so a certified bill always prints what the
/// client certified. `claimedGross` keeps what was asked for, beside what was certified.
model BoqBill {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  boqId                  String        @map("boq_id") @db.Uuid
  /// RA-1, RA-2 … within the BOQ.
  number                 Int
  periodFrom             DateTime?     @map("period_from") @db.Date
  periodTo               DateTime      @map("period_to") @db.Date
  billDate               DateTime      @map("bill_date") @db.Date
  status                 BoqBillStatus @default(draft)
  claimedGross           BigInt        @default(0) @map("claimed_gross")
  grossToDate            BigInt        @default(0) @map("gross_to_date")
  previousGross          BigInt        @default(0) @map("previous_gross")
  gross                  BigInt        @default(0)
  retentionToDate        BigInt        @default(0) @map("retention_to_date")
  retention              BigInt        @default(0)
  advanceRecoveredToDate BigInt        @default(0) @map("advance_recovered_to_date")
  advanceRecovery        BigInt        @default(0) @map("advance_recovery")
  taxRateBp              Int           @default(0) @map("tax_rate_bp")
  tax                    BigInt        @default(0)
  netPayable             BigInt        @default(0) @map("net_payable")
  note                   String?
  createdBy              String        @map("created_by") @db.Uuid
  submittedBy            String?       @map("submitted_by") @db.Uuid
  submittedAt            DateTime?     @map("submitted_at") @db.Timestamptz(6)
  certifiedBy            String?       @map("certified_by") @db.Uuid
  certifiedAt            DateTime?     @map("certified_at") @db.Timestamptz(6)
  certificationNote      String?       @map("certification_note")
  invoicedBy             String?       @map("invoiced_by") @db.Uuid
  invoicedAt             DateTime?     @map("invoiced_at") @db.Timestamptz(6)
  /// The instalment this bill became in the client's payment schedule.
  paymentStageId         String?       @unique @map("payment_stage_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boq          Boq           @relation(fields: [boqId], references: [id], onDelete: Cascade)
  paymentStage PaymentStage? @relation(fields: [paymentStageId], references: [id], onDelete: SetNull)
  lines        BoqBillLine[]

  @@unique([boqId, number])
  @@index([tenantId, status])
  @@map("boq_bills")
}

/// Quantity to date on one item, as claimed and — once the client certifies — as certified.
model BoqBillLine {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  billId            String   @map("bill_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  claimedQuantity   Decimal  @map("claimed_quantity") @db.Decimal(14, 3)
  certifiedQuantity Decimal? @map("certified_quantity") @db.Decimal(14, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill   BoqBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  item   BoqItem @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@unique([billId, itemId])
  @@index([tenantId])
  @@index([itemId])
  @@map("boq_bill_lines")
}

// ---------------------------------------------------------------------------
// Company groups (Phase 2, module 11)
// ---------------------------------------------------------------------------
//
// A group is *above* tenancy, so none of these tables is tenant data and none carries the usual
// `tenant_isolation` policy. Each has its own row-level security keyed by `app.group_id`, which
// the API sets only to the group its own company belongs to — see migration
// 20261009000300_company_groups for the policies and why.

/// A holding that owns several companies (tenants), each keeping its own data, currency and team.
model CompanyGroup {
  /// Chosen by the API rather than the default, so `app.group_id` can be set before the insert
  /// that the row-level policy checks — the same reason a tenant's id is.
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  /// What the consolidated total is converted into.
  baseCurrency      String   @map("base_currency") @db.Char(3)
  /// History, not a foreign key: the founding company may leave, and the group carries on.
  createdByTenantId String?  @map("created_by_tenant_id") @db.Uuid
  createdByUserId   String?  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members     CompanyGroupMember[]
  invitations CompanyGroupInvitation[]
  rates       CompanyGroupExchangeRate[]

  @@map("company_groups")
}

/// A company in a group. `tenant_id` is unique: a company belongs to at most one group.
model CompanyGroupMember {
  groupId  String   @map("group_id") @db.Uuid
  tenantId String   @unique @map("tenant_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  group  CompanyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admins CompanyGroupAdmin[]

  @@id([groupId, tenantId])
  @@map("company_group_members")
}

/// An invitation for a company to join a group. Only that company's owner can accept it.
model CompanyGroupInvitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId           String    @map("group_id") @db.Uuid
  /// The company invited.
  tenantId          String    @map("tenant_id") @db.Uuid
  /// Who asked, kept as history rather than foreign keys — they may leave or be removed.
  invitedByTenantId String?   @map("invited_by_tenant_id") @db.Uuid
  invitedByUserId   String?   @map("invited_by_user_id") @db.Uuid
  /// pending | accepted | declined | cancelled (COMPANY_GROUP_INVITATION_STATUSES).
  status            String    @default("pending")
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz(6)
  respondedByUserId String?   @map("responded_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // One live invitation per company per group is a partial unique index (WHERE status =
  // 'pending'), which Prisma cannot express; it lives in the migration SQL only.

  group  CompanyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([groupId, status])
  @@map("company_group_invitations")
}

/// A person the group trusts with its reports or its membership. A user row in one of the group's
/// companies — the grant goes when that company leaves (the composite key cascades).
model CompanyGroupAdmin {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// COMPANY_GROUP_PERMISSIONS — group grants, never tenant permissions.
  permissions     String[] @default([])
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member CompanyGroupMember @relation(fields: [groupId, tenantId], references: [groupId, tenantId], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("company_group_admins")
}

/// A manual exchange rate: one unit of `currency` = `rate` of the group's base currency, from
/// `effective_from` until a later row replaces it. No live FX — see `companyGroupRateOn`.
model CompanyGroupExchangeRate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  currency        String   @db.Char(3)
  rate            Decimal  @db.Decimal(20, 10)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group CompanyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, currency, effectiveFrom])
  @@map("company_group_exchange_rates")
}

// ---------------------------------------------------------------------------
// RFIs and submittals (roadmap Phase 2, module 9)
// ---------------------------------------------------------------------------
//
// Questions to the designers with due dates, and the contractor's documents sent for approval with
// their status. Builds on Documents: a question points at the drawing revision it is about, and a
// submittal carries the files that are being approved. The designer or consultant on the other end
// is usually not a user — they answer through a signed link (see `TokenService.signRfiLink`).

enum RfiStatus {
  draft
  open
  answered
  closed
  void

  @@map("rfi_status")
}

enum RfiDiscipline {
  architectural
  structural
  mep
  civil
  other

  @@map("rfi_discipline")
}

enum RfiPriority {
  low
  normal
  high
  urgent

  @@map("rfi_priority")
}

enum SubmittalStatus {
  draft
  submitted
  under_review
  approved
  approved_as_noted
  revise_resubmit
  rejected

  @@map("submittal_status")
}

enum SubmittalType {
  shop_drawing
  material_sample
  method_statement
  data_sheet
  other

  @@map("submittal_type")
}

enum SubmittalReviewerKind {
  external
  client

  @@map("submittal_reviewer_kind")
}

/// The company's defaults: how long a designer gets to answer, a reviewer to review, and when the
/// "due soon" reminder goes. One row per company, written the first time somebody changes them.
model RfiSettings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  rfiDueDays          Int      @default(7) @map("rfi_due_days")
  submittalReviewDays Int      @default(14) @map("submittal_review_days")
  reminderDaysBefore  Int      @default(2) @map("reminder_days_before")
  updatedBy           String?  @map("updated_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("rfi_settings")
}

/// A request for information: one question to a designer, with a due date and a thread of answers.
model Rfi {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  projectId          String        @map("project_id") @db.Uuid
  /// RFI-001 is 1. Numbered per site, like change orders: it is the consultant's log for the job.
  number             Int
  subject            String
  question           String
  discipline         RfiDiscipline @default(other)
  priority           RfiPriority   @default(normal)
  location           String?
  status             RfiStatus     @default(draft)
  raisedBy           String        @map("raised_by") @db.Uuid
  raisedOn           DateTime      @map("raised_on") @db.Date
  /// The outside party it is addressed to. Usually not a user of this product.
  addressedToName    String?       @map("addressed_to_name")
  addressedToEmail   String?       @map("addressed_to_email")
  addressedToCompany String?       @map("addressed_to_company")
  addressedToPhone   String?       @map("addressed_to_phone")
  /// Somebody on the team who owns chasing it.
  assigneeId         String?       @map("assignee_id") @db.Uuid
  /// When it was opened (sent). Response time runs from here.
  sentAt             DateTime?     @map("sent_at") @db.Timestamptz(6)
  dueOn              DateTime?     @map("due_on") @db.Date
  costImpact         Boolean       @default(false) @map("cost_impact")
  scheduleImpact     Boolean       @default(false) @map("schedule_impact")
  changeOrderId      String?       @map("change_order_id") @db.Uuid
  scheduleTaskId     String?       @map("schedule_task_id") @db.Uuid
  answeredAt         DateTime?     @map("answered_at") @db.Timestamptz(6)
  closedBy           String?       @map("closed_by") @db.Uuid
  closedAt           DateTime?     @map("closed_at") @db.Timestamptz(6)
  closeNote          String?       @map("close_note")
  voidReason         String?       @map("void_reason")
  /// Counted up to withdraw every link sent so far; a link carries the version it was signed with.
  linkVersion        Int           @default(0) @map("link_version")
  linkSentAt         DateTime?     @map("link_sent_at") @db.Timestamptz(6)
  dueSoonRemindedAt  DateTime?     @map("due_soon_reminded_at") @db.Timestamptz(6)
  overdueRemindedAt  DateTime?     @map("overdue_reminded_at") @db.Timestamptz(6)
  clientId           String?       @map("client_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeOrder  ChangeOrder?    @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  scheduleTask ScheduleTask?   @relation(fields: [scheduleTaskId], references: [id], onDelete: SetNull)
  documents    RfiDocument[]
  responses    RfiResponse[]
  attachments  RfiAttachment[]

  @@unique([projectId, number])
  @@unique([tenantId, clientId], map: "rfis_tenant_id_client_id_key")
  @@index([tenantId, status, dueOn])
  @@index([changeOrderId])
  @@index([scheduleTaskId])
  @@map("rfis")
}

/// A drawing or document (one revision of it) that an RFI is about.
model RfiDocument {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  rfiId      String   @map("rfi_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfi      Rfi      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([rfiId, documentId])
  @@index([tenantId])
  @@index([documentId])
  @@map("rfi_documents")
}

/// One message in an RFI's thread. Written by a team member, or by the outside party through their
/// link — then `authorUserId` is null and the name and email are what they typed.
model RfiResponse {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  rfiId        String   @map("rfi_id") @db.Uuid
  body         String
  authorUserId String?  @map("author_user_id") @db.Uuid
  authorName   String   @map("author_name")
  authorEmail  String?  @map("author_email")
  external     Boolean  @default(false)
  /// The answer the RFI is closed on. At most one per RFI (a partial unique index in the migration).
  isOfficial   Boolean  @default(false) @map("is_official")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfi         Rfi             @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  attachments RfiAttachment[]

  @@index([tenantId])
  @@index([rfiId, createdAt])
  @@map("rfi_responses")
}

/// A photo or file on an RFI or on one of its responses: a library document or an upload.
model RfiAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  rfiId       String   @map("rfi_id") @db.Uuid
  responseId  String?  @map("response_id") @db.Uuid
  documentId  String?  @map("document_id") @db.Uuid
  s3Key       String?  @map("s3_key")
  contentType String?  @map("content_type")
  filename    String?
  /// Null when the outside party uploaded it through their link.
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfi      Rfi          @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  response RfiResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  document Document?    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rfiId])
  @@index([responseId])
  @@index([documentId])
  @@map("rfi_attachments")
}

/// One item on the submittal log: a shop drawing, a sample, a method statement. Its revisions are
/// the history; `status` and `dueOn` mirror the current revision so the log can filter on them.
model Submittal {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  projectId         String                @map("project_id") @db.Uuid
  /// SUB-001 is 1. Numbered per site; a resubmission keeps the number and counts the revision up.
  number            Int
  title             String
  type              SubmittalType         @default(shop_drawing)
  specSection       String?               @map("spec_section")
  description       String?
  costCodeId        String?               @map("cost_code_id") @db.Uuid
  submittedByUserId String?               @map("submitted_by_user_id") @db.Uuid
  contractorId      String?               @map("contractor_id") @db.Uuid
  vendorId          String?               @map("vendor_id") @db.Uuid
  reviewerKind      SubmittalReviewerKind @default(external) @map("reviewer_kind")
  reviewerName      String?               @map("reviewer_name")
  reviewerEmail     String?               @map("reviewer_email")
  reviewerCompany   String?               @map("reviewer_company")
  reviewerPhone     String?               @map("reviewer_phone")
  currentRevision   Int                   @default(0) @map("current_revision")
  status            SubmittalStatus       @default(draft)
  dueOn             DateTime?             @map("due_on") @db.Date
  createdBy         String                @map("created_by") @db.Uuid
  clientId          String?               @map("client_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode   CostCode?           @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  contractor Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  vendor     Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  revisions  SubmittalRevision[]

  @@unique([projectId, number])
  @@unique([tenantId, clientId], map: "submittals_tenant_id_client_id_key")
  @@index([tenantId, status, dueOn])
  @@index([costCodeId])
  @@index([contractorId])
  @@index([vendorId])
  @@map("submittals")
}

/// One revision of a submittal: what was sent, to whom, when it was due and what came back.
model SubmittalRevision {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  submittalId        String          @map("submittal_id") @db.Uuid
  /// Rev 0, 1, 2…
  revision           Int
  /// The revision this one answers. Null on Rev 0.
  previousRevisionId String?         @unique @map("previous_revision_id") @db.Uuid
  status             SubmittalStatus @default(draft)
  note               String?
  submittedBy        String?         @map("submitted_by") @db.Uuid
  submittedAt        DateTime?       @map("submitted_at") @db.Timestamptz(6)
  dueOn              DateTime?       @map("due_on") @db.Date
  reviewStartedAt    DateTime?       @map("review_started_at") @db.Timestamptz(6)
  reviewedAt         DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  /// A team member who recorded the review; null when the reviewer used their link.
  reviewedBy         String?         @map("reviewed_by") @db.Uuid
  reviewerName       String?         @map("reviewer_name")
  reviewerEmail      String?         @map("reviewer_email")
  reviewComments     String?         @map("review_comments")
  /// The client portal approval, when the client is the reviewer.
  approvalId         String?         @unique @map("approval_id") @db.Uuid
  linkVersion        Int             @default(0) @map("link_version")
  linkSentAt         DateTime?       @map("link_sent_at") @db.Timestamptz(6)
  dueSoonRemindedAt  DateTime?       @map("due_soon_reminded_at") @db.Timestamptz(6)
  overdueRemindedAt  DateTime?       @map("overdue_reminded_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittal Submittal          @relation(fields: [submittalId], references: [id], onDelete: Cascade)
  previous  SubmittalRevision? @relation("submittal_revision_chain", fields: [previousRevisionId], references: [id], onDelete: SetNull)
  next      SubmittalRevision? @relation("submittal_revision_chain")
  approval  Approval?          @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  files     SubmittalFile[]

  @@unique([submittalId, revision])
  @@index([tenantId, status, dueOn])
  @@map("submittal_revisions")
}

/// A file on a submittal revision: what was submitted, or the reviewer's marked-up copy.
model SubmittalFile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  revisionId  String   @map("revision_id") @db.Uuid
  /// `submission` or `markup`.
  role        String   @default("submission")
  documentId  String?  @map("document_id") @db.Uuid
  s3Key       String?  @map("s3_key")
  contentType String?  @map("content_type")
  filename    String?
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revision SubmittalRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  document Document?         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([revisionId])
  @@index([documentId])
  @@map("submittal_files")
}

// ---------------------------------------------------------------------------
// Equipment and plant (roadmap Phase 2, module 10)
// ---------------------------------------------------------------------------
//
// Kinds and statuses are text with CHECK constraints in the migration rather than Postgres enums:
// the vocabulary (EQUIPMENT_* in @sitebook/shared) will grow — a new category of machine should be
// a code change, not an ALTER TYPE.

/// One machine, or one lot of bulk kit (scaffolding sets, small tools), owned or hired.
model Equipment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// Asset code, unique in the company: `BH-004`.
  code               String
  name               String
  /// One of EQUIPMENT_CATEGORIES.
  category           String
  make               String?
  model              String?
  registrationNo     String?   @map("registration_no")
  serialNo           String?   @map("serial_no")
  year               Int?
  quantity           Int       @default(1)
  /// owned | hired
  ownership          String
  /// Hired kit: the supplier it is hired from.
  vendorId           String?   @map("vendor_id") @db.Uuid
  /// hour | day | month — how the vendor charges.
  hireBasis          String?   @map("hire_basis")
  /// Minor units per hour, day or month.
  hireRate           BigInt    @default(0) @map("hire_rate")
  /// Per day for hourly hire; the hours a monthly rate covers for monthly hire.
  minHours           Decimal?  @map("min_hours") @db.Decimal(7, 1)
  operatorIncluded   Boolean   @default(true) @map("operator_included")
  /// Per working day, when the vendor charges for the operator separately.
  operatorRate       BigInt    @default(0) @map("operator_rate")
  fuelIncluded       Boolean   @default(false) @map("fuel_included")
  /// Charged once each time the machine is brought to a site.
  mobilisationCharge BigInt    @default(0) @map("mobilisation_charge")
  /// Owned kit: hour | day, and the internal rate charged to the site it works on.
  chargeOutBasis     String?   @map("charge_out_basis")
  chargeOutRate      BigInt    @default(0) @map("charge_out_rate")
  /// hours | km | none
  meterType          String    @default("hours") @map("meter_type")
  /// The latest reading anybody recorded, from a log, a fuel entry or a service.
  meterReading       Decimal?  @map("meter_reading") @db.Decimal(10, 1)
  /// available | on_site | under_maintenance | off_hire
  status             String    @default("available")
  notes              String?
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor       Vendor?                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  allocations  EquipmentAllocation[]
  logs         EquipmentLog[]
  fuel         EquipmentFuel[]
  servicePlans EquipmentServicePlan[]
  maintenance  EquipmentMaintenance[]
  documents    EquipmentDocument[]
  hireBookings EquipmentHireBooking[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([vendorId])
  @@map("equipment")
}

/// Which site a machine was on, from when to when — the history that puts its cost on the right site.
model EquipmentAllocation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  costCodeId  String?   @map("cost_code_id") @db.Uuid
  fromDate    DateTime  @map("from_date") @db.Date
  /// Null while it is still there.
  toDate      DateTime? @map("to_date") @db.Date
  note        String?
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode  CostCode? @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  @@index([equipmentId, fromDate])
  @@index([tenantId, projectId])
  @@map("equipment_allocations")
}

/// One machine's day on one site: the meter, the hours, who drove it, what it did.
model EquipmentLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  equipmentId      String   @map("equipment_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  costCodeId       String?  @map("cost_code_id") @db.Uuid
  logDate          DateTime @map("log_date") @db.Date
  openingMeter     Decimal? @map("opening_meter") @db.Decimal(10, 1)
  closingMeter     Decimal? @map("closing_meter") @db.Decimal(10, 1)
  hoursWorked      Decimal  @default(0) @map("hours_worked") @db.Decimal(4, 1)
  idleHours        Decimal  @default(0) @map("idle_hours") @db.Decimal(4, 1)
  breakdownHours   Decimal  @default(0) @map("breakdown_hours") @db.Decimal(4, 1)
  /// A worker on the roster — paid through the roll call, never priced here.
  operatorWorkerId String?  @map("operator_worker_id") @db.Uuid
  operatorName     String?  @map("operator_name")
  workDone         String?  @map("work_done")
  meterPhotoKey    String?  @map("meter_photo_key")
  recordedBy       String   @map("recorded_by") @db.Uuid
  clientId         String?  @map("client_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode  CostCode?       @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  operator  Worker?         @relation(fields: [operatorWorkerId], references: [id], onDelete: SetNull)
  fuel      EquipmentFuel[]

  @@unique([equipmentId, logDate])
  @@unique([tenantId, clientId])
  @@index([tenantId, projectId, logDate])
  @@map("equipment_logs")
}

/// Diesel issued to a machine. Where it came from decides who counts its cost (EQUIPMENT_FUEL_SOURCES).
model EquipmentFuel {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  equipmentId     String   @map("equipment_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  logId           String?  @map("log_id") @db.Uuid
  costCodeId      String?  @map("cost_code_id") @db.Uuid
  issuedOn        DateTime @map("issued_on") @db.Date
  litres          Decimal  @db.Decimal(9, 2)
  /// What it cost, minor units. Zero for fuel the vendor supplies.
  amount          BigInt   @default(0)
  /// direct | expense | stock | vendor
  source          String   @default("direct")
  materialId      String?  @map("material_id") @db.Uuid
  stockMovementId String?  @unique @map("stock_movement_id") @db.Uuid
  expenseId       String?  @map("expense_id") @db.Uuid
  billS3Key       String?  @map("bill_s3_key")
  meterReading    Decimal? @map("meter_reading") @db.Decimal(10, 1)
  note            String?
  recordedBy      String   @map("recorded_by") @db.Uuid
  clientId        String?  @map("client_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  log           EquipmentLog?  @relation(fields: [logId], references: [id], onDelete: SetNull)
  costCode      CostCode?      @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  material      Material?      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  expense       Expense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([tenantId, clientId])
  @@index([equipmentId, issuedOn])
  @@index([tenantId, projectId, issuedOn])
  @@map("equipment_fuel")
}

/// A service schedule: every so many hours, km or days.
model EquipmentServicePlan {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  equipmentId   String    @map("equipment_id") @db.Uuid
  name          String
  intervalMeter Decimal?  @map("interval_meter") @db.Decimal(10, 1)
  intervalDays  Int?      @map("interval_days")
  lastDoneMeter Decimal?  @map("last_done_meter") @db.Decimal(10, 1)
  lastDoneOn    DateTime? @map("last_done_on") @db.Date
  /// Set when the "service due" reminder went out; cleared when the service is done.
  remindedAt    DateTime? @map("reminded_at") @db.Timestamptz(6)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment   Equipment              @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenance EquipmentMaintenance[]

  @@index([tenantId, active])
  @@index([equipmentId])
  @@map("equipment_service_plans")
}

/// A service or a repair: what was done, what it cost, how long the machine was out.
model EquipmentMaintenance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  equipmentId   String   @map("equipment_id") @db.Uuid
  /// The site that bears the cost; null for work in the yard.
  projectId     String?  @map("project_id") @db.Uuid
  planId        String?  @map("plan_id") @db.Uuid
  costCodeId    String?  @map("cost_code_id") @db.Uuid
  doneOn        DateTime @map("done_on") @db.Date
  /// preventive | breakdown
  kind          String
  description   String
  parts         String?
  cost          BigInt   @default(0)
  meterReading  Decimal? @map("meter_reading") @db.Decimal(10, 1)
  downtimeHours Decimal? @map("downtime_hours") @db.Decimal(7, 1)
  vendorName    String?  @map("vendor_name")
  /// Set when the cost is an expense, which the cost report counts instead of this row.
  expenseId     String?  @map("expense_id") @db.Uuid
  billS3Key     String?  @map("bill_s3_key")
  recordedBy    String   @map("recorded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  plan      EquipmentServicePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  costCode  CostCode?             @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  expense   Expense?              @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([equipmentId, doneOn])
  @@index([tenantId, projectId])
  @@map("equipment_maintenance")
}

/// Insurance, fitness, registration, an operator's licence — anything with an expiry date.
model EquipmentDocument {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  equipmentId String    @map("equipment_id") @db.Uuid
  kind        String
  number      String?
  issuedOn    DateTime? @map("issued_on") @db.Date
  expiresOn   DateTime? @map("expires_on") @db.Date
  s3Key       String?   @map("s3_key")
  note        String?
  /// Set when the expiry reminder went out; cleared when the expiry date changes.
  remindedAt  DateTime? @map("reminded_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([equipmentId])
  @@map("equipment_documents")
}

/// A vendor's hire invoice for one machine, site and month, checked and booked as an expense. From
/// then on that month's hire on that site is the expense's: the cost report never counts it twice.
model EquipmentHireBooking {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  equipmentId String   @map("equipment_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  /// `YYYY-MM`.
  month       String
  amount      BigInt
  expenseId   String   @map("expense_id") @db.Uuid
  invoiceRef  String?  @map("invoice_ref")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expense   Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, projectId, month])
  @@index([tenantId, vendorId, month])
  @@map("equipment_hire_bookings")
}

// ---------------------------------------------------------------------------
// Single sign-on and SCIM provisioning (roadmap Phase 3, item 1)
// ---------------------------------------------------------------------------

/// A company's single sign-on connection: OpenID Connect or SAML 2.0 to its own identity provider.
/// At most one per company. Owner-only to change — whoever controls this can sign in as anybody on
/// the company's verified domains.
model SsoConnection {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @unique @map("tenant_id") @db.Uuid
  /// oidc | saml
  protocol               String
  /// entra | google | okta | other — which help text and claim defaults apply.
  preset                 String   @default("other")
  enabled                Boolean  @default(false)
  oidcIssuer             String?  @map("oidc_issuer")
  oidcClientId           String?  @map("oidc_client_id")
  /// AES-256-GCM (FieldCipher) under SSO_ENCRYPTION_KEY. Named `_cipher` so the audit log redacts it.
  oidcClientSecretCipher String?  @map("oidc_client_secret_cipher")
  oidcScopes             String   @default("openid email profile") @map("oidc_scopes")
  samlIdpEntityId        String?  @map("saml_idp_entity_id")
  samlIdpSsoUrl          String?  @map("saml_idp_sso_url")
  /// The IdP's public signing certificate (PEM or bare base64). Public by nature, so not encrypted.
  samlIdpCertificate     String?  @map("saml_idp_certificate")
  samlIdpMetadataUrl     String?  @map("saml_idp_metadata_url")
  /// Create a person at first sign-in when nobody in the company has their address.
  jitEnabled             Boolean  @default(false) @map("jit_enabled")
  /// The role they get. Never an owner role; the service refuses one.
  jitRoleId              String?  @map("jit_role_id") @db.Uuid
  /// People on a verified domain must use SSO; owners keep phone sign-in as the break-glass path.
  enforceSso             Boolean  @default(false) @map("enforce_sso")
  updatedByUserId        String?  @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jitRole       Role?             @relation(fields: [jitRoleId], references: [id], onDelete: SetNull)
  loginRequests SsoLoginRequest[]

  @@map("sso_connections")
}

/// An email domain a company has claimed, and — once its DNS carries the TXT record — proved.
/// A domain can be *verified* by one company only; that is a partial unique index in the migration
/// (`WHERE verified_at IS NOT NULL`), which Prisma cannot express.
model SsoDomain {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  domain            String
  /// What the TXT record must say. Named `_token` so the audit log redacts it.
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@map("sso_domains")
}

/// Verified domain → company, for "Sign in with SSO" before any company is known. No RLS, like
/// `auth_identities`, and like it written only by a trigger (on `sso_domains`) — never by the app.
model SsoDomainDirectory {
  domain   String @id
  tenantId String @map("tenant_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sso_domain_directory")
}

/// One sign-in in flight: what the callback must match (OIDC nonce and PKCE verifier, SAML request
/// id) and, once the provider has answered, who it was. Single use; a few minutes long.
model SsoLoginRequest {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  connectionId       String    @map("connection_id") @db.Uuid
  protocol           String
  /// started → callback (provider answered, being checked) → authenticated → completed.
  status             String    @default("started")
  nonce              String?
  /// The PKCE code verifier. Named `_secret` so nothing ever logs it.
  pkceVerifierSecret String?   @map("pkce_verifier_secret")
  samlRequestId      String?   @map("saml_request_id")
  /// SHA-256 of the browser binding sent at the start; the finish must present the same value.
  bindingHash        String    @map("binding_hash")
  email              String?
  userId             String?   @map("user_id") @db.Uuid
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("sso_login_requests")
}

/// A SCIM bearer token. Only its SHA-256 is kept; the token itself is shown once, when made.
model ScimToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// The last four characters, to tell tokens apart in settings.
  tokenHint       String    @map("token_hint")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scim_tokens")
}

/// Live SCIM token hash → company, for authenticating a SCIM request before any company is known.
/// No RLS; written only by the trigger on `scim_tokens`.
model ScimTokenDirectory {
  tokenHash String @id @map("token_hash")
  tenantId  String @map("tenant_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("scim_token_directory")
}

/// A team member the identity provider manages, with the provider's own id for them.
model ScimUser {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  externalId String?  @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@map("scim_users")
}

/// A group the identity provider pushed. Only used to map people to roles.
model ScimGroup {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String   @map("display_name")
  externalId  String?  @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members ScimGroupMember[]

  @@unique([tenantId, displayName])
  @@map("scim_groups")
}

model ScimGroupMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  ScimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([tenantId, userId])
  @@map("scim_group_members")
}

/// People in the provider group called `groupName` get `roleId`. Never an owner role.
model ScimRoleMapping {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  groupName String   @map("group_name")
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, groupName])
  @@map("scim_role_mappings")
}

// ---------------------------------------------------------------------------
// Two-factor, session timeouts and IP allow-lists (roadmap Phase 3, item 2)
// ---------------------------------------------------------------------------

/// A company's sign-in rules. One row per company, created the first time an owner saves any of
/// them; no row means every rule is off, which is how every company starts.
model TenantSecuritySettings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  /// off | admins | everyone — see SECURITY_MFA_POLICIES.
  mfaPolicy             String   @default("off") @map("mfa_policy")
  /// A sign-in through the company's own identity provider counts as two-factor.
  trustIdpMfa           Boolean  @default(true) @map("trust_idp_mfa")
  /// Minutes without activity before a session ends; null for never.
  idleTimeoutMinutes    Int?     @map("idle_timeout_minutes")
  /// Hours from sign-in before a session ends whatever happens; null for the refresh token's own.
  absoluteLifetimeHours Int?     @map("absolute_lifetime_hours")
  /// off | web | everyone — see SECURITY_IP_MODES.
  ipMode                String   @default("off") @map("ip_mode")
  /// `[{ cidr, label }]`, canonical CIDR text.
  ipRules               Json     @default("[]") @map("ip_rules")
  ipExemptOwners        Boolean  @default(true) @map("ip_exempt_owners")
  /// Base roles the allow-list never checks.
  ipExemptRoles         String[] @default([]) @map("ip_exempt_roles")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_security_settings")
}

/// One sign-in. Every refresh-token rotation after it belongs to it. What the account page lists
/// as "where you are signed in", what idle and absolute timeouts are measured on, and where a
/// verified second factor is recorded for the rest of the session.
model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// phone | email | sso — how the first factor was proved.
  method        String
  /// web | app — `app` when the sign-in sent a device id, as the mobile app does.
  client        String    @default("web")
  deviceId      String?   @map("device_id")
  userAgent     String?   @map("user_agent")
  /// Where the sign-in came from, and the latest address seen.
  ip            String?
  lastIp        String?   @map("last_ip")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastActiveAt  DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  /// When a second factor was shown for this session; null until then.
  mfaAt         DateTime? @map("mfa_at") @db.Timestamptz(6)
  /// totp | recovery_code | firebase | identity_provider
  mfaMethod     String?   @map("mfa_method")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// sign_out | sign_out_everywhere | revoked | revoked_by_admin | idle_timeout | absolute_timeout | mfa_reset | replayed
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId, userId, revokedAt])
  @@map("user_sessions")
}

/// A person's authenticator app. One per person per company: somebody in two companies is two
/// users and enrols in each, because a company's rule should be met by its own enrolment.
model MfaFactor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  /// The base32 TOTP secret, AES-256-GCM (FieldCipher) under MFA_ENCRYPTION_KEY. Named `_cipher`
  /// so the audit log redacts it.
  secretCipher   String    @map("secret_cipher")
  /// Null while the QR code has been shown but no code typed back; only a confirmed factor counts.
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// The last time step accepted, so a code cannot be used twice.
  lastUsedStep   BigInt?   @map("last_used_step")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("mfa_factors")
}

/// Single-use recovery codes, for a lost phone. Only a SHA-256 hash is stored; the codes are shown
/// once, when they are made.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([tenantId])
  @@map("mfa_recovery_codes")
}

// ---------------------------------------------------------------------------
// Company AI controls (roadmap Phase 3, "AI data controls")
// ---------------------------------------------------------------------------

/// What a company allows its model calls to do. No row means everything on and the default region —
/// so every company that existed before this table behaves exactly as it did.
///
/// A table of its own rather than more columns on `tenant_security_settings`: that row decides who
/// can get in, this one decides what leaves the building, and they are changed for different
/// reasons — an audit entry for one should not read as a change to the other.
model AiSettings {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  /// The master switch. Off refuses every feature whatever `disabledFeatures` says.
  enabled          Boolean  @default(true)
  /// Features switched off one by one (see AI_FEATURES). Stored as the ones that are off, so a
  /// feature added later starts on for everybody, as a new feature should.
  disabledFeatures String[] @default([]) @map("disabled_features")
  /// default | eu | us — see AI_REGIONS.
  region           String   @default("default")
  updatedByUserId  String?  @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

/// How many model calls a company made, per feature per day. A counter, not a log: no prompt, no
/// answer and no user is kept, only the number — which is what a cost question, or "did anything
/// go out while it was switched off?", needs.
model AiUsageDaily {
  tenantId String   @map("tenant_id") @db.Uuid
  /// The UTC calendar day.
  day      DateTime @db.Date
  /// One of AI_FEATURES.
  feature  String
  calls    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day, feature])
  @@map("ai_usage_daily")
}

/// A plan bought by bank transfer rather than by card (roadmap: Bangladesh and Nepal, where paying
/// abroad by card is hard). The owner asks for an invoice; the platform team issues it, waits for
/// the money, and marks it paid from the console — which is what applies the plan. No payment
/// provider is involved, so nothing here is set from a webhook or from the browser.
model PlanBankTransferInvoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  /// "BT-20261006-7F3A9C"-style, unique across the platform so it can be quoted on a transfer.
  number           String    @unique
  /// The plan code asked for. Not a foreign key, like `tenants.plan`.
  plan             String
  /// The currency and amount quoted — the catalogue's, copied so a later price change cannot
  /// rewrite what the customer was asked to pay.
  currency         String    @db.Char(3)
  amount           BigInt
  /// pending | paid | cancelled
  status           String    @default("pending")
  requestedBy      String?   @map("requested_by") @db.Uuid
  note             String?
  /// The bank's own reference for the transfer, typed by the operator who marked it paid.
  paymentReference String?   @map("payment_reference")
  /// The console operator (a phone number) who marked it paid or cancelled it.
  settledBy        String?   @map("settled_by")
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("plan_bank_transfer_invoices")
}

// ---------------------------------------------------------------------------
// Microsoft 365 email and calendar, and site meetings (roadmap Phase 3, "Calendar and email")
// ---------------------------------------------------------------------------

/// The company's connected Microsoft 365 mailbox: what the product sends email as and writes calendar
/// events to, through Microsoft Graph with delegated permissions. At most one per company.
///
/// Tokens are AES-256-GCM (FieldCipher) under M365_ENCRYPTION_KEY and named `_cipher` so the audit
/// log redacts them. The access token is kept too, so every process shares one rather than each
/// refreshing its own; the audit trigger skips it, as it changes every hour.
model IntegrationM365Connection {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @unique @map("tenant_id") @db.Uuid
  /// connected | needs_reconnect — see M365_CONNECTION_STATUSES.
  status                String    @default("connected")
  /// The mailbox signed in at connect: what every email is sent from.
  mailboxEmail          String    @map("mailbox_email")
  mailboxName           String?   @map("mailbox_name")
  /// Graph's id for that user, so a reconnect as somebody else is noticed.
  msUserId              String?   @map("ms_user_id")
  /// The scopes Microsoft actually granted, space separated.
  scopes                String
  refreshTokenCipher    String    @map("refresh_token_cipher")
  /// When the stored refresh token was last replaced. Microsoft issues a new one on every refresh;
  /// it is stored at most daily, so the audit log is not a list of hourly token swaps.
  refreshTokenRotatedAt DateTime  @default(now()) @map("refresh_token_rotated_at") @db.Timestamptz(6)
  accessTokenCipher     String?   @map("access_token_cipher")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  /// Put milestones and RFI due dates in the mailbox's calendar.
  calendarSync          Boolean   @default(false) @map("calendar_sync")
  calendarSyncedAt      DateTime? @map("calendar_synced_at") @db.Timestamptz(6)
  /// Why it stopped working, in Microsoft's words, when it did.
  lastError             String?   @map("last_error")
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamptz(6)
  connectedByUserId     String?   @map("connected_by_user_id") @db.Uuid
  connectedAt           DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("integration_m365_connections")
}

/// One "Connect Microsoft 365" in flight: the state the callback must present (only its SHA-256)
/// and the PKCE verifier. Belongs to the person who started it; single use; ten minutes long.
model IntegrationM365AuthRequest {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  stateHash          String    @unique @map("state_hash")
  /// The PKCE code verifier, encrypted. Named `_cipher` so nothing ever logs it.
  pkceVerifierCipher String    @map("pkce_verifier_cipher")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("integration_m365_auth_requests")
}

/// A calendar event the sync made, so the next sync updates it rather than adding another.
/// `fingerprint` is a hash of what the event says; unchanged, the sync does not call Graph at all.
model IntegrationM365CalendarEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// milestone | rfi_due — see M365_CALENDAR_SOURCES.
  sourceType   String   @map("source_type")
  sourceId     String   @map("source_id") @db.Uuid
  graphEventId String   @map("graph_event_id")
  fingerprint  String
  syncedAt     DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@map("integration_m365_calendar_events")
}

/// Every email the product sent (or tried to) through the connected mailbox: to whom, about what,
/// and what Microsoft said. Graph's sendMail returns no message id, so `providerRequestId` is the
/// `request-id` Microsoft gave the call — what their support asks for — and our own id travels in an
/// `X-Buildr-Delivery-Id` header on the message.
model EmailDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  /// One of M365_EMAIL_KINDS.
  kind              String
  /// rfi | submittal | change_order | meeting — the record it was about, when there is one.
  entityType        String?   @map("entity_type")
  entityId          String?   @map("entity_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  fromEmail         String    @map("from_email")
  toEmails          String[]  @map("to_emails")
  ccEmails          String[]  @default([]) @map("cc_emails")
  subject           String
  /// sent | failed
  status            String
  providerRequestId String?   @map("provider_request_id")
  error             String?
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  sentByUserId      String?   @map("sent_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("email_deliveries")
}

/// A site meeting: when, who, the agenda, and afterwards the minutes and action items.
model Meeting {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  title           String
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime  @map("ends_at") @db.Timestamptz(6)
  location        String?
  agenda          String?
  minutes         String?
  /// scheduled | held | cancelled — see MEETING_STATUSES.
  status          String    @default("scheduled")
  /// The Outlook event the invite created, so a second "Send invite" updates it.
  graphEventId    String?   @map("graph_event_id")
  inviteSentAt    DateTime? @map("invite_sent_at") @db.Timestamptz(6)
  minutesSentAt   DateTime? @map("minutes_sent_at") @db.Timestamptz(6)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attendees   MeetingAttendee[]
  actionItems MeetingActionItem[]

  @@index([tenantId, projectId, startsAt])
  @@map("meetings")
}

/// Somebody asked to the meeting: a team member (`userId`, their address read at send time) or an
/// outside address (the architect, the client's engineer).
model MeetingAttendee {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_attendees")
}

/// Something agreed at the meeting, with who does it and by when.
model MeetingActionItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  meetingId   String    @map("meeting_id") @db.Uuid
  description String
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  ownerName   String?   @map("owner_name")
  dueOn       DateTime? @map("due_on") @db.Date
  /// open | done
  status      String    @default("open")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([tenantId, ownerUserId, status])
  @@map("meeting_action_items")
}
