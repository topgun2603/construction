enum MediaKind {
  photo
  video

  @@map("media_kind")
}

/// Photos and videos of a site, attached to the project rather than to one day's report.
///
/// Separate from `dpr_photos`, which are evidence of what happened on a particular day and belong to
/// that report forever. These are the site itself â€” what it looked like at handover, the approach
/// road, the finished elevation â€” and they outlive any single report.
model ProjectMedia {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  kind        MediaKind
  s3Key       String    @map("s3_key")
  /// Generated by the media worker. Null until then, so the UI falls back to the original.
  thumbS3Key  String?   @map("thumb_s3_key")
  caption     String?
  /// Display order within the site, ascending. The first photo is the one the card leads with.
  /// Not unique â€” a reorder rewrites a whole site's rows, and `created_at` breaks any tie.
  position    Int       @default(0)
  contentType String    @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  /// When the photo was taken, not when it was uploaded â€” they differ by days on a site.
  takenAt     DateTime? @map("taken_at") @db.Timestamptz(6)
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation("media_uploaded_by", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientId], map: "project_media_tenant_id_client_id_key")
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, position])
  @@map("project_media")
}

model DprPhoto {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
