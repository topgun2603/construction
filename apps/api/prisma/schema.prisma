// SiteBook data model â€” Phase 1 tables (spec Â§7).
//
// Conventions (spec Â§17):
//   * Every tenant-scoped model carries `tenantId` and has an RLS policy created in
//     the same migration. Child tables (dpr_*, wage_lines, indent_items) carry
//     `tenantId` too, so RLS protects them directly rather than only via the parent.
//   * Every tenant table is audited unless it is listed as excluded in migration
//     20261006000200_full_audit_log: its migration adds `SELECT audit_attach('table');`.
//   * Money is `BigInt` paise. Never Float, never Decimal.
//   * Report/attendance dates are `@db.Date`; everything else is `@db.Timestamptz(6)`.
//   * `clientId` is the device-generated UUID used as the sync idempotency key (Â§8).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// What a builder can buy.
///
/// A row rather than an enum, because the price of a term, what it is called, and how long it runs
/// are commercial decisions — the sort that change on a phone call with a customer, and should not
/// need a deploy. Adding "two years" is now an operator's afternoon rather than a migration.
///
/// No `tenant_id` and no RLS: the catalogue is the same for everybody, read by tenants who are
/// deciding and written only from the platform console.
model Plan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable identifier stored on `tenants.plan`. Never shown to anybody.
  code        String   @unique
  /// What a builder reads: "3 months", "Lifetime".
  name        String
  /// How long the term runs. Null is a plan that never expires.
  months      Int?
  /// Whole-term price in paise, like all money here.
  pricePaise  BigInt   @map("price_paise")
  /// The price in other currencies, in each one's minor units: { "AED": 99900 } (roadmap Phase 0,
  /// item 7). A company paying in a currency with no entry here cannot subscribe online yet.
  prices      Json     @default("{}")
  /// A sentence under the price, for anything the name cannot carry.
  description String?
  /// A ribbon on the card: "Best value", "Most popular". Null for a plan that is not called out.
  badge       String?
  /// Bullets shown beneath a plan. Every plan includes every feature, so these are for terms and
  /// promises — "best value", "no renewals ever" — not for feature lists.
  highlights  String[] @default([])
  /// Whether it can still be bought. Retired rather than deleted, so an account already on it
  /// keeps a plan that resolves to something.
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("plans")
}

