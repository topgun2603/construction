/// How a wage period came to exist.
///
/// Worth recording because the scheduler drafts them unattended: an owner opening a sheet
/// they do not remember asking for should be told it was drafted for them, not left
/// wondering who created it.
enum WagePeriodSource {
  manual
  scheduled

  @@map("wage_period_source")
}

model WagePeriod {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  /// Null for direct labour.
  contractorId  String?          @map("contractor_id") @db.Uuid
  periodStart   DateTime         @map("period_start") @db.Date
  periodEnd     DateTime         @map("period_end") @db.Date
  status        WagePeriodStatus @default(open)
  source        WagePeriodSource @default(manual)
  totalEarned   BigInt           @default(0) @map("total_earned")
  totalAdvances BigInt           @default(0) @map("total_advances")
  totalPaid     BigInt           @default(0) @map("total_paid")
  finalisedBy   String?          @map("finalised_by") @db.Uuid
  finalisedAt   DateTime?        @map("finalised_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractor Contractor? @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  finaliser  User?       @relation("wage_period_finalised_by", fields: [finalisedBy], references: [id], onDelete: SetNull)

  lines    WageLine[]
  payments LabourPayment[]

  @@index([tenantId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@map("wage_periods")
}

model WageLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  wagePeriodId     String  @map("wage_period_id") @db.Uuid
  workerId         String  @map("worker_id") @db.Uuid
  daysPresent      Decimal @default(0) @map("days_present") @db.Decimal(4, 1)
  overtimeHours    Decimal @default(0) @map("overtime_hours") @db.Decimal(4, 1)
  grossAmount      BigInt  @default(0) @map("gross_amount")
  advancesDeducted BigInt  @default(0) @map("advances_deducted")
  netPayable       BigInt  @default(0) @map("net_payable")
  paidAmount       BigInt  @default(0) @map("paid_amount")
  /// Gross split for a salary file: day wages or salary (fixed) and overtime (variable).
  fixedAmount      BigInt  @default(0) @map("fixed_amount")
  variableAmount   BigInt  @default(0) @map("variable_amount")
  leaveDays        Decimal @default(0) @map("leave_days") @db.Decimal(4, 1)
  note             String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wagePeriod WagePeriod @relation(fields: [wagePeriodId], references: [id], onDelete: Cascade)
  worker     Worker     @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([wagePeriodId, workerId], map: "wage_lines_wage_period_id_worker_id_key")
  @@index([tenantId, workerId])
  @@map("wage_lines")
}

/// Advances, wage payments and adjustments. `workerId` null means the payment sits
/// at the contractor level.
model LabourPayment {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
