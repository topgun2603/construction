  workerId             String           @map("worker_id") @db.Uuid
  status               AttendanceStatus
  overtimeHours        Decimal          @default(0) @map("overtime_hours") @db.Decimal(4, 1)
  /// Daily wage frozen at record time, in paise (spec Â§8A).
  wageSnapshot         BigInt           @map("wage_snapshot")
  /// Overtime rate frozen at record time. Kept alongside wage_snapshot so a later
  /// rate change cannot retroactively alter overtime already earned.
  overtimeRateSnapshot BigInt           @default(0) @map("overtime_rate_snapshot")
  recordedBy           String           @map("recorded_by") @db.Uuid
