  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker   Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  recorder User    @relation("attendance_recorded_by", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@unique([projectId, attendanceDate, workerId], map: "attendance_project_date_worker_key")
  @@unique([tenantId, clientId], map: "attendance_tenant_id_client_id_key")
