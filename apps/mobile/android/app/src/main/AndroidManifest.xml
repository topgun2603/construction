<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        The app talks to an API and loads map tiles. Debug builds get this injected by the Flutter
        tool, which is why its absence here was invisible: a release build without it installs fine
        and then fails every request.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13 and later. The dialog is raised after sign-in, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
        Standing on the plot and tapping "use my location" is the fastest way to place a site, and
        on a plot with no road name it is the only accurate one. Coarse is declared alongside fine
        because Android 12 and later let somebody grant only the approximate one, and a site pin
        good to a hundred metres still beats no pin.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!--
        Speaking the daily report instead of typing it. Asked for at the moment the microphone
        button is pressed, never at launch: a permission prompt somebody cannot connect to
        something they just did is a permission somebody refuses.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <application
        android:label="BUILDR"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!--
            Google Maps. The value comes from MAPS_API_KEY in local.properties, which is gitignored:
            an Android Maps key ships inside the APK and cannot be hidden, but it is a spending
            credential, so it is restricted in the Cloud console to this package name and the
            signing certificate's SHA-1 rather than left in the repository.

            An empty value is fine - the map says it is not configured rather than failing.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
