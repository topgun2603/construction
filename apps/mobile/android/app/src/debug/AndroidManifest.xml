<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Plain http, debug builds only.

        Android has refused cleartext traffic by default since API 28, and a development API on a
        laptop is http — over `adb reverse` on the cable, or the machine's LAN address. This file is
        merged into debug builds only, so the release build keeps refusing cleartext and a shipped
        app cannot be talked into sending a session token over an unencrypted connection.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute" />
</manifest>
