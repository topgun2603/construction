# Where the NestJS API lives. Server components call it directly; the browser uses
# the same value, so in Docker set it to the public URL rather than a service name.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1
API_URL=http://localhost:3000/v1

# Firebase web SDK (phone OTP). These are public identifiers, not secrets â€” they ship to the
# browser by design, and the Admin SDK service account is the secret that does not (it belongs to
# the API, never here).
#
# Placeholders even so. This file is a template: carrying one project's real values means every
# clone points its sign-in at that project, and a web API key with phone auth switched on is the
# handle somebody uses to burn your SMS quota. Copy the real ones out of the Firebase console into
# .env.local, which is gitignored, and keep the console's authorised-domain list short.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to true to skip Firebase and sign in with the API's dev bypass. Handy before
# the Firebase phone provider is switched on, and for the seeded demo users.
NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# Map tiles. Get a key from maptiler.com and restrict it by domain in their console.
#
# Not OpenStreetMap's own tile servers: those are volunteer-run, their usage policy is enforced by
# blocking, and they blocked this app - a blocked client gets a striped "Access blocked" image in
# place of every tile, for every customer at once. Public by design, like the Firebase web key: a
# tile key travels with every tile request, so restrict it rather than trying to hide it.
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key